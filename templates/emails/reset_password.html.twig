<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset your Scan to See password</title>
    <style>
        body {
            margin: 0; padding: 0;
            background: #0f0a07;
            font-family: 'DM Sans', Arial, sans-serif;
            color: #f5f0e8;
            -webkit-font-smoothing: antialiased;
        }
        .wrapper {
            max-width: 560px;
            margin: 40px auto;
            background: #1a1208;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
        }
        .header {
            background: #18120a;
            padding: 32px 40px 24px;
            border-bottom: 1px solid rgba(255,255,255,.06);
            text-align: center;
        }
        .logo-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 4px;
        }
        .logo-row img {
            width: 32px;
            height: 32px;
        }
        .logo-name {
            font-size: 1rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: .02em;
        }
        .body {
            padding: 36px 40px;
        }
        h1 {
            font-size: 1.35rem;
            font-weight: 700;
            color: #fff;
            margin: 0 0 12px;
            line-height: 1.3;
        }
        p {
            font-size: .93rem;
            color: rgba(245,240,232,.65);
            line-height: 1.7;
            margin: 0 0 24px;
        }
        .btn-reset {
            display: inline-block;
            background: #e84040;
            color: #fff;
            font-size: .93rem;
            font-weight: 700;
            text-decoration: none;
            padding: 14px 32px;
            border-radius: 8px;
            letter-spacing: .01em;
        }
        .btn-wrap {
            text-align: center;
            margin: 28px 0;
        }
        .divider {
            border: none;
            border-top: 1px solid rgba(255,255,255,.07);
            margin: 28px 0;
        }
        .url-fallback {
            font-size: .78rem;
            color: rgba(245,240,232,.4);
            word-break: break-all;
        }
        .footer {
            background: #18120a;
            padding: 20px 40px;
            border-top: 1px solid rgba(255,255,255,.06);
            text-align: center;
            font-size: .75rem;
            color: rgba(245,240,232,.3);
        }
        .warning {
            background: rgba(232,64,64,.08);
            border: 1px solid rgba(232,64,64,.2);
            border-radius: 8px;
            padding: 12px 16px;
            font-size: .82rem;
            color: rgba(245,240,232,.6);
            margin-bottom: 24px;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="header">
            <div class="logo-row">
                <span style="font-size:1.5rem">🔑</span>
                <span class="logo-name">Scan to See</span>
            </div>
        </div>
        <div class="body">
            <h1>Reset your password</h1>
            <p>
                Hi{% if user.fullName %} {{ user.fullName }}{% endif %}, we received a request to reset the password
                for your Scan to See account (<strong>{{ user.email }}</strong>).
            </p>
            <p>Click the button below to choose a new password. This link expires in <strong>30 minutes</strong>.</p>

            <div class="btn-wrap">
                <a href="{{ resetUrl }}" class="btn-reset">Reset my password</a>
            </div>

            <div class="warning">
                ⚠️ If you didn't request this, you can safely ignore this email — your password won't change.
            </div>

            <hr class="divider">

            <p style="margin-bottom:6px">Or copy and paste this link into your browser:</p>
            <p class="url-fallback">{{ resetUrl }}</p>
        </div>
        <div class="footer">
            © {{ "now"|date("Y") }} Scan to See · This email was sent to {{ user.email }}
        </div>
    </div>
</body>
</html>
