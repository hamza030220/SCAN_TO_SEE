{% extends 'public/layout.html.twig' %}
{% set tc = menu.themeConfig %}

{% block title %}{{ menu.name }} — {{ business.name }}{% endblock %}

{% block font_styles %}
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700{% if tc.font == 'DM Sans' %}&family=DM+Sans:opsz,wght@9..40,300..700{% elseif tc.font == 'Playfair Display' %}&family=Playfair+Display:ital,wght@0,400;0,700;1,400{% elseif tc.font == 'Poppins' %}&family=Poppins:wght@400;600;700{% elseif tc.font == 'Montserrat' %}&family=Montserrat:wght@400;600;700{% elseif tc.font == 'Inter' %}&family=Inter:wght@400;600;700{% endif %}&display=swap" rel="stylesheet">
{% endblock %}

{% block theme_vars %}
<style>
:root {
  --pub-font: '{{ tc.font }}', sans-serif;
  {% if tc.bgType == 'gradient' %}
  --pub-bg: linear-gradient({{ tc.bgGradientDir }}, {{ tc.bgGradientStart }}, {{ tc.bgGradientEnd }});
  {% elseif tc.bgType == 'image' and tc.bgImagePath %}
  --pub-bg: url('/{{ tc.bgImagePath }}') center/cover no-repeat fixed;
  {% else %}
  --pub-bg: {{ tc.bgColor }};
  {% endif %}
  --pub-ink:        {{ tc.theme == 'dark' ? '#f5f0e8' : '#18120a' }};
  --pub-muted:      {{ tc.theme == 'dark' ? 'rgba(245,240,232,.55)' : '#7a6f60' }};
  --pub-border:     {{ tc.theme == 'dark' ? 'rgba(255,255,255,.12)' : '#ece7df' }};
  --pub-cat-title:  {{ tc.theme == 'dark' ? 'rgba(245,240,232,.45)' : '#7a6f60' }};
  --pub-cat-border: {{ tc.theme == 'dark' ? 'rgba(255,255,255,.08)' : '#e0d9ce' }};
  --pub-header-bg:  {{ tc.headerBg }};
  --pub-accent:     {{ tc.accent }};
  --pub-card-bg:    {{ tc.cardBg }};
  --pub-glass-blur: {{ tc.glassBlur }}px;
  --pub-glass-opacity: {{ tc.glassOpacity }};
  --pub-logo-align: {{ tc.logoAlign }};
  --pub-sheet-bg:   {{ tc.theme == 'dark' ? '#1e1812' : '#fff' }};
  --pub-sheet-ink:  {{ tc.theme == 'dark' ? '#f5f0e8' : '#18120a' }};
}

/* ── Currency switcher ──────────────────────────────────────────── */
.pub-curr-bar {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 10px 16px 8px;
}
.curr-btn {
    font-family: var(--pub-font, 'DM Sans', sans-serif);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 99px;
    border: 1.5px solid rgba(255,255,255,.22);
    background: transparent;
    color: rgba(255,255,255,.55);
    cursor: pointer;
    transition: background .15s, border-color .15s, color .15s;
    -webkit-tap-highlight-color: transparent;
}
.curr-btn.active {
    background: var(--pub-accent, #e84040);
    border-color: var(--pub-accent, #e84040);
    color: #fff;
}
.curr-btn:hover:not(.active) {
    border-color: rgba(255,255,255,.5);
    color: rgba(255,255,255,.9);
}
.curr-btn[disabled] {
    opacity: .3;
    cursor: default;
}

</style>
{% endblock %}

{% block body_attrs %}data-theme="{{ tc.theme }}" data-card-style="{{ tc.cardStyle }}" data-pill-style="{{ tc.pillStyle }}" data-layout="{{ tc.layout ?? 'list' }}"{% endblock %}

{% block body %}

{# ── Header ──────────────────────────────────────────────────────────── #}
<header class="pub-header">
    <div class="pub-header-inner">
        {% if business.logoPath %}
            <img src="{{ asset(business.logoPath) }}"
                 alt="{{ business.name }}"
                 width="48" height="48" decoding="async"
                 class="pub-header-logo">
        {% else %}
            <div class="pub-header-initials">{{ business.name|slice(0,2)|upper }}</div>
        {% endif %}
        <div class="pub-header-text">
            <h1 class="pub-header-name">{{ business.name }}</h1>
            <p class="pub-header-menu">{{ menu.name }}</p>
        </div>
    </div>
    {% if hasOtherMenus %}
        <a href="{{ path('app_public_menu', {slug: business.slug}) }}"
           class="pub-other-menus-link">
            See all menus
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
    {% endif %}
    <div id="currBar" class="pub-curr-bar" role="group" aria-label="Currency"></div>
</header>

{# ── Category pill nav ───────────────────────────────────────────────── #}
{% if categories|length > 1 %}
<nav class="pub-cat-nav" id="catNav">
    <div class="pub-cat-nav-inner">
        {% for entry in categories %}
            <a href="#cat-{{ entry.category.id }}"
               class="pub-cat-pill"
               data-cat-pill="{{ entry.category.id }}">
                {{ entry.category.name }}
            </a>
        {% endfor %}
    </div>
</nav>
{% endif %}

{# ── Menu body ───────────────────────────────────────────────────────── #}
<main class="pub-main" id="pubMain">

    {% if categories|length == 0 %}
        <div class="pub-empty">
            <p>No items available right now. Check back soon!</p>
        </div>
    {% else %}
        {% for entry in categories %}
            <section class="pub-category" id="cat-{{ entry.category.id }}">
                <h2 class="pub-cat-title">{{ entry.category.name }}</h2>
                <div class="pub-items">
                    {% for item in entry.items %}
                        <button type="button"
                                class="pub-item-card"
                                data-item-id="{{ item.id }}"
                                data-item-name="{{ item.name|e('html_attr') }}"
                                data-item-desc="{{ item.shortDescription ?? ''|e('html_attr') }}"
                                data-item-details="{{ item.details ?? ''|e('html_attr') }}"
                                data-item-badge="{{ item.badge ?? ''|e('html_attr') }}"
                                data-item-tags="{{ item.dietaryTags|json_encode|e('html_attr') }}"
                                data-item-allergens="{{ item.allergens|json_encode|e('html_attr') }}"
                                data-item-variants="{{ item.variants|json_encode|e('html_attr') }}"
                                data-item-availability="{{ item.availabilityNote ?? ''|e('html_attr') }}"
                                data-item-price="{{ item.price }}"
                                data-item-currency="{{ menu.currency }}"
                                data-item-image="{{ item.imagePath ? asset(item.imagePath) : '' }}"
                                aria-label="View details for {{ item.name }}">

                            {# Image or placeholder #}
                            <div class="pub-item-img-wrap">
                                {% if item.imagePath %}
                                    <img src="{{ asset(item.imagePath) }}"
                                         alt="{{ item.name }}"
                                         class="pub-item-img"
                                         width="68" height="68" loading="lazy" decoding="async">
                                {% else %}
                                    <div class="pub-item-img-placeholder">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="pub-item-body">
                                {% if item.badge %}<span class="pub-item-badge">{{ item.badge }}</span>{% endif %}
                                <span class="pub-item-name">{{ item.name }}</span>
                                {% if item.shortDescription %}
                                    <span class="pub-item-desc">{{ item.shortDescription }}</span>
                                {% endif %}
                                {% if item.dietaryTags|length > 0 %}
                                    <span class="pub-item-tags">{{ item.dietaryTags|slice(0, 2)|join(' · ') }}</span>
                                {% endif %}
                                <span class="pub-item-price">{{ item.price }} {{ menu.currency }}</span>
                            </div>
                        </button>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    {% endif %}

</main>

{# ── Footer ──────────────────────────────────────────────────────────── #}
<footer class="pub-footer">
    <span>Powered by</span>
    <strong>Scan to See </strong>
    <p>made with love by hamza Z</p>
</footer>

{# ── Item detail bottom sheet ────────────────────────────────────────── #}
<div class="pub-sheet-backdrop" id="sheetBackdrop" aria-hidden="true"></div>
<div class="pub-sheet" id="itemSheet" role="dialog" aria-modal="true" aria-label="Item details">
    <div class="pub-sheet-handle"></div>
    <div class="pub-sheet-img-wrap" id="sheetImgWrap"></div>
    <div class="pub-sheet-body">
        <div class="pub-sheet-top">
            <div><span class="pub-sheet-badge" id="sheetBadge" hidden></span><h2 class="pub-sheet-name" id="sheetName"></h2></div>
            <span class="pub-sheet-price" id="sheetPrice"></span>
        </div>
        <p class="pub-sheet-desc" id="sheetDesc"></p>
        <div class="pub-sheet-tags" id="sheetTags"></div>
        <p class="pub-sheet-availability" id="sheetAvailability" hidden></p>
        <div class="pub-sheet-variants" id="sheetVariants" hidden></div>
        <p class="pub-sheet-allergens" id="sheetAllergens" hidden></p>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script>
(function () {
    /* ── Item bottom sheet ───────────────────────────────────────────── */
    var sheet    = document.getElementById('itemSheet');
    var backdrop = document.getElementById('sheetBackdrop');
    var imgWrap  = document.getElementById('sheetImgWrap');
    var nameEl   = document.getElementById('sheetName');
    var priceEl  = document.getElementById('sheetPrice');
    var descEl   = document.getElementById('sheetDesc');
    var badgeEl  = document.getElementById('sheetBadge');
    var tagsEl   = document.getElementById('sheetTags');
    var availabilityEl = document.getElementById('sheetAvailability');
    var variantsEl = document.getElementById('sheetVariants');
    var allergensEl = document.getElementById('sheetAllergens');

    function jsonData(value) {
        try { return JSON.parse(value || '[]'); } catch (error) { return []; }
    }

    function fillLabels(container, labels) {
        container.innerHTML = '';
        labels.forEach(function (label) {
            var tag = document.createElement('span');
            tag.textContent = label;
            container.appendChild(tag);
        });
    }

    function openSheet(card) {
        var name     = card.dataset.itemName;
        var desc     = card.dataset.itemDetails || card.dataset.itemDesc;
        var price    = card.dataset.itemPrice;
        var currency = card.dataset.itemCurrency;
        var image    = card.dataset.itemImage;

        nameEl.textContent  = name;
        priceEl.textContent = window.s2sFmtPrice ? window.s2sFmtPrice(price, currency) : (price + ' ' + currency);
        descEl.textContent  = desc || '';
        descEl.style.display = desc ? 'block' : 'none';

        badgeEl.textContent = card.dataset.itemBadge || '';
        badgeEl.hidden = !card.dataset.itemBadge;
        fillLabels(tagsEl, jsonData(card.dataset.itemTags));

        availabilityEl.textContent = card.dataset.itemAvailability || '';
        availabilityEl.hidden = !card.dataset.itemAvailability;

        var variants = jsonData(card.dataset.itemVariants);
        variantsEl.innerHTML = '';
        variantsEl.hidden = variants.length === 0;
        variants.forEach(function (variant) {
            var row = document.createElement('div');
            var label = document.createElement('span');
            var value = document.createElement('strong');
            label.textContent = variant.name;
            value.textContent = window.s2sFmtPrice ? window.s2sFmtPrice(variant.price, currency) : (variant.price + ' ' + currency);
            row.appendChild(label);
            row.appendChild(value);
            variantsEl.appendChild(row);
        });

        var allergens = jsonData(card.dataset.itemAllergens);
        allergensEl.textContent = allergens.length ? 'Allergens: ' + allergens.join(', ') : '';
        allergensEl.hidden = allergens.length === 0;

        imgWrap.innerHTML = '';
        if (image) {
            var img = document.createElement('img');
            img.src = image;
            img.alt = name;
            img.className = 'pub-sheet-img';
            imgWrap.appendChild(img);
            imgWrap.style.display = 'block';
        } else {
            imgWrap.style.display = 'none';
        }

        sheet.classList.add('open');
        backdrop.classList.add('visible');
        document.body.style.overflow = 'hidden';
    }

    function closeSheet() {
        sheet.classList.remove('open');
        backdrop.classList.remove('visible');
        document.body.style.overflow = '';
    }

    document.addEventListener('click', function (e) {
        var card = e.target.closest('.pub-item-card');
        if (card) { openSheet(card); return; }
        if (e.target === backdrop) { closeSheet(); }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeSheet();
    });

    /* ── Touch swipe-down to close sheet ─────────────────────────────── */
    var startY = 0;
    sheet.addEventListener('touchstart', function (e) {
        startY = e.touches[0].clientY;
    }, { passive: true });
    sheet.addEventListener('touchend', function (e) {
        var dy = e.changedTouches[0].clientY - startY;
        if (dy > 60) closeSheet();
    }, { passive: true });

    /* The header scrolls naturally; only the category rail is sticky. */
    var catNav = document.getElementById('catNav');

    /* ── Category pill scroll tracking ───────────────────────────────── */
    var pills    = Array.from(document.querySelectorAll('[data-cat-pill]'));
    var sections = pills.map(function (p) {
        return document.getElementById('cat-' + p.dataset.catPill);
    }).filter(Boolean);

    if (pills.length < 2 || sections.length === 0) return;

    function getOffset() {
        return (catNav ? catNav.offsetHeight : 0) +
               16; /* 16 px breathing room */
    }

    var activeId = null;
    function setActive(id, smooth) {
        var sid = String(id);
        if (sid === activeId) return;
        activeId = sid;
        pills.forEach(function (p) {
            p.classList.toggle('active', p.dataset.catPill === sid);
        });
        var active = document.querySelector('[data-cat-pill="' + sid + '"]');
        if (active && catNav) {
            var target = active.offsetLeft - ((catNav.clientWidth - active.offsetWidth) / 2);
            catNav.scrollTo({ left: Math.max(0, target), behavior: smooth ? 'smooth' : 'auto' });
        }
    }

    /* Click pill: smooth-scroll to section with header offset */
    pills.forEach(function (pill) {
        pill.addEventListener('click', function (e) {
            e.preventDefault();
            var section = document.getElementById('cat-' + pill.dataset.catPill);
            if (!section) return;
            var top = section.getBoundingClientRect().top + window.scrollY - getOffset();
            window.scrollTo({ top: top, behavior: 'smooth' });
            setActive(pill.dataset.catPill, true);
        });
    });

    /* Scroll: the current section is the last one whose top is at or above
       the offset line — reliable even for very short sections */
    var ticking = false;
    function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
            ticking = false;
            var offset  = getOffset();
            var current = sections[0].id.replace('cat-', ''); // default: first
            sections.forEach(function (s) {
                if (s.getBoundingClientRect().top <= offset) {
                    current = s.id.replace('cat-', '');
                }
            });
            setActive(current, false);
        });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // set initial active state on page load
})();

/* ── Currency switcher ───────────────────────────────────────────── */
(function () {
    var BASE     = '{{ menu.currency }}';
    var OPTS     = ['EUR', 'USD'].filter(function (c) { return c !== BASE; });
    var ALL_CURR = [BASE].concat(OPTS);

    var rates    = {}; rates[BASE] = 1;
    var saved    = sessionStorage.getItem('s2s-currency');
    var selected = (saved && ALL_CURR.indexOf(saved) !== -1) ? saved : BASE;

    var bar    = document.getElementById('currBar');
    var btnMap = {};

    /* Build all buttons immediately — EUR/USD disabled until rates arrive */
    ALL_CURR.forEach(function (c) {
        var btn = document.createElement('button');
        btn.className        = 'curr-btn' + (c === selected ? ' active' : '');
        btn.dataset.currency = c;
        btn.setAttribute('type', 'button');
        btn.textContent      = c;
        if (c !== BASE) btn.disabled = true;
        btn.addEventListener('click', function () {
            if (!btn.disabled) selectCurrency(c);
        });
        bar.appendChild(btn);
        btnMap[c] = btn;
    });

    /* Expose formatter so the item sheet uses the active currency */
    window.s2sFmtPrice = function (rawPrice, baseCurr) {
        var num = parseFloat(String(rawPrice).replace(',', '.')) || 0;
        if (selected === BASE || !rates[selected]) {
            return rawPrice + ' ' + BASE;
        }
        return (num * rates[selected]).toFixed(2) + ' ' + selected;
    };

    function parsePrice(str) {
        return parseFloat(String(str).replace(',', '.')) || 0;
    }

    function updateAllCards() {
        document.querySelectorAll('.pub-item-card').forEach(function (card) {
            var span = card.querySelector('.pub-item-price');
            if (!span) return;
            var raw = card.dataset.itemPrice;
            var num = parsePrice(raw);
            if (selected === BASE || !rates[selected]) {
                span.textContent = raw + ' ' + BASE;
            } else {
                span.textContent = (num * rates[selected]).toFixed(2) + ' ' + selected;
            }
        });
    }

    function selectCurrency(c) {
        selected = c;
        sessionStorage.setItem('s2s-currency', c);
        ALL_CURR.forEach(function (k) {
            btnMap[k].classList.toggle('active', k === c);
        });
        updateAllCards();
    }

    if (OPTS.length === 0) return; /* only base currency, nothing to fetch */

    var cacheKey = 's2s-rates-' + BASE;
    try {
        var cached = JSON.parse(sessionStorage.getItem(cacheKey) || 'null');
        if (cached && Date.now() - cached.savedAt < 21600000 && cached.rates) {
            OPTS.forEach(function (c) {
                if (cached.rates[c]) {
                    rates[c] = cached.rates[c];
                    btnMap[c].disabled = false;
                }
            });
            if (selected !== BASE && rates[selected]) selectCurrency(selected);
            return;
        }
    } catch (error) {
        sessionStorage.removeItem(cacheKey);
    }

    /* open.er-api.com — free, no API key, supports 160+ currencies incl. TND */
    fetch('https://open.er-api.com/v6/latest/' + BASE)
        .then(function (r) {
            if (!r.ok) throw new Error('fetch failed');
            return r.json();
        })
        .then(function (data) {
            if (!data.rates) throw new Error('no rates');
            OPTS.forEach(function (c) {
                if (data.rates[c]) {
                    rates[c] = data.rates[c];
                    btnMap[c].disabled = false;
                }
            });
            sessionStorage.setItem(cacheKey, JSON.stringify({ savedAt: Date.now(), rates: rates }));
            /* Restore saved preference now that rates are ready */
            if (selected !== BASE && rates[selected]) {
                selectCurrency(selected);
            }
        })
        .catch(function () {
            /* API unavailable — EUR/USD stay disabled, base currency works fine */
        });
})();
</script>
{% endblock %}
