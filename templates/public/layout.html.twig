{# Public layout — no auth, no sidebar, mobile-first #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#18120a">
    <title>{% block title %}Menu{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300..700&family=Space+Grotesk:wght@400;500;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Poppins:wght@400;600;700&family=Montserrat:wght@400;600;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    {{ importmap('app') }}
    {# theme_vars MUST come after importmap so custom :root overrides main.css defaults #}
    {% block theme_vars %}{% endblock %}
</head>
<body class="pub-body" {% block body_attrs %}{% endblock %}>

{% block body %}{% endblock %}

{% block scripts %}{% endblock %}

</body>
</html>
