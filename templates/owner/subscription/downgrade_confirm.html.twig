{% extends 'base.html.twig' %}

{% block title %}Confirm Plan Downgrade — S2S{% endblock %}

{% block body %}
<style>
:root {
    --down-bg:      #0f0a07;
    --down-accent:  #E8A020;
    --down-warn:    #ff6b6b;
    --down-ink:     #18120a;
}
body {
    background: var(--down-bg);
    font-family: 'DM Sans', -apple-system, sans-serif;
    color: #f5f0e8;
    margin: 0;
    padding: 0;
    min-height: 100vh;
}

.down-header {
    background: var(--down-ink);
    border-bottom: 1px solid rgba(232,160,32,.12);
    padding: 20px 24px;
}
.down-header-inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.down-logo {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
}

.down-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 24px;
}

.down-card {
    background: rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 14px;
    padding: 32px;
}

.down-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 12px;
}

.down-subtitle {
    font-size: 1rem;
    color: rgba(245,240,232,.6);
    margin: 0 0 32px;
}

.down-comparison {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    align-items: center;
    margin-bottom: 32px;
}

.down-plan-box {
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 10px;
    padding: 20px;
    text-align: center;
}
.down-plan-box.current { border-color: rgba(34,197,94,.3); }
.down-plan-box.new { border-color: rgba(232,160,32,.3); }

.down-plan-label {
    font-size: .75rem;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: rgba(245,240,232,.5);
    margin-bottom: 8px;
}

.down-plan-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
}

.down-plan-limits {
    font-size: .85rem;
    color: rgba(245,240,232,.7);
    line-height: 1.6;
}

.down-arrow {
    font-size: 2rem;
    color: rgba(245,240,232,.3);
}

.down-warning {
    background: rgba(255,107,107,.12);
    border: 1px solid rgba(255,107,107,.3);
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 32px;
}
.down-warning p {
    margin: 0;
    font-size: .9rem;
    color: rgba(245,240,232,.8);
    line-height: 1.6;
}
.down-warning strong { color: #ff6b6b; }

.down-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
}

.btn {
    font-family: 'DM Sans', sans-serif;
    font-size: .9rem;
    font-weight: 600;
    padding: 12px 28px;
    border-radius: 8px;
    cursor: pointer;
    transition: all .15s;
    text-decoration: none;
    display: inline-block;
    border: none;
}
.btn-secondary {
    background: rgba(255,255,255,.08);
    color: rgba(245,240,232,.8);
    border: 1px solid rgba(255,255,255,.15);
}
.btn-secondary:hover {
    background: rgba(255,255,255,.12);
}
.btn-primary {
    background: var(--down-accent);
    color: var(--down-ink);
}
.btn-primary:hover {
    background: #c88a10;
}

@media (max-width: 640px) {
    .down-comparison {
        grid-template-columns: 1fr;
    }
    .down-arrow {
        transform: rotate(90deg);
    }
}
</style>

<header class="down-header">
    <div class="down-header-inner">
        <a href="{{ path('app_owner_subscription') }}" class="down-logo">
            <span>🍽️</span>
            Scan to See
        </a>
    </div>
</header>

<div class="down-container">
    <div class="down-card">
        <h1 class="down-title">Confirm Plan Downgrade</h1>
        <p class="down-subtitle">
            You're about to change from <strong>{{ currentSub.planLabel }}</strong> to <strong>{{ newPlanLabel }}</strong>.
        </p>

        <div class="down-comparison">
            <div class="down-plan-box current">
                <div class="down-plan-label">Current Plan</div>
                <div class="down-plan-name">{{ currentSub.planLabel }}</div>
                <div class="down-plan-limits">
                    📋 {{ publishedCount }} published menu{{ publishedCount != 1 ? 's' }}<br>
                    📝 {{ draftCount }} draft{{ draftCount != 1 ? 's' }}
                </div>
            </div>

            <div class="down-arrow">→</div>

            <div class="down-plan-box new">
                <div class="down-plan-label">New Plan</div>
                <div class="down-plan-name">{{ newPlanLabel }}</div>
                <div class="down-plan-limits">
                    {% if newPublishedLimit is not null %}
                        📋 Up to {{ newPublishedLimit }} published<br>
                    {% else %}
                        📋 Unlimited published<br>
                    {% endif %}
                    {% if newDraftLimit is not null %}
                        📝 Up to {{ newDraftLimit }} draft{{ newDraftLimit != 1 ? 's' }}
                    {% else %}
                        📝 Unlimited drafts
                    {% endif %}
                </div>
            </div>
        </div>

        {% if willNeedEnforcement %}
            <div class="down-warning">
                <p>
                    <strong>⚠️ Action Required:</strong> You currently have more menus than the {{ newPlanLabel }} plan allows. 
                    After confirming, you'll be asked to select which menus to keep. 
                    <strong>Unselected menus will be permanently deleted.</strong>
                </p>
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_owner_subscription_downgrade', {plan: newPlan, period: newPeriod}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('downgrade') }}">
            
            <div class="down-actions">
                <a href="{{ path('app_owner_subscription') }}" class="btn btn-secondary">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    {% if willNeedEnforcement %}
                        Continue to Menu Selection
                    {% else %}
                        Confirm Downgrade
                    {% endif %}
                </button>
            </div>
        </form>
    </div>
</div>

{% endblock %}
