{% extends 'owner/layout.html.twig' %}

{% block title %}{{ business ? 'Edit Business' : 'New Business' }} — S2S{% endblock %}
{% block page_title %}{{ business ? 'Edit Business' : 'New Business' }}{% endblock %}

{% block content %}
<div class="owner-panel" style="max-width:480px">
    <div class="owner-panel-head">
        <h2>{{ business ? 'Edit: ' ~ business.name : 'Add a business' }}</h2>
        <a href="{{ path('app_owner_businesses') }}" style="font-size:.82rem;color:var(--muted)">← Businesses</a>
    </div>
    <div class="owner-panel-body">
        {% if error %}
            <div class="owner-flash owner-flash--error" style="margin-bottom:16px">{{ error }}</div>
        {% endif %}
        <form class="owner-form" method="post" enctype="multipart/form-data">
            <div class="form-field">
                <label for="name">Business name</label>
                <input id="name" name="name" type="text"
                       placeholder="Blue Bean Café"
                       value="{{ business ? business.name : '' }}"
                       required>
            </div>

            {# ── Logo upload ─────────────────────────────────────────── #}
            <div class="form-field">
                <label>Logo <span style="color:var(--muted);font-weight:400">(JPG / PNG / WEBP · max 2 MB)</span></label>
                <div class="img-upload-widget">
                    <div class="img-upload-preview" id="logo-preview-wrap">
                        {% if business and business.logoPath %}
                            <img id="logo-preview"
                                 src="{{ asset(business.logoPath) }}"
                                 alt="Current logo"
                                 class="img-upload-thumb">
                        {% else %}
                            <div class="img-upload-placeholder" id="logo-placeholder">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                <span>No logo</span>
                            </div>
                            <img id="logo-preview"
                                 src=""
                                 alt="Logo preview"
                                 class="img-upload-thumb"
                                 style="display:none">
                        {% endif %}
                    </div>
                    <label class="img-upload-btn" for="logo-input">
                        {{ business and business.logoPath ? 'Change logo' : 'Upload logo' }}
                    </label>
                    <input id="logo-input" name="logo" type="file"
                           accept=".jpg,.jpeg,.png,.webp"
                           class="img-upload-hidden"
                           onchange="s2sImagePreview(this,'logo-preview','logo-placeholder')">
                </div>
            </div>

            <div style="display:flex;gap:12px;flex-wrap:wrap">
                <button class="btn btn-primary" type="submit">
                    {{ business ? 'Save changes' : 'Create business' }}
                </button>
                <a href="{{ path('app_owner_businesses') }}" class="btn btn-outline">Cancel</a>
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('business') }}">
        </form>
    </div>
</div>
{% endblock %}
