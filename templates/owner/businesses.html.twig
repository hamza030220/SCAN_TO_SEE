{% extends 'owner/layout.html.twig' %}

{% block title %}My Businesses — S2S{% endblock %}
{% block page_title %}My Businesses{% endblock %}

{% block content %}
{% include 'owner/_access_notice.html.twig' %}
<div class="owner-panel">
    <div class="owner-panel-head">
        <h2>Your businesses</h2>
        {% if canCreateBusiness %}
            <a href="{{ path('app_owner_business_new') }}"
               data-modal="{{ path('app_owner_business_new') }}"
               class="btn btn-primary btn-sm">Add business</a>
        {% else %}
            <button type="button" class="btn btn-outline btn-sm" data-plan-message-open>
                Business limit reached
            </button>
        {% endif %}
    </div>

    {% if businesses is empty %}
        <div class="owner-empty">
            <p>No businesses yet. Add your first one to start building menus.</p>
            <a href="{{ path('app_owner_business_new') }}"
               data-modal="{{ path('app_owner_business_new') }}"
               class="btn btn-primary">Add first business</a>
        </div>
    {% else %}
        <table class="owner-table">
            <thead>
                <tr>
                    <th style="width:52px"></th>
                    <th>Business name</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for business in businesses %}
                    <tr>
                        <td>
                            {% if business.logoPath %}
                                <img src="{{ asset(business.logoPath) }}"
                                     alt="{{ business.name }} logo"
                                     class="img-thumb-sm">
                            {% else %}
                                <div class="img-placeholder-sm"></div>
                            {% endif %}
                        </td>
                        <td style="font-weight:600">{{ business.name }}</td>
                        <td style="color:var(--muted);font-size:.82rem">{{ business.createdAt|date('M d, Y') }}</td>
                        <td style="text-align:right;white-space:nowrap">
                            <a href="{{ path('app_owner_business_qr', {id: business.id}) }}"
                               class="owner-table-action"
                               title="QR Code">QR</a>
                            <a href="{{ path('app_owner_business_edit', {id: business.id}) }}"
                               data-modal="{{ path('app_owner_business_edit', {id: business.id}) }}"
                               class="owner-table-action">Edit</a>
                            <form method="post"
                                  action="{{ path('app_owner_business_delete', {id: business.id}) }}"
                                  style="display:inline"
                                  onsubmit="return confirm('Delete «{{ business.name }}» and ALL its menus, categories, and items?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-business-' ~ business.id) }}">
                                <button type="submit" class="owner-table-action owner-table-action--danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>

{% if not canCreateBusiness %}
<div class="plan-message-modal" data-plan-message-modal hidden>
    <div class="plan-message-card" role="dialog" aria-modal="true" aria-labelledby="business-limit-title">
        <span class="material-symbols-outlined plan-message-icon" aria-hidden="true">domain_disabled</span>
        <h3 id="business-limit-title">Business limit reached</h3>
        <p>
            Your {{ accessContext.label }} includes
            {{ accessContext.limits.businesses is null ? 'unlimited businesses' : accessContext.limits.businesses ~ ' business' ~ (accessContext.limits.businesses == 1 ? '' : 'es') }}.
            Your existing business is safe and ready to edit.
        </p>
        <div class="plan-message-actions">
            <button type="button" class="btn btn-outline" data-plan-message-close>Got it</button>
            <a href="{{ path('app_owner_subscription') }}" class="btn btn-primary">Compare plans</a>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
