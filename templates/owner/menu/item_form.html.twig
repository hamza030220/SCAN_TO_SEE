{% extends 'owner/layout.html.twig' %}

{% block title %}{{ item ? 'Edit Item' : 'Add Item' }} — S2S{% endblock %}
{% block page_title %}{{ item ? 'Edit Item' : 'Add Item' }}{% endblock %}

{% block content %}
<div class="owner-panel" style="max-width:520px">
    <div class="owner-panel-head">
        <h2>{{ item ? 'Edit: ' ~ item.name : 'Add item' }}</h2>
        <a href="{{ path('app_owner_menu_show', {id: menu.id}) }}" style="font-size:.82rem;color:var(--muted)">← {{ menu.name }}</a>
    </div>
    <div class="owner-panel-body">
        <p style="color:var(--muted);font-size:.82rem;margin-bottom:20px">
            Category: <strong style="color:var(--ink)">{{ category.name }}</strong>
        </p>
        {% if error %}
            <div class="owner-flash owner-flash--error" style="margin-bottom:16px">{{ error }}</div>
        {% endif %}
        <form class="owner-form" method="post" enctype="multipart/form-data">
            <div class="form-field">
                <label for="name">Item name</label>
                <input id="name" name="name" type="text"
                       placeholder="Iced Latte"
                       value="{{ item ? item.name : '' }}"
                       required>
            </div>
            <div class="form-field">
                <label for="short_description">
                    Short description
                    <span style="color:var(--muted);font-weight:400">(optional)</span>
                </label>
                <input id="short_description" name="short_description" type="text"
                       placeholder="Oat milk option available"
                       value="{{ item ? (item.shortDescription ?? '') : '' }}">
            </div>
            <div class="form-field">
                <label for="price">Price <span style="color:var(--muted);font-weight:400">({{ menu.currency }})</span></label>
                <input id="price" name="price" type="number" step="0.01" min="0"
                       placeholder="8.50"
                       value="{{ item ? item.price : '' }}"
                       required>
            </div>
            <div class="form-field">
                <label for="details">Detailed description <span style="color:var(--muted);font-weight:400">(optional)</span></label>
                <textarea id="details" name="details" rows="4" maxlength="2000" placeholder="Ingredients, preparation, or anything customers should know">{{ item ? (item.details ?? '') : '' }}</textarea>
            </div>

            <details class="item-advanced" open>
                <summary><span class="material-symbols-outlined" aria-hidden="true">sell</span> Labels &amp; dietary information</summary>
                <div class="item-advanced__body">
                    <div class="form-field">
                        <label for="badge">Highlight badge</label>
                        <select id="badge" name="badge">
                            {% for value, label in {'': 'No badge', 'Popular': 'Popular', 'New': 'New', 'Chef choice': 'Chef choice', 'Limited': 'Limited'} %}
                                <option value="{{ value }}" {{ item and item.badge == value ? 'selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="dietary_tags">Dietary tags <span style="color:var(--muted);font-weight:400">(comma separated)</span></label>
                        <input id="dietary_tags" name="dietary_tags" type="text" maxlength="320" placeholder="Vegan, Halal, Gluten free" value="{{ item ? item.dietaryTags|join(', ') : '' }}">
                    </div>
                    <div class="form-field">
                        <label for="allergens">Allergens <span style="color:var(--muted);font-weight:400">(comma separated)</span></label>
                        <input id="allergens" name="allergens" type="text" maxlength="320" placeholder="Milk, Nuts, Gluten" value="{{ item ? item.allergens|join(', ') : '' }}">
                    </div>
                    <div class="form-field">
                        <label for="availability_note">Availability note</label>
                        <input id="availability_note" name="availability_note" type="text" maxlength="120" placeholder="Breakfast only · Until 11:30" value="{{ item ? (item.availabilityNote ?? '') : '' }}">
                    </div>
                </div>
            </details>

            <details class="item-advanced" open>
                <summary><span class="material-symbols-outlined" aria-hidden="true">format_list_bulleted</span> Sizes &amp; variants</summary>
                <div class="item-advanced__body">
                    <p class="form-help">Add up to 12 options with their final customer price.</p>
                    <div data-variant-rows>
                        {% for variant in item ? item.variants : [] %}
                            <div class="variant-row">
                                <input name="variant_name[]" type="text" maxlength="60" placeholder="Large" value="{{ variant.name }}" aria-label="Variant name">
                                <input name="variant_price[]" type="number" min="0" step="0.01" placeholder="0.00" value="{{ variant.price }}" aria-label="Variant price">
                                <button type="button" data-remove-variant aria-label="Remove variant"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
                            </div>
                        {% endfor %}
                    </div>
                    <button type="button" class="variant-add" data-add-variant><span class="material-symbols-outlined" aria-hidden="true">add</span> Add variant</button>
                </div>
            </details>
            <div class="form-field">
                <label for="sort_order">Sort order</label>
                <input id="sort_order" name="sort_order" type="number" min="0"
                       value="{{ item ? item.sortOrder : 0 }}">
            </div>
            <label style="display:flex;align-items:center;gap:10px;font-size:.88rem;cursor:pointer">
                <input type="checkbox" name="is_available" value="1"
                       {{ not item or item.isAvailable ? 'checked' : '' }}>
                Available to customers
            </label>

            {# ── Item image upload ────────────────────────────────────── #}
            <div class="form-field" style="margin-top:16px">
                <label>Photo <span style="color:var(--muted);font-weight:400">(JPG / PNG / WEBP · max 2 MB)</span></label>
                <div class="img-upload-widget">
                    <div class="img-upload-preview" id="item-preview-wrap">
                        {% if item and item.imagePath %}
                            <img id="item-preview"
                                 src="{{ asset(item.imagePath) }}"
                                 alt="Current photo"
                                 class="img-upload-thumb">
                        {% else %}
                            <div class="img-upload-placeholder" id="item-placeholder">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                <span>No photo</span>
                            </div>
                            <img id="item-preview"
                                 src=""
                                 alt="Photo preview"
                                 class="img-upload-thumb"
                                 style="display:none">
                        {% endif %}
                    </div>
                    <label class="img-upload-btn" for="item-input">
                        {{ item and item.imagePath ? 'Change photo' : 'Upload photo' }}
                    </label>
                    <input id="item-input" name="image" type="file"
                           accept=".jpg,.jpeg,.png,.webp"
                           class="img-upload-hidden"
                           onchange="s2sImagePreview(this,'item-preview','item-placeholder')">
                </div>
            </div>

            <div style="display:flex;gap:12px;flex-wrap:wrap">
                <button class="btn btn-primary" type="submit">
                    {{ item ? 'Save changes' : 'Add item' }}
                </button>
                <a href="{{ path('app_owner_menu_show', {id: menu.id}) }}" class="btn btn-outline">Cancel</a>
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('item') }}">
        </form>
    </div>
</div>
{% endblock %}
