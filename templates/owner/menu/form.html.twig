{% extends 'owner/layout.html.twig' %}

{% block title %}{{ menu ? 'Edit — ' ~ menu.name : 'New Menu' }} — S2S{% endblock %}
{% block page_title %}{{ menu ? 'Edit Menu' : 'New Menu' }}{% endblock %}

{% block content %}
<div class="owner-panel" style="max-width:560px">
    <div class="owner-panel-head">
        <h2>{{ menu ? 'Edit: ' ~ menu.name : 'Create new menu' }}</h2>
        <a href="{{ path('app_owner_menus') }}" style="font-size:.82rem;color:var(--muted)">← All menus</a>
    </div>
    <div class="owner-panel-body">
        {% if error and error not in ['limit_reached', 'published_limit_reached', 'draft_limit_reached', 'subscription_expired'] %}
            <div class="owner-flash owner-flash--error" style="margin-bottom:16px">{{ error }}</div>
        {% endif %}
        <form class="owner-form" method="post">
            {% if not menu and businesses|length > 1 %}
            <div class="form-field">
                <label for="business_id">Business</label>
                <select id="business_id" name="business_id">
                    {% for b in businesses %}
                        <option value="{{ b.id }}">{{ b.name }}</option>
                    {% endfor %}
                </select>
            </div>
            {% elseif not menu %}
                <input type="hidden" name="business_id" value="{{ businesses[0].id }}">
            {% endif %}
            <div class="form-field">
                <label for="name">Menu name</label>
                <input id="name" name="name" type="text"
                       placeholder="Lunch Menu"
                       value="{{ menu ? menu.name : '' }}"
                       required>
            </div>
            <div class="form-field">
                <label for="currency">Currency</label>
                <select id="currency" name="currency">
                    {% for cur in ['TND', 'EUR', 'USD', 'GBP', 'MAD'] %}
                        <option value="{{ cur }}"
                            {{ (menu and menu.currency == cur) or (not menu and cur == 'TND') ? 'selected' : '' }}>
                            {{ cur }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-field">
                <label for="status">Status</label>
                <select id="status" name="status" onchange="checkPublishLimit(this)">
                    <option value="draft"     {{ not menu or menu.status == 'draft'      ? 'selected' : '' }}>Draft</option>
                    <option value="published" {{ menu and menu.status == 'published'     ? 'selected' : '' }}>Published</option>
                </select>
            </div>
            <div style="display:flex;gap:12px;flex-wrap:wrap">
                <button class="btn btn-primary" type="submit">
                    {{ menu ? 'Save changes' : 'Create menu' }}
                </button>
                <a href="{{ path('app_owner_menus') }}" class="btn btn-outline">Cancel</a>
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('menu') }}">
        </form>
    </div>
</div>

{# ── Plan Limit Modal ──────────────────────────────────────────────────── #}
<div class="limit-modal" id="limitModal" style="display: {% if error in ['limit_reached', 'published_limit_reached', 'draft_limit_reached', 'subscription_expired'] %}flex{% else %}none{% endif %};">
    <div class="limit-modal-inner">
        <div class="limit-modal-icon">
            {% if error == 'subscription_expired' %}
                <span class="material-symbols-outlined" aria-hidden="true">lock</span>
            {% else %}
                <span class="material-symbols-outlined" aria-hidden="true">event_busy</span>
            {% endif %}
        </div>
        
        {% if error == 'subscription_expired' %}
            <h3 class="limit-modal-title">Subscription Expired</h3>
            <p class="limit-modal-text">
                Your subscription has expired or been cancelled.<br>
                Please renew your plan to continue managing your menus.
            </p>
            <div class="limit-modal-actions">
                <button class="btn btn-outline" onclick="closeModal()">
                    Cancel
                </button>
                <a href="{{ path('app_owner_subscription') }}" class="btn btn-primary">
                    Renew Subscription
                </a>
            </div>
            
        {% elseif error == 'published_limit_reached' %}
            <h3 class="limit-modal-title">Published Menu Limit Reached</h3>
            <p class="limit-modal-text">
                {% set limit = accessContext.limits.published %}
                You've reached your plan's published menu limit 
                <strong>({{ publishedCount }} / {{ limit }} used)</strong>.<br>
                Upgrade to publish more menus, or unpublish another menu first.
            </p>
            <div class="limit-modal-actions">
                <button class="btn btn-outline" onclick="closeModal()">
                    Keep as Draft
                </button>
                <a href="{{ path('app_owner_subscription') }}" class="btn btn-primary">
                    Upgrade Plan
                </a>
            </div>
            
        {% elseif error == 'draft_limit_reached' %}
            <h3 class="limit-modal-title">Draft Menu Limit Reached</h3>
            <p class="limit-modal-text">
                {% set limit = accessContext.limits.draft %}
                You've reached your plan's draft menu limit 
                <strong>({{ draftCount }} / {{ limit }} used)</strong>.<br>
                Upgrade to create more drafts, or delete an unused draft menu first.
            </p>
            <div class="limit-modal-actions">
                <button class="btn btn-outline" onclick="closeModal()">
                    Keep Published
                </button>
                <a href="{{ path('app_owner_subscription') }}" class="btn btn-primary">
                    Upgrade Plan
                </a>
            </div>
            
        {% else %}
            {# Fallback for generic limit_reached #}
            <h3 class="limit-modal-title">Plan Limit Reached</h3>
            <p class="limit-modal-text" id="limitModalMessage">
                {{ limitMessage ?? ('Your ' ~ accessContext.label ~ ' has no free slot for that menu status. Change another menu or compare plans to continue.') }}
            </p>
            <div class="limit-modal-actions">
                <button class="btn btn-outline" onclick="closeModal()">
                    Cancel
                </button>
                <a href="{{ path('app_owner_subscription') }}" class="btn btn-primary">
                    Upgrade Plan
                </a>
            </div>
        {% endif %}
    </div>
</div>

<style>
.limit-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(10, 6, 2, 0.75);
    backdrop-filter: blur(6px);
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.limit-modal-inner {
    background: #fff;
    border-radius: 16px;
    max-width: 460px;
    width: 100%;
    padding: 32px 28px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.4);
    text-align: center;
}

.limit-modal-icon {
    font-size: 3rem;
    margin-bottom: 16px;
    animation: bounce 0.6s ease;
}

.limit-modal-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--adm-ink);
    margin: 0 0 12px;
}

.limit-modal-text {
    font-size: 0.95rem;
    color: var(--adm-muted);
    line-height: 1.6;
    margin: 0 0 28px;
}

.limit-modal-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
}

.limit-modal-actions .btn {
    flex: 1;
}

@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
}
</style>

<script>
const canPublish = {{ canPublish ? 'true' : 'false' }};
const canDraft = {{ canDraft ? 'true' : 'false' }};
const menuStatus = '{{ menu ? menu.status : 'draft' }}';
const publishedLimitMessage = {{ (publishedLimitMessage ?? '')|json_encode|raw }};
const draftLimitMessage = {{ (draftLimitMessage ?? '')|json_encode|raw }};

function checkPublishLimit(select) {
    const isBlocked = (select.value === 'published' && !canPublish)
        || (select.value === 'draft' && !canDraft);
    if (isBlocked) {
        const message = select.value === 'published' ? publishedLimitMessage : draftLimitMessage;
        const messageElement = document.getElementById('limitModalMessage');
        if (messageElement && message) messageElement.textContent = message;
        document.getElementById('limitModal').style.display = 'flex';
        select.value = menuStatus;
    }
}

function closeModal() {
    const modal = document.getElementById('limitModal');
    modal.style.display = 'none';
    
    // Reset status dropdown to original value
    const statusSelect = document.getElementById('status');
    if (statusSelect) {
        statusSelect.value = menuStatus;
    }
}

// Close modal when clicking outside
document.getElementById('limitModal')?.addEventListener('click', function(e) {
    if (e.target === this) {
        closeModal();
    }
});

// Close modal on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        const modal = document.getElementById('limitModal');
        if (modal && modal.style.display === 'flex') {
            closeModal();
        }
    }
});
</script>

{% endblock %}
