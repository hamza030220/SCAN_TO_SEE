{% extends 'owner/layout.html.twig' %}

{% block title %}{{ menu.name }} — S2S{% endblock %}
{% block page_title %}{{ menu.name }}{% endblock %}

{% block content %}

{# ── Menu header row ─────────────────────────────────────────────────── #}
<div class="menu-studio-heading">
    <div class="menu-studio-heading__identity">
        <a class="menu-studio-back" href="{{ path('app_owner_menus') }}">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
            Menus
        </a>
        <div>
            <div class="menu-studio-title-row">
                <h1>{{ menu.name }}</h1>
                <span class="badge badge--{{ menu.status }}">{{ menu.status }}</span>
            </div>
            <p>{{ menu.business.name }} <span aria-hidden="true">·</span> {{ menu.currency }} <span aria-hidden="true">·</span> Updated {{ menu.updatedAt|date('M j, Y H:i') }}</p>
        </div>
    </div>
    <div class="menu-studio-heading__actions">
        <a href="{{ path('app_owner_menu_edit', {id: menu.id}) }}"
           data-modal="{{ path('app_owner_menu_edit', {id: menu.id}) }}"
           class="btn btn-outline btn-sm"><span class="material-symbols-outlined" aria-hidden="true">settings</span> Settings</a>
        <form method="post" action="{{ path('app_owner_menu_status', {id: menu.id}) }}"
              onsubmit="return confirm('{{ menu.status == 'published' ? 'Move this menu to draft? Customers will no longer be able to open it.' : 'Publish this menu for customers now?' }}')">
            <input type="hidden" name="_token" value="{{ csrf_token('menu-status-' ~ menu.id) }}">
            <input type="hidden" name="status" value="{{ menu.status == 'published' ? 'draft' : 'published' }}">
            <button type="submit" class="btn {{ menu.status == 'published' ? 'btn-outline' : 'btn-primary' }} btn-sm">
                <span class="material-symbols-outlined" aria-hidden="true">{{ menu.status == 'published' ? 'visibility_off' : 'publish' }}</span>
                {{ menu.status == 'published' ? 'Unpublish' : 'Publish' }}
            </button>
        </form>
        <a href="{{ path('app_public_menu_view', {slug: menu.business.slug, menuSlug: menu.slug, preview: 1}) }}"
           target="_blank" rel="noopener" class="btn btn-primary btn-sm">
            <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span> Preview
        </a>
    </div>
</div>

<div class="menu-studio-layout">
    <nav class="menu-studio-tools" aria-label="Menu workspace">
        <a href="#menu-content" class="active" aria-current="page">
            <span class="material-symbols-outlined" aria-hidden="true">edit_note</span>
            <span><strong>Content</strong><small>Categories and items</small></span>
        </a>
        <button type="button" id="ds_openBtn">
            <span class="material-symbols-outlined" aria-hidden="true">palette</span>
            <span><strong>Appearance</strong><small>Brand and layout</small></span>
        </button>
        <a href="{{ path('app_public_menu_view', {slug: menu.business.slug, menuSlug: menu.slug, preview: 1}) }}" target="_blank" rel="noopener">
            <span class="material-symbols-outlined" aria-hidden="true">devices</span>
            <span><strong>Live preview</strong><small>Customer experience</small></span>
        </a>
        <a href="{{ path('app_owner_business_qr', {id: menu.business.id}) }}">
            <span class="material-symbols-outlined" aria-hidden="true">qr_code_2</span>
            <span><strong>QR &amp; share</strong><small>Print and distribute</small></span>
        </a>
        <button type="button" id="scannerOnboardingBtn"
                {% if not menu.canUseScanner() %}disabled aria-disabled="true" title="Menu Scanner is only available for an empty menu."{% endif %}>
            <span class="material-symbols-outlined" aria-hidden="true">document_scanner</span>
            <span><strong>AI scanner <em>Beta</em></strong><small>{{ menu.canUseScanner() ? 'Import an empty menu' : 'Available on empty menus' }}</small></span>
        </button>
    </nav>

    <section class="menu-studio-canvas" id="menu-content">
        {% if menu.status == 'published' %}
            <div class="studio-live-notice" role="status">
                <span class="material-symbols-outlined" aria-hidden="true">public</span>
                <div><strong>This menu is live.</strong><span>Content and design changes are visible to customers as soon as you save them.</span></div>
            </div>
        {% endif %}
        <div class="menu-studio-summary" aria-label="Menu summary">
            <div><span class="material-symbols-outlined" aria-hidden="true">category</span><strong>{{ menu.categories|length }}</strong><small>Categories</small></div>
            <div><span class="material-symbols-outlined" aria-hidden="true">room_service</span><strong>{% set itemTotal = 0 %}{% for category in menu.categories %}{% set itemTotal = itemTotal + category.items|length %}{% endfor %}{{ itemTotal }}</strong><small>Items</small></div>
            <div><span class="material-symbols-outlined" aria-hidden="true">visibility</span><strong>{{ menu.status == 'published' ? 'Live' : 'Private' }}</strong><small>Visibility</small></div>
        </div>

{# ── Categories header ───────────────────────────────────────────────── #}
{% if not menu.canUseScanner() %}
    <div class="owner-flash owner-flash--info" role="status">
        Menu Scanner is available only while a menu is empty. This menu already contains content, so scanning is disabled to protect your existing work.
    </div>
{% endif %}

<div class="menu-studio-section-head">
    <div>
        <span>Menu structure</span>
        <h2>Categories &amp; Items</h2>
        <p>Organize what customers see in your digital menu.</p>
    </div>
    <a href="{{ path('app_owner_category_new', {menuId: menu.id}) }}"
       data-modal="{{ path('app_owner_category_new', {menuId: menu.id}) }}"
       class="btn btn-primary btn-sm"><span class="material-symbols-outlined" aria-hidden="true">add</span> Add Category</a>
</div>

{# ── Empty state ─────────────────────────────────────────────────────── #}
{% if menu.categories|length == 0 %}
    <div class="owner-empty">
        <p>No categories yet. Add a category to start building this menu.</p>
        <a href="{{ path('app_owner_category_new', {menuId: menu.id}) }}"
           data-modal="{{ path('app_owner_category_new', {menuId: menu.id}) }}"
           class="btn btn-primary">Add first category</a>
    </div>
{% else %}

{# ── Category cards ──────────────────────────────────────────────────── #}
<div id="studioCategories"
     data-reorder-url="{{ path('app_owner_menu_reorder', {id: menu.id}) }}"
     data-reorder-token="{{ csrf_token('reorder-menu-' ~ menu.id) }}">
{% for category in menu.categories %}
    <div class="owner-panel studio-category" data-category-id="{{ category.id }}" draggable="true">
        <div class="owner-panel-head">
            <div>
                <span class="studio-category-grip material-symbols-outlined" aria-hidden="true">drag_indicator</span>
                <strong>{{ category.name }}</strong>
                {% if category.parent %}
                    <span style="color:var(--muted);font-size:.78rem;margin-left:8px">under {{ category.parent.name }}</span>
                {% endif %}
                {% if not category.isVisible %}
                    <span class="badge badge--draft" style="margin-left:8px">Hidden</span>
                {% endif %}
            </div>
            <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                <button type="button" class="owner-table-action studio-move" data-move-category="up" title="Move category up" aria-label="Move {{ category.name }} up"><span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_up</span></button>
                <button type="button" class="owner-table-action studio-move" data-move-category="down" title="Move category down" aria-label="Move {{ category.name }} down"><span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_down</span></button>
                <a href="{{ path('app_owner_item_new', {menuId: menu.id, catId: category.id}) }}"
                   data-modal="{{ path('app_owner_item_new', {menuId: menu.id, catId: category.id}) }}"
                   class="btn btn-primary btn-sm"><span class="material-symbols-outlined" aria-hidden="true">add</span> Item</a>
                <a href="{{ path('app_owner_category_edit', {menuId: menu.id, catId: category.id}) }}"
                   data-modal="{{ path('app_owner_category_edit', {menuId: menu.id, catId: category.id}) }}"
                   class="owner-table-action">Edit</a>
                <form method="post" action="{{ path('app_owner_category_visibility', {menuId: menu.id, catId: category.id}) }}" style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('category-visibility-' ~ category.id) }}">
                    <button type="submit" class="owner-table-action">{{ category.isVisible ? 'Hide' : 'Show' }}</button>
                </form>
                <form method="post"
                      action="{{ path('app_owner_category_duplicate', {menuId: menu.id, catId: category.id}) }}"
                      style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('duplicate-category-' ~ category.id) }}">
                    <button type="submit" class="owner-table-action">Duplicate</button>
                </form>
                <form method="post"
                      action="{{ path('app_owner_category_delete', {menuId: menu.id, catId: category.id}) }}"
                      style="display:inline"
                      onsubmit="return confirm('Delete «{{ category.name }}» and all its items?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-cat-' ~ category.id) }}">
                    <button type="submit" class="owner-table-action owner-table-action--danger">Delete</button>
                </form>
            </div>
        </div>

        {% if category.items|length > 0 %}
            <table class="owner-table">
                <thead>
                    <tr>
                        <th style="width:52px"></th>
                        <th>Item</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Available</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody data-sortable-items data-category-id="{{ category.id }}">
                    {% for item in category.items %}
                        <tr data-item-id="{{ item.id }}" draggable="true">
                            <td data-label="Image">
                                <span class="studio-item-grip material-symbols-outlined" aria-hidden="true">drag_indicator</span>
                                {% if item.imagePath %}
                                    <img src="{{ asset(item.imagePath) }}"
                                         alt="{{ item.name }}"
                                         class="img-thumb-sm">
                                {% else %}
                                    <div class="img-placeholder-sm"></div>
                                {% endif %}
                            </td>
                            <td data-label="Item" style="font-weight:600">{{ item.name }}</td>
                            <td data-label="Description" style="color:var(--muted);font-size:.82rem">{{ item.shortDescription ?? '—' }}</td>
                            <td data-label="Price">{{ item.price }} {{ menu.currency }}</td>
                            <td data-label="Available">
                                <form method="post" action="{{ path('app_owner_item_availability', {menuId: menu.id, catId: category.id, itemId: item.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('item-availability-' ~ item.id) }}">
                                    <button type="submit" class="badge badge--{{ item.isAvailable ? 'published' : 'draft' }} studio-status-toggle" title="Change availability">
                                        {{ item.isAvailable ? 'Yes' : 'No' }}
                                    </button>
                                </form>
                            </td>
                            <td data-label="Actions" style="text-align:right;white-space:nowrap">
                                <button type="button" class="owner-table-action studio-move" data-move-item="up" title="Move item up" aria-label="Move {{ item.name }} up"><span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_up</span></button>
                                <button type="button" class="owner-table-action studio-move" data-move-item="down" title="Move item down" aria-label="Move {{ item.name }} down"><span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_down</span></button>
                                <a href="{{ path('app_owner_item_edit', {menuId: menu.id, catId: category.id, itemId: item.id}) }}"
                                   data-modal="{{ path('app_owner_item_edit', {menuId: menu.id, catId: category.id, itemId: item.id}) }}"
                                   class="owner-table-action">Edit</a>
                                <form method="post"
                                      action="{{ path('app_owner_item_duplicate', {menuId: menu.id, catId: category.id, itemId: item.id}) }}"
                                      style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('duplicate-item-' ~ item.id) }}">
                                    <button type="submit" class="owner-table-action">Duplicate</button>
                                </form>
                                <form method="post"
                                      action="{{ path('app_owner_item_delete', {menuId: menu.id, catId: category.id, itemId: item.id}) }}"
                                      style="display:inline"
                                      onsubmit="return confirm('Delete «{{ item.name }}»?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-item-' ~ item.id) }}">
                                    <button type="submit" class="owner-table-action owner-table-action--danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div style="padding:14px 24px;color:var(--muted);font-size:.85rem">
                No items yet.
                <a href="{{ path('app_owner_item_new', {menuId: menu.id, catId: category.id}) }}"
                   data-modal="{{ path('app_owner_item_new', {menuId: menu.id, catId: category.id}) }}"
                   style="color:var(--amber-dk);font-weight:600">Add first item →</a>
            </div>
        {% endif %}
    </div>
{% endfor %}
</div>
{% endif %}

    </section>
</div>

<div class="studio-toast" id="studioToast" role="status" aria-live="polite" hidden></div>

<script>
(function () {
    var categoryContainer = document.getElementById('studioCategories');
    if (!categoryContainer) return;

    var endpoint = categoryContainer.dataset.reorderUrl;
    var token = categoryContainer.dataset.reorderToken;
    var toast = document.getElementById('studioToast');

    function directChildren(container, selector) {
        return Array.from(container.children).filter(function (entry) { return entry.matches(selector); });
    }

    function notify(message, isError) {
        toast.textContent = message;
        toast.classList.toggle('studio-toast--error', !!isError);
        toast.hidden = false;
        window.clearTimeout(notify.timer);
        notify.timer = window.setTimeout(function () { toast.hidden = true; }, 2600);
    }

    function restore(container, selector, attribute, originalIds) {
        var entries = {};
        directChildren(container, selector).forEach(function (entry) { entries[entry.dataset[attribute]] = entry; });
        originalIds.forEach(function (id) { if (entries[id]) container.appendChild(entries[id]); });
    }

    function persist(container, selector, attribute, type, categoryId, originalIds) {
        var ids = directChildren(container, selector).map(function (entry) { return Number(entry.dataset[attribute]); });
        fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ _token: token, type: type, categoryId: categoryId || null, ids: ids })
        }).then(function (response) {
            return response.json().catch(function () { return {}; }).then(function (payload) {
                if (!response.ok || !payload.ok) throw new Error(payload.error || 'The new order could not be saved.');
            });
        }).then(function () {
            notify('Order saved.', false);
        }).catch(function (error) {
            restore(container, selector, attribute, originalIds);
            notify(error.message || 'The new order could not be saved.', true);
        });
    }

    function makeSortable(container, selector, attribute, type, categoryId) {
        var dragged = null;
        var originalIds = [];

        directChildren(container, selector).forEach(function (entry) {
            entry.addEventListener('dragstart', function (event) {
                if (event.target !== entry) return;
                dragged = entry;
                originalIds = directChildren(container, selector).map(function (item) { return item.dataset[attribute]; });
                entry.classList.add('is-dragging');
                event.dataTransfer.effectAllowed = 'move';
                event.dataTransfer.setData('text/plain', entry.dataset[attribute]);
                event.stopPropagation();
            });
            entry.addEventListener('dragend', function (event) {
                if (event.target !== entry || !dragged) return;
                entry.classList.remove('is-dragging');
                persist(container, selector, attribute, type, categoryId, originalIds);
                dragged = null;
                event.stopPropagation();
            });
        });

        container.addEventListener('dragover', function (event) {
            if (!dragged) return;
            event.preventDefault();
            var candidates = directChildren(container, selector).filter(function (entry) { return entry !== dragged; });
            var after = candidates.reduce(function (closest, entry) {
                var box = entry.getBoundingClientRect();
                var offset = event.clientY - box.top - (box.height / 2);
                return offset < 0 && offset > closest.offset ? { offset: offset, entry: entry } : closest;
            }, { offset: Number.NEGATIVE_INFINITY, entry: null }).entry;
            if (after) container.insertBefore(dragged, after);
            else container.appendChild(dragged);
        });
    }

    makeSortable(categoryContainer, '.studio-category', 'categoryId', 'categories', null);
    document.querySelectorAll('[data-sortable-items]').forEach(function (tbody) {
        makeSortable(tbody, '[data-item-id]', 'itemId', 'items', Number(tbody.dataset.categoryId));
    });

    categoryContainer.addEventListener('click', function (event) {
        var categoryButton = event.target.closest('[data-move-category]');
        var itemButton = event.target.closest('[data-move-item]');
        if (!categoryButton && !itemButton) return;

        var isCategory = !!categoryButton;
        var button = categoryButton || itemButton;
        var entry = isCategory ? button.closest('.studio-category') : button.closest('[data-item-id]');
        var container = isCategory ? categoryContainer : entry.parentElement;
        var selector = isCategory ? '.studio-category' : '[data-item-id]';
        var attribute = isCategory ? 'categoryId' : 'itemId';
        var entries = directChildren(container, selector);
        var originalIds = entries.map(function (candidate) { return candidate.dataset[attribute]; });
        var position = entries.indexOf(entry);
        var direction = button.dataset[isCategory ? 'moveCategory' : 'moveItem'];

        if (direction === 'up' && position > 0) container.insertBefore(entry, entries[position - 1]);
        else if (direction === 'down' && position < entries.length - 1) container.insertBefore(entries[position + 1], entry);
        else return;

        persist(container, selector, attribute, isCategory ? 'categories' : 'items', isCategory ? null : Number(container.dataset.categoryId), originalIds);
    });
})();
</script>

{% endblock %}

{# ── Design Panel ─────────────────────────────────────────────────────── #}
{% block after_content %}
{% set tc = menu.themeConfig %}
<style>
.ds-panel{position:fixed;inset:0;z-index:1000;display:flex;flex-direction:column;height:100dvh;background:#fff;transform:translateX(100%);transition:transform .35s cubic-bezier(.22,.68,0,1.1);}
.ds-panel.open{transform:translateX(0);}
html.ds-page-locked{overflow:hidden;scrollbar-gutter:stable;}
body.ds-page-locked{position:fixed;width:100%;overflow:hidden;}
.ds-head{display:flex;align-items:center;gap:10px;padding:0 16px;height:54px;background:#18120a;color:#fff;flex-shrink:0;}
.ds-head h2{flex:1;font-family:'Space Grotesk',sans-serif;font-size:.95rem;font-weight:700;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.ds-save-btn{padding:7px 18px;border-radius:8px;border:none;cursor:pointer;background:#E8A020;color:#18120a;font-family:'Space Grotesk',sans-serif;font-size:.82rem;font-weight:700;white-space:nowrap;transition:opacity .15s;}
.ds-save-btn:disabled{opacity:.6;}.ds-save-btn.saved{background:#22c55e;color:#fff;}
.ds-close-btn{width:34px;height:34px;border-radius:8px;border:none;cursor:pointer;background:rgba(255,255,255,.12);color:#fff;font-size:1.1rem;display:flex;align-items:center;justify-content:center;transition:background .15s;}
.ds-close-btn:hover{background:rgba(255,255,255,.22);}
.ds-body{flex:1;display:flex;overflow:hidden;min-height:0;}
.ds-preview-wrap{flex:1;overflow:hidden;display:none;flex-direction:column;background:#e8e3dc;}
@media(min-width:860px){.ds-preview-wrap{display:flex;}}
.ds-preview-toolbar{display:flex;align-items:center;justify-content:center;gap:6px;height:44px;padding:6px;background:#f7f3ec;border-bottom:1px solid #d8cfc2;}
.ds-device-btn,.ds-mobile-btn{display:inline-flex;align-items:center;gap:5px;padding:6px 10px;border:1px solid transparent;border-radius:7px;background:transparent;color:#756858;font:600 .72rem 'DM Sans',sans-serif;cursor:pointer;}
.ds-device-btn.active,.ds-mobile-btn.active{border-color:#d2c5b4;background:#fff;color:#18120a;box-shadow:0 2px 8px rgba(35,24,10,.08);}
.ds-device-btn .material-symbols-outlined,.ds-mobile-btn .material-symbols-outlined{font-size:17px;}
.ds-preview-stage{display:flex;justify-content:center;flex:1;min-height:0;padding:14px;overflow:hidden;overscroll-behavior:contain;}
.ds-preview-stage iframe{width:100%;height:100%;border:0;background:#fff;box-shadow:0 12px 40px rgba(36,25,10,.16);transition:width .2s ease;}
.ds-mobile-bar{display:none;background:#f7f3ec;border-bottom:1px solid #ddd3c6;padding:7px 10px;gap:7px;}
.ds-mobile-note{display:none;padding:11px 16px;background:#fff7e7;border-bottom:1px solid #f0d59f;color:#73511d;font-size:.76rem;line-height:1.45;}
.ds-controls{width:min(390px,36vw);min-width:350px;flex-shrink:0;overflow-y:auto;background:#f5f2ed;border-left:1px solid #ded7cd;overscroll-behavior:contain;scrollbar-gutter:stable;scrollbar-width:thin;scrollbar-color:#c8b9a6 transparent;}
.ds-controls::-webkit-scrollbar{width:8px;}.ds-controls::-webkit-scrollbar-thumb{background:#c8b9a6;border:2px solid #faf9f7;border-radius:999px;}
@media(max-width:860px){
  .ds-controls{width:100%;min-width:0;border-left:none;}
  .ds-mobile-bar{display:flex;}
  .ds-mobile-note{display:block;}
  .ds-mobile-btn{flex:1;justify-content:center;}
  .ds-panel.mobile-preview .ds-controls{display:none;}
  .ds-panel.mobile-preview .ds-preview-wrap{display:flex;width:100%;}
  .ds-preview-toolbar{display:none;}
  .ds-preview-stage{padding:0;}
  .ds-preview-stage iframe{width:100%!important;box-shadow:none;}
}
.ds-inspector-top{position:sticky;top:0;z-index:4;background:rgba(245,242,237,.96);backdrop-filter:blur(12px);border-bottom:1px solid #ded7cd;}
.ds-inspector-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px 10px;}
.ds-inspector-kicker{display:block;color:#9c8874;font-size:.62rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase;}
.ds-inspector-head strong{display:block;margin-top:2px;color:#251d14;font:700 .98rem 'Space Grotesk',sans-serif;}
.ds-dirty-state{padding:4px 8px;border-radius:99px;background:#e9e4dd;color:#74695d;font-size:.64rem;font-weight:800;white-space:nowrap;}
.ds-dirty-state.unsaved{background:#fff0cf;color:#895708;}.ds-dirty-state.error{background:#fee2e2;color:#991b1b;}
.ds-tabs{display:grid;grid-template-columns:repeat(5,1fr);padding:0 10px 10px;gap:5px;}
.ds-tab{display:flex;min-width:0;flex-direction:column;align-items:center;gap:3px;padding:8px 3px;border:1px solid transparent;border-radius:10px;background:transparent;color:#786c5e;font:700 .62rem 'DM Sans',sans-serif;cursor:pointer;}
.ds-tab .material-symbols-outlined{font-size:18px;}.ds-tab.active{background:#fff;border-color:#ded7cd;color:#18120a;box-shadow:0 3px 10px rgba(36,25,10,.06);}
.ds-preview-feedback{display:flex;align-items:center;gap:6px;margin:0 12px 10px;padding:7px 9px;border-radius:8px;background:#eaf7ee;color:#23643a;font-size:.66rem;font-weight:700;transition:background .18s,transform .18s;}
.ds-preview-feedback .material-symbols-outlined{font-size:15px;}.ds-preview-feedback.pulse{background:#d8f2e1;transform:translateY(-1px);}
.ds-section{display:none;margin:12px;padding:16px 16px 17px;border:1px solid #e2dbd1;border-radius:14px;background:#fff;box-shadow:0 5px 20px rgba(43,31,17,.035);}
.ds-section.active{display:block;}
.ds-section-title{font-family:'Space Grotesk',sans-serif;font-size:.71rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:#806d59;margin:0 0 4px;}
.ds-section-copy{margin:0 0 14px;color:#8b7e70;font-size:.7rem;line-height:1.45;}
.ds-row{margin-bottom:14px;display:flex;flex-direction:column;gap:6px;}.ds-row:last-child{margin-bottom:0;}
.ds-label{font-size:.78rem;font-weight:600;color:#3d3328;display:flex;align-items:center;gap:6px;}
.ds-field-help{color:#8b7e70;font-size:.66rem;line-height:1.45;}.ds-field-help code{padding:1px 4px;border-radius:4px;background:#eee8df;color:#5f5142;font-size:.63rem;}
.ds-seg{display:flex;border:1px solid #d5cec5;border-radius:10px;overflow:hidden;background:#faf8f5;}
.ds-seg input[type=radio]{display:none;}
.ds-seg-btn{flex:1;padding:8px 4px;font-size:.73rem;font-weight:700;text-align:center;color:#7a6f60;cursor:pointer;border-right:1px solid #d5cec5;transition:background .12s,color .12s;user-select:none;}
.ds-seg-btn:last-of-type{border-right:none;}
.ds-seg input[type=radio]:checked+.ds-seg-btn{background:#18120a;color:#fff;}
.ds-seg--four .ds-seg-btn{font-size:.66rem;}
.ds-color-row{display:flex;align-items:center;gap:8px;}
.ds-color-input{width:40px;height:34px;border:1px solid #d5cec5;border-radius:8px;padding:2px;cursor:pointer;background:#fff;flex-shrink:0;}
.ds-color-text{flex:1;font-size:.8rem;font-family:monospace;border:1px solid #d5cec5;border-radius:8px;padding:6px 10px;color:#3d3328;background:#fff;}
.ds-select{width:100%;padding:8px 10px;border:1px solid #d5cec5;border-radius:8px;font-size:.84rem;color:#3d3328;background:#fff;font:inherit;}
.ds-slider-row{display:flex;align-items:center;gap:8px;}.ds-slider{flex:1;accent-color:#18120a;}
.ds-img-preview{width:100%;height:80px;object-fit:cover;border-radius:6px;display:none;border:1px solid #d5cec5;margin-bottom:6px;}
.ds-file-label{display:block;padding:8px 14px;font-size:.78rem;font-weight:600;border:1px dashed #d5cec5;border-radius:8px;color:#7a6f60;cursor:pointer;text-align:center;transition:border-color .15s,color .15s;}
.ds-file-label:hover{border-color:#18120a;color:#18120a;}.ds-file-input{display:none;}
.ds-presets{display:grid;grid-template-columns:1fr;gap:7px;}
.ds-presets button{display:grid;grid-template-columns:56px 1fr;grid-template-rows:auto auto;column-gap:10px;padding:8px;border:1px solid #d8cec0;border-radius:11px;background:#fff;color:#514537;text-align:left;font:600 .72rem 'DM Sans',sans-serif;cursor:pointer;}
.ds-presets button:hover{border-color:#E8A020;}
.ds-presets button span{grid-row:1/3;display:block;height:42px;border-radius:7px;background:linear-gradient(135deg,var(--preset-a) 0 65%,var(--preset-b) 65%);}
.ds-presets button strong{align-self:end;color:#30261b;font-size:.77rem;}.ds-presets button small{color:#938475;font-size:.64rem;}
.ds-reset-btn{display:flex;align-items:center;justify-content:center;gap:5px;width:100%;margin-top:8px;padding:7px;border:0;background:transparent;color:#7a6f60;font:600 .72rem 'DM Sans',sans-serif;cursor:pointer;}
.ds-reset-btn .material-symbols-outlined{font-size:16px;}
.ds-contrast{margin-top:8px;padding:8px 10px;border-radius:6px;background:#edf8f1;color:#166534;font-size:.7rem;line-height:1.4;}
.ds-contrast.warning{background:#fff6e5;color:#8a5300;}
.hero-panel-status{display:flex;align-items:flex-start;gap:9px;margin-bottom:14px;padding:10px 11px;border-radius:10px;background:#edf8f1;color:#1f6339;font-size:.7rem;line-height:1.45;}.hero-panel-status.warning{background:#fff6e5;color:#805000}.hero-panel-status.error{background:#feecec;color:#991b1b}.hero-panel-status .material-symbols-outlined{font-size:18px;flex:0 0 auto}.hero-panel-status strong,.hero-panel-status span{display:block}
.hero-switch{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px;border:1px solid #dfd7cc;border-radius:10px;background:#faf8f5}.hero-switch strong{display:block;font-size:.76rem}.hero-switch small{display:block;margin-top:2px;color:#86796b;font-size:.65rem}.hero-switch input{width:38px;height:20px;accent-color:#18120a}
.hero-schedule-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.hero-schedule-grid input{min-width:0;width:100%;padding:7px;border:1px solid #d5cec5;border-radius:8px;font:inherit;font-size:.7rem}
.hero-mode{display:flex;gap:6px;margin-bottom:10px}.hero-mode button{flex:1;display:flex;align-items:center;justify-content:center;gap:5px;padding:8px;border:1px solid #d5cec5;border-radius:8px;background:#fff;color:#756858;font-size:.7rem;font-weight:700;cursor:pointer}.hero-mode button.active{background:#18120a;color:#fff;border-color:#18120a}.hero-mode .material-symbols-outlined{font-size:16px}
.hero-add-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}.hero-add-grid button{display:flex;align-items:center;justify-content:center;gap:5px;padding:8px;border:1px solid #d8cec0;border-radius:8px;background:#fff;color:#514537;font-size:.69rem;font-weight:700;cursor:pointer}.hero-add-grid button:hover{border-color:#E8A020}.hero-add-grid button:disabled{opacity:.48;cursor:not-allowed}.hero-add-grid .material-symbols-outlined{font-size:16px}
.hero-schedule-action{display:flex;align-items:center;gap:8px;margin-top:9px}.hero-schedule-action button{display:inline-flex;align-items:center;gap:6px;padding:8px 11px;border:1px solid #d8cec0;border-radius:8px;background:#fff;color:#514537;font-size:.68rem;font-weight:800;cursor:pointer}.hero-schedule-action button:disabled{opacity:.5;cursor:not-allowed}.hero-schedule-action .material-symbols-outlined{font-size:17px}
.hero-layer-list{display:flex;flex-direction:column;gap:6px;margin-top:10px}.hero-layer-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;padding:8px;border:1px solid #ddd5ca;border-radius:9px;background:#fff;cursor:pointer}.hero-layer-row.active{border-color:#E8A020;background:#fff9ed}.hero-layer-row .material-symbols-outlined{font-size:18px;color:#8c7b68}.hero-layer-row strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.72rem}.hero-layer-row small{display:block;color:#938677;font-size:.6rem;text-transform:capitalize}.hero-layer-actions{display:flex;gap:2px}.hero-layer-actions button{display:grid;place-items:center;width:25px;height:25px;border:0;border-radius:5px;background:transparent;color:#756858;cursor:pointer}.hero-layer-actions button:hover{background:#eee7dc}.hero-layer-actions button:disabled{opacity:.3;cursor:not-allowed}.hero-layer-actions .material-symbols-outlined{font-size:16px}
.hero-editor-empty{padding:18px;border:1px dashed #d5cec5;border-radius:10px;color:#887b6d;text-align:center;font-size:.7rem;line-height:1.5}.hero-editor-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.hero-editor-grid .ds-row{margin:0}.hero-editor-grid .span-2{grid-column:1/-1}.hero-editor-grid input[type=text],.hero-editor-grid input[type=number],.hero-editor-grid textarea,.hero-editor-grid select{width:100%;padding:7px 8px;border:1px solid #d5cec5;border-radius:8px;background:#fff;color:#3d3328;font:inherit;font-size:.72rem}.hero-editor-grid textarea{min-height:72px;resize:vertical}.hero-editor-grid input[type=color]{width:100%;height:34px;border:1px solid #d5cec5;border-radius:8px;background:#fff}.hero-check{display:flex;align-items:center;gap:6px;color:#514537;font-size:.69rem;font-weight:700}.hero-help{margin:7px 0 0;color:#8b7e70;font-size:.65rem;line-height:1.45}
.hero-validation{margin:10px 0 0;padding:9px 10px;border-radius:8px;background:#f3f0eb;color:#675b4e;font-size:.67rem;line-height:1.45}.hero-validation ul{margin:5px 0 0;padding-left:18px}.hero-validation.error{background:#fff0f0;color:#991b1b}.hero-validation.good{background:#edf8f1;color:#1f6339}
.hero-action-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:10px}.hero-action-grid button{padding:9px 7px;border:1px solid #18120a;border-radius:8px;background:#fff;color:#18120a;font-size:.7rem;font-weight:800;cursor:pointer}.hero-action-grid .primary{background:#E8A020;border-color:#E8A020}.hero-action-grid .danger{grid-column:1/-1;border-color:#e2a7a7;color:#a11f1f}.hero-action-grid button:disabled{opacity:.45;cursor:not-allowed}.hero-action-note{margin:7px 0 0;color:#8b7e70;font-size:.64rem;line-height:1.45;text-align:center}
.hero-upload-progress{margin-top:7px;color:#805000;font-size:.67rem;font-weight:700}
</style>
<div class="ds-panel" id="dsPanel">
    <div class="ds-head">
        <h2>Design — {{ menu.name }}</h2>
        <button type="button" class="ds-save-btn" id="ds_saveBtn" aria-live="polite">Save</button>
        <button type="button" class="ds-close-btn" id="ds_closeBtn" title="Close" aria-label="Close design studio"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
    </div>
    <div class="ds-mobile-bar" role="tablist" aria-label="Design studio view">
        <button type="button" class="ds-mobile-btn active" data-ds-mobile-view="controls"><span class="material-symbols-outlined" aria-hidden="true">tune</span> Controls</button>
        <button type="button" class="ds-mobile-btn" data-ds-mobile-view="preview"><span class="material-symbols-outlined" aria-hidden="true">smartphone</span> Preview</button>
    </div>
    <div class="ds-body">
        {# iframe preview #}
        <div class="ds-preview-wrap">
            <div class="ds-preview-toolbar" aria-label="Preview size">
                <button type="button" class="ds-device-btn active" data-ds-width="100%"><span class="material-symbols-outlined" aria-hidden="true">desktop_windows</span> Desktop</button>
                <button type="button" class="ds-device-btn" data-ds-width="768px"><span class="material-symbols-outlined" aria-hidden="true">tablet</span> Tablet</button>
                <button type="button" class="ds-device-btn" data-ds-width="390px"><span class="material-symbols-outlined" aria-hidden="true">smartphone</span> Phone</button>
            </div>
            <div class="ds-preview-stage">
                <iframe id="dsPreview"
                        data-src="{{ url('app_public_menu_view', {slug: menu.business.slug, menuSlug: menu.slug}) }}?preview=1"
                        src="about:blank"
                        title="Menu preview"></iframe>
            </div>
        </div>
        {# Controls #}
        <div class="ds-controls">
            <div class="ds-mobile-note">Quick styling works on phones. Rotate the device for more room, or use a larger screen when you want controls and preview visible together.</div>
            <div class="ds-inspector-top">
                <div class="ds-inspector-head">
                    <div><span class="ds-inspector-kicker">Live editor</span><strong>Customize your menu</strong></div>
                    <span class="ds-dirty-state" id="ds_dirtyState" aria-live="polite">Saved</span>
                </div>
                <nav class="ds-tabs" role="tablist" aria-label="Design controls">
                    <button type="button" class="ds-tab active" data-ds-tab="presets" role="tab" aria-selected="true"><span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>Presets</button>
                    <button type="button" class="ds-tab" data-ds-tab="canvas" role="tab" aria-selected="false"><span class="material-symbols-outlined" aria-hidden="true">wallpaper</span>Canvas</button>
                    <button type="button" class="ds-tab" data-ds-tab="brand" role="tab" aria-selected="false"><span class="material-symbols-outlined" aria-hidden="true">palette</span>Brand</button>
                    <button type="button" class="ds-tab" data-ds-tab="components" role="tab" aria-selected="false"><span class="material-symbols-outlined" aria-hidden="true">view_agenda</span>Cards</button>
                    <button type="button" class="ds-tab" data-ds-tab="hero" role="tab" aria-selected="false"><span class="material-symbols-outlined" aria-hidden="true">campaign</span>Hero</button>
                </nav>
                <div class="ds-preview-feedback" id="ds_previewFeedback" role="status" aria-live="polite"><span class="material-symbols-outlined" aria-hidden="true">visibility</span><span>Live preview ready</span></div>
            </div>
            <form id="ds_form" action="{{ path('app_owner_menu_theme', {id: menu.id}) }}" method="post" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('theme-' ~ menu.id) }}">

                <div class="ds-section active" data-ds-panel="presets">
                    <p class="ds-section-title">Quick presets</p>
                    <p class="ds-section-copy">Start with a complete look, then refine every detail.</p>
                    <div class="ds-presets">
                        <button type="button" data-theme-preset="classic"><span style="--preset-a:#18120a;--preset-b:#E8A020"></span><strong>Classic</strong><small>Clean, warm and familiar</small></button>
                        <button type="button" data-theme-preset="cafe"><span style="--preset-a:#3f2618;--preset-b:#d9a05b"></span><strong>Café</strong><small>Editorial cards and rich tones</small></button>
                        <button type="button" data-theme-preset="night"><span style="--preset-a:#111827;--preset-b:#60a5fa"></span><strong>Night</strong><small>Modern dark presentation</small></button>
                        <button type="button" data-theme-preset="minimal"><span style="--preset-a:#f8fafc;--preset-b:#334155"></span><strong>Minimal</strong><small>Quiet typography and clean space</small></button>
                        <button type="button" data-theme-preset="bistro"><span style="--preset-a:#4c1d1d;--preset-b:#fbbf24"></span><strong>Bistro</strong><small>Confident red and golden details</small></button>
                        <button type="button" data-theme-preset="fresh"><span style="--preset-a:#14532d;--preset-b:#86efac"></span><strong>Fresh</strong><small>Natural colors for healthy menus</small></button>
                        <button type="button" data-theme-preset="luxe"><span style="--preset-a:#171717;--preset-b:#d4af37"></span><strong>Luxe</strong><small>Dark premium dining presentation</small></button>
                        <button type="button" data-theme-preset="sunset"><span style="--preset-a:#7c2d12;--preset-b:#fb923c"></span><strong>Sunset</strong><small>Warm energy and bold highlights</small></button>
                    </div>
                    <button type="button" class="ds-reset-btn" id="ds_resetTheme"><span class="material-symbols-outlined" aria-hidden="true">restart_alt</span> Reset to default</button>
                </div>

                {# Appearance #}
                <div class="ds-section" data-ds-panel="canvas">
                    <p class="ds-section-title">Appearance</p>
                    <p class="ds-section-copy">Control the visual rhythm and readability of the whole menu.</p>
                    <div class="ds-row">
                        <label class="ds-label">Theme</label>
                        <div class="ds-seg">
                            <input type="radio" id="th_light" name="theme" value="light" {% if tc.theme == 'light' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="th_light">Light</label>
                            <input type="radio" id="th_dark" name="theme" value="dark" {% if tc.theme == 'dark' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="th_dark">Dark</label>
                        </div>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label" for="ds_font">Font</label>
                        <select class="ds-select" id="ds_font" name="font">
                            <optgroup label="Built-in fonts">
                                {% for f in builtInFonts %}<option value="{{ f }}" {% if tc.font == f %}selected{% endif %}>{{ f }}</option>{% endfor %}
                            </optgroup>
                            {% if customFonts is not empty %}
                                <optgroup label="Custom fonts">
                                    {% for f in customFonts %}<option value="{{ f.family }}" {% if tc.font == f.family %}selected{% endif %}>{{ f.family }}</option>{% endfor %}
                                </optgroup>
                            {% endif %}
                        </select>
                        <small class="ds-field-help">Add licensed TTF, OTF, WOFF, or WOFF2 files to <code>public/fontes_desgne_tool</code>, then reload.</small>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label" for="ds_fontScale">Type scale — <span id="ds_fontScaleVal">{{ (tc.fontScale * 100)|round }}</span>%</label>
                        <div class="ds-slider-row"><input type="range" class="ds-slider" id="ds_fontScale" name="fontScale" min="0.85" max="1.2" step="0.05" value="{{ tc.fontScale }}"></div>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label">Layout</label>
                        <div class="ds-seg">
                            <input type="radio" id="layout_list" name="layout" value="list" {% if (tc.layout ?? 'list') == 'list' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="layout_list" title="Single column with image + text">≡ List</label>
                            <input type="radio" id="layout_grid" name="layout" value="grid" {% if (tc.layout ?? 'list') == 'grid' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="layout_grid" title="2-column card grid">⊞ Grid</label>
                            <input type="radio" id="layout_compact" name="layout" value="compact" {% if (tc.layout ?? 'list') == 'compact' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="layout_compact" title="Dense list, no images">≣ Compact</label>
                        </div>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label">Spacing</label>
                        <div class="ds-seg">
                            <input type="radio" id="density_compact" name="density" value="compact" {% if tc.density == 'compact' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="density_compact">Compact</label>
                            <input type="radio" id="density_comfortable" name="density" value="comfortable" {% if tc.density == 'comfortable' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="density_comfortable">Balanced</label>
                            <input type="radio" id="density_spacious" name="density" value="spacious" {% if tc.density == 'spacious' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="density_spacious">Airy</label>
                        </div>
                    </div>
                </div>

                {# Background #}
                <div class="ds-section" data-ds-panel="canvas">
                    <p class="ds-section-title">Background</p>
                    <p class="ds-section-copy">Use a solid tone, gradient, or a lightweight menu backdrop.</p>
                    <div class="ds-row">
                        <label class="ds-label">Type</label>
                        <div class="ds-seg">
                            <input type="radio" id="bg_solid" name="bgType" value="solid" {% if tc.bgType == 'solid' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="bg_solid">Solid</label>
                            <input type="radio" id="bg_gradient" name="bgType" value="gradient" {% if tc.bgType == 'gradient' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="bg_gradient">Gradient</label>
                            <input type="radio" id="bg_image" name="bgType" value="image" {% if tc.bgType == 'image' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="bg_image">Image</label>
                        </div>
                    </div>
                    <div id="ds_bgSolid">
                        <div class="ds-row">
                            <label class="ds-label">Color</label>
                            <div class="ds-color-row">
                                <input type="color" class="ds-color-input" id="ds_bgColor" name="bgColor" value="{{ tc.bgColor }}">
                                <input type="text" class="ds-color-text" id="ds_bgColorTxt" value="{{ tc.bgColor }}" maxlength="7">
                            </div>
                        </div>
                    </div>
                    <div id="ds_bgGradient">
                        <div class="ds-row">
                            <label class="ds-label">Color 1</label>
                            <div class="ds-color-row">
                                <input type="color" class="ds-color-input" id="ds_bgGS" name="bgGradientStart" value="{{ tc.bgGradientStart }}">
                                <input type="text" class="ds-color-text" id="ds_bgGSTxt" value="{{ tc.bgGradientStart }}" maxlength="7">
                            </div>
                        </div>
                        <div class="ds-row">
                            <label class="ds-label">Color 2</label>
                            <div class="ds-color-row">
                                <input type="color" class="ds-color-input" id="ds_bgGE" name="bgGradientEnd" value="{{ tc.bgGradientEnd }}">
                                <input type="text" class="ds-color-text" id="ds_bgGETxt" value="{{ tc.bgGradientEnd }}" maxlength="7">
                            </div>
                        </div>
                        <div class="ds-row">
                            <label class="ds-label" for="ds_bgGDir">Direction</label>
                            <select class="ds-select" id="ds_bgGDir" name="bgGradientDir">
                                <option value="to bottom" {% if tc.bgGradientDir == 'to bottom' %}selected{% endif %}>Top → Bottom</option>
                                <option value="to right" {% if tc.bgGradientDir == 'to right' %}selected{% endif %}>Left → Right</option>
                                <option value="135deg" {% if tc.bgGradientDir == '135deg' %}selected{% endif %}>Diagonal ↘</option>
                                <option value="45deg" {% if tc.bgGradientDir == '45deg' %}selected{% endif %}>Diagonal ↗</option>
                            </select>
                        </div>
                    </div>
                    <div id="ds_bgImage">
                        <div class="ds-row">
                            <label class="ds-label">Image</label>
                            {% if tc.bgImagePath %}
                                <img id="ds_bgImgPrev" class="ds-img-preview" src="{{ asset(tc.bgImagePath) }}" style="display:block">
                            {% else %}
                                <img id="ds_bgImgPrev" class="ds-img-preview" src="" alt="">
                            {% endif %}
                            <label class="ds-file-label" for="ds_bgImgInput">Choose background image</label>
                            <input type="file" class="ds-file-input" id="ds_bgImgInput" name="bgImage" accept="image/jpeg,image/png,image/webp">
                        </div>
                    </div>
                </div>

                {# Header #}
                <div class="ds-section" data-ds-panel="brand">
                    <p class="ds-section-title">Header</p>
                    <p class="ds-section-copy">Give the restaurant identity a clear, consistent position.</p>
                    <div class="ds-row">
                        <label class="ds-label">Background color</label>
                        <div class="ds-color-row">
                            <input type="color" class="ds-color-input" id="ds_headerBg" name="headerBg" value="{{ tc.headerBg }}">
                            <input type="text" class="ds-color-text" id="ds_headerBgTxt" value="{{ tc.headerBg }}" maxlength="7">
                        </div>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label">Logo position</label>
                        <div class="ds-seg">
                            <input type="radio" id="logo_l" name="logoAlign" value="flex-start" {% if tc.logoAlign == 'flex-start' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="logo_l">Left</label>
                            <input type="radio" id="logo_c" name="logoAlign" value="center" {% if tc.logoAlign == 'center' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="logo_c">Center</label>
                            <input type="radio" id="logo_r" name="logoAlign" value="flex-end" {% if tc.logoAlign == 'flex-end' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="logo_r">Right</label>
                        </div>
                    </div>
                </div>

                {# Colors #}
                <div class="ds-section" data-ds-panel="brand">
                    <p class="ds-section-title">Colors</p>
                    <p class="ds-section-copy">Your accent connects navigation, pricing, and highlights.</p>
                    <div class="ds-row">
                        <label class="ds-label">Accent (prices · active pills)</label>
                        <div class="ds-color-row">
                            <input type="color" class="ds-color-input" id="ds_accent" name="accent" value="{{ tc.accent }}">
                            <input type="text" class="ds-color-text" id="ds_accentTxt" value="{{ tc.accent }}" maxlength="7">
                        </div>
                    </div>
                    <div class="ds-contrast" id="ds_contrast" role="status"></div>
                </div>

                {# Cards #}
                <div class="ds-section" data-ds-panel="components">
                    <p class="ds-section-title">Item Cards</p>
                    <p class="ds-section-copy">Shape how dishes, photos, and prices are presented.</p>
                    <div class="ds-row">
                        <label class="ds-label">Style</label>
                        <div class="ds-seg">
                            <input type="radio" id="card_flat" name="cardStyle" value="flat" {% if tc.cardStyle == 'flat' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="card_flat">Flat</label>
                            <input type="radio" id="card_glass" name="cardStyle" value="glass" {% if tc.cardStyle == 'glass' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="card_glass">Glass</label>
                            <input type="radio" id="card_bordered" name="cardStyle" value="bordered" {% if tc.cardStyle == 'bordered' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="card_bordered">Bordered</label>
                        </div>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label">Card color</label>
                        <div class="ds-color-row">
                            <input type="color" class="ds-color-input" id="ds_cardBg" name="cardBg" value="{{ tc.cardBg }}">
                            <input type="text" class="ds-color-text" id="ds_cardBgTxt" value="{{ tc.cardBg }}" maxlength="7">
                        </div>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label" for="ds_cardRadius">Corner radius — <span id="ds_cardRadiusVal">{{ tc.cardRadius }}</span>px</label>
                        <div class="ds-slider-row"><input type="range" class="ds-slider" id="ds_cardRadius" name="cardRadius" min="0" max="24" step="2" value="{{ tc.cardRadius }}"></div>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label">Image shape</label>
                        <div class="ds-seg">
                            <input type="radio" id="image_square" name="imageShape" value="square" {% if tc.imageShape == 'square' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="image_square">Square</label>
                            <input type="radio" id="image_rounded" name="imageShape" value="rounded" {% if tc.imageShape == 'rounded' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="image_rounded">Rounded</label>
                            <input type="radio" id="image_circle" name="imageShape" value="circle" {% if tc.imageShape == 'circle' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="image_circle">Circle</label>
                        </div>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label">Price treatment</label>
                        <div class="ds-seg ds-seg--four">
                            <input type="radio" id="price_accent" name="priceStyle" value="accent" {% if tc.priceStyle == 'accent' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="price_accent">Color</label>
                            <input type="radio" id="price_neutral" name="priceStyle" value="neutral" {% if tc.priceStyle == 'neutral' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="price_neutral">Plain</label>
                            <input type="radio" id="price_outline" name="priceStyle" value="outline" {% if tc.priceStyle == 'outline' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="price_outline">Outline</label>
                            <input type="radio" id="price_badge" name="priceStyle" value="badge" {% if tc.priceStyle == 'badge' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="price_badge">Filled</label>
                        </div>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label">Price position</label>
                        <div class="ds-seg">
                            <input type="radio" id="price_align_left" name="priceAlign" value="left" {% if tc.priceAlign == 'left' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="price_align_left">Left</label>
                            <input type="radio" id="price_align_center" name="priceAlign" value="center" {% if tc.priceAlign == 'center' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="price_align_center">Center</label>
                            <input type="radio" id="price_align_right" name="priceAlign" value="right" {% if tc.priceAlign == 'right' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="price_align_right">Right</label>
                        </div>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label" for="ds_priceFont">Price font</label>
                        <select class="ds-select" id="ds_priceFont" name="priceFont">
                            <optgroup label="Built-in fonts">
                                {% for f in builtInFonts %}<option value="{{ f }}" {% if tc.priceFont == f %}selected{% endif %}>{{ f }}</option>{% endfor %}
                            </optgroup>
                            {% if customFonts is not empty %}
                                <optgroup label="Custom fonts">
                                    {% for f in customFonts %}<option value="{{ f.family }}" {% if tc.priceFont == f.family %}selected{% endif %}>{{ f.family }}</option>{% endfor %}
                                </optgroup>
                            {% endif %}
                        </select>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label" for="ds_priceSize">Price size — <span id="ds_priceSizeVal">{{ (tc.priceSize * 16)|round }}</span>px</label>
                        <div class="ds-slider-row"><input type="range" class="ds-slider" id="ds_priceSize" name="priceSize" min="0.65" max="1.4" step="0.05" value="{{ tc.priceSize }}"></div>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label">Price weight</label>
                        <div class="ds-seg">
                            <input type="radio" id="price_weight_500" name="priceWeight" value="500" {% if tc.priceWeight == '500' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="price_weight_500">Medium</label>
                            <input type="radio" id="price_weight_700" name="priceWeight" value="700" {% if tc.priceWeight == '700' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="price_weight_700">Bold</label>
                            <input type="radio" id="price_weight_800" name="priceWeight" value="800" {% if tc.priceWeight == '800' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="price_weight_800">Heavy</label>
                        </div>
                    </div>
                    <div class="ds-row">
                        <label class="ds-label">Price color</label>
                        <div class="ds-color-row">
                            <input type="color" class="ds-color-input" id="ds_priceColor" name="priceColor" value="{{ tc.priceColor }}">
                            <input type="text" class="ds-color-text" id="ds_priceColorTxt" value="{{ tc.priceColor }}" maxlength="7">
                        </div>
                    </div>
                    <div id="ds_priceBoxControls">
                        <div class="ds-row">
                            <label class="ds-label">Box color</label>
                            <div class="ds-color-row">
                                <input type="color" class="ds-color-input" id="ds_priceBoxColor" name="priceBoxColor" value="{{ tc.priceBoxColor }}">
                                <input type="text" class="ds-color-text" id="ds_priceBoxColorTxt" value="{{ tc.priceBoxColor }}" maxlength="7">
                            </div>
                        </div>
                        <div class="ds-row">
                            <label class="ds-label" for="ds_priceRadius">Box corners — <span id="ds_priceRadiusVal">{{ tc.priceRadius }}</span>px</label>
                            <div class="ds-slider-row"><input type="range" class="ds-slider" id="ds_priceRadius" name="priceRadius" min="0" max="20" step="2" value="{{ tc.priceRadius }}"></div>
                        </div>
                    </div>
                    <div id="ds_glassCtrl">
                        <div class="ds-row">
                            <label class="ds-label">Blur — <span id="ds_blurVal">{{ tc.glassBlur }}</span>px</label>
                            <div class="ds-slider-row">
                                <input type="range" class="ds-slider" id="ds_blur" name="glassBlur" min="2" max="30" step="1" value="{{ tc.glassBlur }}">
                            </div>
                        </div>
                        <div class="ds-row">
                            <label class="ds-label">Opacity — <span id="ds_opacVal">{{ tc.glassOpacity }}</span></label>
                            <div class="ds-slider-row">
                                <input type="range" class="ds-slider" id="ds_opac" name="glassOpacity" min="0.05" max="0.6" step="0.01" value="{{ tc.glassOpacity }}">
                            </div>
                        </div>
                    </div>
                </div>

                {# Pills #}
                <div class="ds-section" data-ds-panel="components">
                    <p class="ds-section-title">Category Pills</p>
                    <p class="ds-section-copy">Choose how guests move between menu sections.</p>
                    <div class="ds-row">
                        <label class="ds-label">Style</label>
                        <div class="ds-seg">
                            <input type="radio" id="pill_pill" name="pillStyle" value="pill" {% if tc.pillStyle == 'pill' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="pill_pill">Pill</label>
                            <input type="radio" id="pill_ul" name="pillStyle" value="underline" {% if tc.pillStyle == 'underline' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="pill_ul">Underline</label>
                            <input type="radio" id="pill_chip" name="pillStyle" value="chip" {% if tc.pillStyle == 'chip' %}checked{% endif %}>
                            <label class="ds-seg-btn" for="pill_chip">Chip</label>
                        </div>
                    </div>
                </div>
            </form>

            <section class="ds-section hero-section" data-ds-panel="hero" id="heroEditorSection">
                <p class="ds-section-title">Promotional hero</p>
                <p class="ds-section-copy">Build a responsive offer above the menu. Draft changes stay private until you publish them.</p>
                <div class="hero-panel-status{{ heroPublished ? '' : ' warning' }}" id="heroStatus" role="status" aria-live="polite">
                    <span class="material-symbols-outlined" aria-hidden="true">{{ heroPublished ? 'check_circle' : 'info' }}</span>
                    <div><strong>{{ heroPublished ? 'A published hero exists' : 'Draft only' }}</strong><span>{{ heroPublishedAt ? 'Last published ' ~ heroPublishedAt|date('F j, Y \a\t H:i') : 'Customers cannot see a hero until you publish one.' }}</span></div>
                </div>

                <div class="hero-switch">
                    <div><strong>Show hero</strong><small>Required before publishing. Turning this off does not hide an already published version until you press Hide.</small></div>
                    <input type="checkbox" id="hero_enabled" {{ heroConfig.enabled ? 'checked' : '' }} aria-label="Show hero when published">
                </div>

                <div class="ds-row" style="margin-top:14px">
                    <label class="ds-label">Schedule</label>
                    <div class="hero-schedule-grid">
                        <div><span class="ds-field-help">Starts (optional)</span><input type="datetime-local" id="hero_startsAt"></div>
                        <div><span class="ds-field-help">Expires (optional)</span><input type="datetime-local" id="hero_expiresAt"></div>
                    </div>
                    <p class="hero-help">No expiration means the hero stays visible until you hide it. A countdown requires a future expiration.</p>
                    <div class="hero-schedule-action"><button type="button" id="heroScheduleCountdown"><span class="material-symbols-outlined" aria-hidden="true">timer</span><span>Add countdown layer</span></button></div>
                    <p class="hero-help" id="heroScheduleCountdownHelp">Set a future expiration time to enable a visible countdown.</p>
                </div>

                <div class="ds-row">
                    <label class="ds-label">Editing layout</label>
                    <div class="hero-mode">
                        <button type="button" class="active" data-hero-mode="desktop"><span class="material-symbols-outlined" aria-hidden="true">desktop_windows</span>Desktop</button>
                        <button type="button" data-hero-mode="mobile"><span class="material-symbols-outlined" aria-hidden="true">smartphone</span>Mobile</button>
                    </div>
                    <p class="hero-help">Mobile positions are independent. Configure both layouts before publishing.</p>
                </div>

                <div class="ds-row">
                    <label class="ds-label">Canvas height</label>
                    <div class="hero-editor-grid">
                        <div class="ds-row"><label class="ds-field-help" for="hero_desktopHeight">Desktop px</label><input type="number" id="hero_desktopHeight" min="240" max="600" value="{{ heroConfig.desktopHeight }}"></div>
                        <div class="ds-row"><label class="ds-field-help" for="hero_mobileHeight">Mobile px</label><input type="number" id="hero_mobileHeight" min="220" max="520" value="{{ heroConfig.mobileHeight }}"></div>
                    </div>
                </div>

                <div class="ds-row">
                    <label class="ds-label">Add layer <span id="heroLayerCount">{{ heroConfig.layers|length }}/20</span></label>
                    <div class="hero-add-grid">
                        <button type="button" data-hero-add="text"><span class="material-symbols-outlined" aria-hidden="true">title</span>Text</button>
                        <button type="button" data-hero-add="shape"><span class="material-symbols-outlined" aria-hidden="true">shapes</span>Shape</button>
                        <button type="button" data-hero-add="image"><span class="material-symbols-outlined" aria-hidden="true">image</span>Image</button>
                    </div>
                    <input type="file" id="heroImageInput" accept="image/jpeg,image/png,image/webp" hidden>
                    <div class="hero-upload-progress" id="heroUploadProgress" hidden></div>
                    <p class="hero-help" id="heroAddHelp">Maximum 20 layers including the locked background. Only one countdown is allowed.</p>
                </div>

                <div class="ds-row">
                    <label class="ds-label">Layers</label>
                    <div class="hero-layer-list" id="heroLayerList"></div>
                </div>

                <div class="ds-row">
                    <label class="ds-label">Selected layer</label>
                    <div id="heroLayerEditor" class="hero-editor-empty">Select a layer to edit it. Drag unlocked layers directly in the preview to position them.</div>
                </div>

                <div class="hero-validation" id="heroValidation" role="status">Your draft has not been checked yet.</div>
                <div class="hero-action-grid">
                    <button type="button" id="heroSaveDraft">Save draft</button>
                    <button type="button" class="primary" id="heroPublish">Publish hero</button>
                    <button type="button" class="danger" id="heroHide" {{ heroPublished ? '' : 'disabled' }}>Hide published hero</button>
                </div>
                <p class="hero-action-note" id="heroActionNote">{{ heroPublished ? 'Hide removes the public hero immediately but keeps this draft.' : 'Hide is unavailable because no hero has been published yet.' }}</p>
            </section>
            <script type="application/json" id="heroConfigData">{{ heroConfigJson|raw }}</script>
            <div hidden id="heroEndpoints"
                 data-draft="{{ path('app_owner_menu_hero_draft', {id: menu.id}) }}"
                 data-publish="{{ path('app_owner_menu_hero_publish', {id: menu.id}) }}"
                 data-hide="{{ path('app_owner_menu_hero_hide', {id: menu.id}) }}"
                 data-image="{{ path('app_owner_menu_hero_image', {id: menu.id}) }}"
                 data-token="{{ csrf_token('hero-' ~ menu.id) }}"></div>
        </div>{# /.ds-controls #}
    </div>{# /.ds-body #}
</div>{# /.ds-panel #}

<script>
(function () {
    var panel   = document.getElementById('dsPanel');
    var iframe  = document.getElementById('dsPreview');
    var form    = document.getElementById('ds_form');
    var saveBtn = document.getElementById('ds_saveBtn');
    var pdoc    = null; // iframe contentDocument
    var dirty   = false;
    var pageScrollY = 0;

    /* ── helpers ────────────────────────────────────────── */
    function g(id) { return document.getElementById(id); }
    function markDirty() {
        dirty = true;
        g('ds_dirtyState').textContent = 'Unsaved';
        g('ds_dirtyState').className = 'ds-dirty-state unsaved';
        if (!saveBtn.disabled) saveBtn.textContent = 'Save changes';
    }
    function showControlFeedback(target) {
        var feedback = g('ds_previewFeedback');
        var row = target.closest ? target.closest('.ds-row') : null;
        var label = row ? row.querySelector('.ds-label') : null;
        var name = label ? label.textContent.split('—')[0].trim() : 'Design';
        var value = target.value || '';
        if (target.matches && target.matches('input[type="radio"]')) {
            var optionLabel = form.querySelector('label[for="' + target.id + '"]');
            if (optionLabel) value = optionLabel.textContent.trim();
        } else if (target.tagName === 'SELECT' && target.selectedOptions.length) {
            value = target.selectedOptions[0].textContent.trim();
        }
        feedback.querySelector('span:last-child').textContent = 'Preview updated · ' + name + (value ? ': ' + value : '');
        feedback.classList.remove('pulse');
        void feedback.offsetWidth;
        feedback.classList.add('pulse');
        window.setTimeout(function () { feedback.classList.remove('pulse'); }, 500);
    }
    function radVal(name) {
        var els = document.querySelectorAll('[name="' + name + '"]');
        for (var i = 0; i < els.length; i++) { if (els[i].checked) return els[i].value; }
        return '';
    }
    function getBg() {
        var t = radVal('bgType');
        if (t === 'gradient') return 'linear-gradient(' + g('ds_bgGDir').value + ',' + g('ds_bgGS').value + ',' + g('ds_bgGE').value + ')';
        if (t === 'image') return pdoc ? getComputedStyle(pdoc.documentElement).getPropertyValue('--pub-bg').trim() : '';
        return g('ds_bgColor').value;
    }

    function contrastRatio(first, second) {
        function luminance(hex) {
            var channels = [1, 3, 5].map(function (index) {
                var value = parseInt(hex.slice(index, index + 2), 16) / 255;
                return value <= .03928 ? value / 12.92 : Math.pow((value + .055) / 1.055, 2.4);
            });
            return .2126 * channels[0] + .7152 * channels[1] + .0722 * channels[2];
        }
        var light = Math.max(luminance(first), luminance(second));
        var dark = Math.min(luminance(first), luminance(second));
        return (light + .05) / (dark + .05);
    }

    function refreshContrast() {
        var ratio = contrastRatio(g('ds_headerBg').value, g('ds_accent').value);
        var output = g('ds_contrast');
        var good = ratio >= 3;
        output.classList.toggle('warning', !good);
        output.textContent = good
            ? 'Good accent contrast (' + ratio.toFixed(1) + ':1).'
            : 'Low accent contrast (' + ratio.toFixed(1) + ':1). Some labels may be hard to read.';
    }

    function setRadio(name, value) {
        var input = form.querySelector('[name="' + name + '"][value="' + value + '"]');
        if (input) input.checked = true;
    }

    function applyPreset(values) {
        setRadio('theme', values.theme);
        setRadio('layout', values.layout);
        setRadio('density', values.density);
        setRadio('bgType', 'solid');
        setRadio('cardStyle', values.cardStyle);
        setRadio('pillStyle', values.pillStyle);
        setRadio('imageShape', values.imageShape);
        setRadio('priceStyle', values.priceStyle);
        setRadio('priceAlign', values.priceAlign || 'left');
        setRadio('priceWeight', values.priceWeight || '700');
        g('ds_font').value = values.font;
        g('ds_priceFont').value = values.priceFont || 'Space Grotesk';
        g('ds_fontScale').value = values.fontScale;
        g('ds_fontScaleVal').textContent = Math.round(values.fontScale * 100);
        g('ds_cardRadius').value = values.cardRadius;
        g('ds_cardRadiusVal').textContent = values.cardRadius;
        g('ds_priceSize').value = values.priceSize || .9;
        g('ds_priceSizeVal').textContent = Math.round((values.priceSize || .9) * 16);
        g('ds_priceRadius').value = values.priceRadius || 8;
        g('ds_priceRadiusVal').textContent = values.priceRadius || 8;
        g('ds_bgColor').value = values.bg;
        g('ds_headerBg').value = values.header;
        g('ds_accent').value = values.accent;
        g('ds_cardBg').value = values.card;
        g('ds_priceColor').value = values.priceColor || values.accent;
        g('ds_priceBoxColor').value = values.priceBoxColor || values.accent;
        [['ds_bgColorTxt', values.bg], ['ds_headerBgTxt', values.header], ['ds_accentTxt', values.accent], ['ds_cardBgTxt', values.card], ['ds_priceColorTxt', values.priceColor || values.accent], ['ds_priceBoxColorTxt', values.priceBoxColor || values.accent]].forEach(function (entry) {
            g(entry[0]).value = entry[1];
        });
        markDirty();
        push();
    }

    /* ── sub-control visibility (runs without iframe) ───── */
    function refreshVisibility() {
        var bt = radVal('bgType');
        var cs = radVal('cardStyle');
        var ps = radVal('priceStyle');
        g('ds_bgSolid').style.display    = bt === 'solid'    ? 'block' : 'none';
        g('ds_bgGradient').style.display = bt === 'gradient' ? 'block' : 'none';
        g('ds_bgImage').style.display    = bt === 'image'    ? 'block' : 'none';
        g('ds_glassCtrl').style.display  = cs === 'glass'    ? 'block' : 'none';
        g('ds_priceBoxControls').style.display = ps === 'outline' || ps === 'badge' ? 'block' : 'none';
    }

    /* ── push all vars to iframe ─────────────────────────── */
    function push() {
        refreshVisibility();
        refreshContrast();
        if (!pdoc) return;
        var root = pdoc.documentElement;
        var body = pdoc.body;
        if (!body) return;
        var theme     = radVal('theme');
        var cardStyle = radVal('cardStyle');

        root.style.setProperty('--pub-font',    "'" + g('ds_font').value + "', sans-serif");
        root.style.fontSize = (parseFloat(g('ds_fontScale').value) * 16) + 'px';
        root.style.setProperty('--pub-bg',       getBg());
        root.style.setProperty('--pub-header-bg', g('ds_headerBg').value);
        root.style.setProperty('--pub-accent',   g('ds_accent').value);
        root.style.setProperty('--pub-card-bg',  g('ds_cardBg').value);
        root.style.setProperty('--pub-card-radius', g('ds_cardRadius').value + 'px');
        root.style.setProperty('--pub-price-font', "'" + g('ds_priceFont').value + "', sans-serif");
        root.style.setProperty('--pub-price-size', g('ds_priceSize').value + 'rem');
        root.style.setProperty('--pub-price-weight', radVal('priceWeight'));
        root.style.setProperty('--pub-price-color', g('ds_priceColor').value);
        root.style.setProperty('--pub-price-box', g('ds_priceBoxColor').value);
        root.style.setProperty('--pub-price-radius', g('ds_priceRadius').value + 'px');
        root.style.setProperty('--pub-glass-blur', g('ds_blur').value + 'px');
        root.style.setProperty('--pub-glass-opacity', g('ds_opac').value);
        root.style.setProperty('--pub-logo-align', radVal('logoAlign'));

        if (theme === 'dark') {
            root.style.setProperty('--pub-ink',        '#f5f0e8');
            root.style.setProperty('--pub-muted',      'rgba(245,240,232,.55)');
            root.style.setProperty('--pub-border',     'rgba(255,255,255,.12)');
            root.style.setProperty('--pub-cat-title',  'rgba(245,240,232,.45)');
            root.style.setProperty('--pub-cat-border', 'rgba(255,255,255,.08)');
            root.style.setProperty('--pub-sheet-bg',   '#1e1812');
            root.style.setProperty('--pub-sheet-ink',  '#f5f0e8');
        } else {
            root.style.setProperty('--pub-ink',        '#18120a');
            root.style.setProperty('--pub-muted',      '#7a6f60');
            root.style.setProperty('--pub-border',     '#ece7df');
            root.style.setProperty('--pub-cat-title',  '#7a6f60');
            root.style.setProperty('--pub-cat-border', '#e0d9ce');
            root.style.setProperty('--pub-sheet-bg',   '#fff');
            root.style.setProperty('--pub-sheet-ink',  '#18120a');
        }

        body.dataset.cardStyle = cardStyle;
        body.dataset.pillStyle = radVal('pillStyle');
        body.dataset.theme     = theme;
        body.dataset.layout    = radVal('layout');
        body.dataset.density   = radVal('density');
        body.dataset.imageShape = radVal('imageShape');
        body.dataset.priceStyle = radVal('priceStyle');
        body.dataset.priceAlign = radVal('priceAlign');
    }

    /* ── sync colour text inputs ─────────────────────────── */
    function syncText(colorId, textId) {
        var c = g(colorId), t = g(textId);
        if (!c || !t) return;
        c.addEventListener('input', function () { t.value = c.value; push(); });
        t.addEventListener('input', function () { if (/^#[0-9a-f]{6}$/i.test(t.value)) { c.value = t.value; push(); } });
    }
    syncText('ds_bgColor',   'ds_bgColorTxt');
    syncText('ds_bgGS',      'ds_bgGSTxt');
    syncText('ds_bgGE',      'ds_bgGETxt');
    syncText('ds_headerBg',  'ds_headerBgTxt');
    syncText('ds_accent',    'ds_accentTxt');
    syncText('ds_cardBg',    'ds_cardBgTxt');
    syncText('ds_priceColor', 'ds_priceColorTxt');
    syncText('ds_priceBoxColor', 'ds_priceBoxColorTxt');

    /* ── attach all other listeners ─────────────────────── */
    ['ds_font','ds_priceFont','ds_bgGDir'].forEach(function(id){ g(id).addEventListener('change', push); });
    ['ds_blur','ds_opac','ds_fontScale','ds_cardRadius','ds_priceSize','ds_priceRadius'].forEach(function(id){
        g(id).addEventListener('input', function() {
            if (id === 'ds_blur')  g('ds_blurVal').textContent = this.value;
            if (id === 'ds_opac')  g('ds_opacVal').textContent = parseFloat(this.value).toFixed(2);
            if (id === 'ds_fontScale') g('ds_fontScaleVal').textContent = Math.round(parseFloat(this.value) * 100);
            if (id === 'ds_cardRadius') g('ds_cardRadiusVal').textContent = this.value;
            if (id === 'ds_priceSize') g('ds_priceSizeVal').textContent = Math.round(parseFloat(this.value) * 16);
            if (id === 'ds_priceRadius') g('ds_priceRadiusVal').textContent = this.value;
            push();
        });
    });
    document.querySelectorAll('[name="theme"],[name="bgType"],[name="cardStyle"],[name="pillStyle"],[name="logoAlign"],[name="layout"],[name="density"],[name="imageShape"],[name="priceStyle"],[name="priceAlign"],[name="priceWeight"]').forEach(function(el) {
        el.addEventListener('change', function () {
            /* auto-swap bg+card colours on theme switch */
            if (el.name === 'theme') {
                if (el.value === 'dark')  { g('ds_bgColor').value = '#1a140e'; g('ds_cardBg').value = '#2a2218'; }
                else                       { g('ds_bgColor').value = '#f7f4ef'; g('ds_cardBg').value = '#ffffff'; }
                g('ds_bgColorTxt').value = g('ds_bgColor').value;
                g('ds_cardBgTxt').value  = g('ds_cardBg').value;
            }
            push();
        });
    });

    /* ── background image live preview ─────────────────── */
    g('ds_bgImgInput').addEventListener('change', function () {
        var file = this.files[0];
        if (!file) return;
        var url = URL.createObjectURL(file);
        g('ds_bgImgPrev').src = url;
        g('ds_bgImgPrev').style.display = 'block';
        if (pdoc) pdoc.documentElement.style.setProperty('--pub-bg', 'url(' + url + ') center/cover no-repeat fixed');
    });

    /* ── iframe load ────────────────────────────────────── */
    iframe.addEventListener('load', function () {
        try {
            pdoc = iframe.contentDocument || iframe.contentWindow.document;
            push();
            g('ds_previewFeedback').querySelector('span:last-child').textContent = 'Live preview connected';
        }
        catch (e) { pdoc = null; }
    });

    form.addEventListener('input', function (event) { markDirty(); showControlFeedback(event.target); });
    form.addEventListener('change', function (event) { markDirty(); showControlFeedback(event.target); });

    var presets = {
        classic: { theme: 'light', layout: 'list', density: 'comfortable', cardStyle: 'flat', pillStyle: 'pill', imageShape: 'rounded', priceStyle: 'accent', font: 'DM Sans', fontScale: 1, cardRadius: 12, bg: '#F7F4EF', header: '#18120A', accent: '#E8A020', card: '#FFFFFF' },
        cafe: { theme: 'light', layout: 'grid', density: 'spacious', cardStyle: 'bordered', pillStyle: 'chip', imageShape: 'rounded', priceStyle: 'badge', font: 'Playfair Display', fontScale: 1.05, cardRadius: 16, bg: '#F5EBDD', header: '#3F2618', accent: '#D9A05B', card: '#FFF9F0' },
        night: { theme: 'dark', layout: 'list', density: 'compact', cardStyle: 'glass', pillStyle: 'underline', imageShape: 'circle', priceStyle: 'accent', font: 'Space Grotesk', fontScale: .95, cardRadius: 18, bg: '#111827', header: '#0B1220', accent: '#60A5FA', card: '#1F2937' },
        minimal: { theme: 'light', layout: 'list', density: 'spacious', cardStyle: 'flat', pillStyle: 'underline', imageShape: 'square', priceStyle: 'neutral', font: 'Inter', fontScale: .95, cardRadius: 4, bg: '#F8FAFC', header: '#0F172A', accent: '#475569', card: '#FFFFFF' },
        bistro: { theme: 'light', layout: 'grid', density: 'comfortable', cardStyle: 'bordered', pillStyle: 'chip', imageShape: 'rounded', priceStyle: 'badge', font: 'Merriweather', fontScale: 1, cardRadius: 10, bg: '#FFF7ED', header: '#4C1D1D', accent: '#FBBF24', card: '#FFFBEB' },
        fresh: { theme: 'light', layout: 'grid', density: 'spacious', cardStyle: 'flat', pillStyle: 'pill', imageShape: 'circle', priceStyle: 'accent', font: 'Nunito', fontScale: 1, cardRadius: 20, bg: '#F0FDF4', header: '#14532D', accent: '#4ADE80', card: '#FFFFFF' },
        luxe: { theme: 'dark', layout: 'list', density: 'spacious', cardStyle: 'bordered', pillStyle: 'underline', imageShape: 'square', priceStyle: 'badge', font: 'Playfair Display', fontScale: 1.1, cardRadius: 0, bg: '#171717', header: '#0A0A0A', accent: '#D4AF37', card: '#262626' },
        sunset: { theme: 'light', layout: 'grid', density: 'comfortable', cardStyle: 'glass', pillStyle: 'pill', imageShape: 'rounded', priceStyle: 'accent', font: 'Poppins', fontScale: 1, cardRadius: 18, bg: '#FFF7ED', header: '#7C2D12', accent: '#FB923C', card: '#FFFFFF' }
    };
    document.querySelectorAll('[data-theme-preset]').forEach(function (button) {
        button.addEventListener('click', function () { applyPreset(presets[button.dataset.themePreset]); });
    });
    g('ds_resetTheme').addEventListener('click', function () { applyPreset(presets.classic); });

    document.querySelectorAll('[data-ds-tab]').forEach(function (button) {
        button.addEventListener('click', function () {
            var selected = button.dataset.dsTab;
            document.querySelectorAll('[data-ds-tab]').forEach(function (tab) {
                var active = tab === button;
                tab.classList.toggle('active', active);
                tab.setAttribute('aria-selected', active ? 'true' : 'false');
            });
            document.querySelectorAll('[data-ds-panel]').forEach(function (section) {
                section.classList.toggle('active', section.dataset.dsPanel === selected);
            });
            saveBtn.hidden = selected === 'hero';
            g('ds_previewFeedback').style.display = selected === 'hero' ? 'none' : 'flex';
            document.querySelector('.ds-controls').scrollTo({ top: 0, behavior: 'smooth' });
        });
    });

    document.querySelectorAll('[data-ds-width]').forEach(function (button) {
        button.addEventListener('click', function () {
            document.querySelectorAll('[data-ds-width]').forEach(function (entry) { entry.classList.remove('active'); });
            button.classList.add('active');
            iframe.style.width = button.dataset.dsWidth;
        });
    });

    document.querySelectorAll('[data-ds-mobile-view]').forEach(function (button) {
        button.addEventListener('click', function () {
            var preview = button.dataset.dsMobileView === 'preview';
            panel.classList.toggle('mobile-preview', preview);
            document.querySelectorAll('[data-ds-mobile-view]').forEach(function (entry) { entry.classList.remove('active'); });
            button.classList.add('active');
            if (preview && iframe.src === 'about:blank') iframe.src = iframe.dataset.src;
        });
    });

    /* ── open / close ───────────────────────────────────── */
    function lockPage() {
        pageScrollY = window.scrollY || document.documentElement.scrollTop || 0;
        document.documentElement.classList.add('ds-page-locked');
        document.body.classList.add('ds-page-locked');
        document.body.style.top = '-' + pageScrollY + 'px';
    }
    function unlockPage() {
        document.documentElement.classList.remove('ds-page-locked');
        document.body.classList.remove('ds-page-locked');
        document.body.style.top = '';
        window.scrollTo(0, pageScrollY);
    }
    function closeStudio() {
        if ((dirty || window.s2sHeroDirty) && !window.confirm('Discard your unsaved design changes?')) return;
        panel.classList.remove('open');
        unlockPage();
    }

    g('ds_openBtn').addEventListener('click', function () {
        lockPage();
        panel.classList.add('open');
        if (iframe.src === 'about:blank') iframe.src = iframe.dataset.src;
        else push();
    });
    g('ds_closeBtn').addEventListener('click', closeStudio);
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && panel.classList.contains('open')) closeStudio();
    });

    window.addEventListener('beforeunload', function (event) {
        if (!dirty && !window.s2sHeroDirty) return;
        event.preventDefault();
        event.returnValue = '';
    });

    /* ── save ───────────────────────────────────────────── */
    saveBtn.addEventListener('click', function () {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving…';
        fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
        })
            .then(function (r) {
                return r.json().catch(function () { return {}; }).then(function (data) {
                    if (!r.ok || !data.ok) throw new Error(data.error || 'The design could not be saved.');
                    return data;
                });
            })
            .then(function (d) {
                dirty = false;
                g('ds_dirtyState').textContent = 'Saved';
                g('ds_dirtyState').className = 'ds-dirty-state';
                saveBtn.classList.add('saved');
                saveBtn.textContent = 'Saved';
                /* reload iframe from server so it reflects the DB state */
                iframe.src = iframe.dataset.src + '&t=' + Date.now();
                setTimeout(function () {
                    saveBtn.classList.remove('saved');
                    saveBtn.textContent = 'Save';
                    saveBtn.disabled = false;
                }, 2000);
            })
            .catch(function (error) {
                g('ds_dirtyState').textContent = 'Error';
                g('ds_dirtyState').className = 'ds-dirty-state error';
                saveBtn.textContent = error.message || 'Save failed';
                saveBtn.disabled = false;
            });
    });

    /* ── initial sub-control visibility ─────────────────── */
    refreshVisibility();
})();
</script>

<script>
(function () {
    var dataNode = document.getElementById('heroConfigData');
    var endpoints = document.getElementById('heroEndpoints');
    var iframe = document.getElementById('dsPreview');
    if (!dataNode || !endpoints || !iframe) return;

    var config = JSON.parse(dataNode.textContent || '{}');
    var selectedId = 'background';
    var editMode = 'desktop';
    var pendingImageTarget = null;
    var published = {{ heroPublished ? 'true' : 'false' }};
    window.s2sHeroDirty = false;

    var layerList = document.getElementById('heroLayerList');
    var layerEditor = document.getElementById('heroLayerEditor');
    var validation = document.getElementById('heroValidation');
    var status = document.getElementById('heroStatus');
    var imageInput = document.getElementById('heroImageInput');
    var uploadProgress = document.getElementById('heroUploadProgress');
    var saveButton = document.getElementById('heroSaveDraft');
    var publishButton = document.getElementById('heroPublish');
    var hideButton = document.getElementById('heroHide');

    function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>'"]/g, function (character) {
            return {'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#039;','"':'&quot;'}[character];
        });
    }
    function id() { return 'layer-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }
    function selectedLayer() { return config.layers.find(function (layer) { return layer.id === selectedId; }) || config.layers[0]; }
    function toLocalInput(value) {
        if (!value) return '';
        var date = new Date(value);
        if (Number.isNaN(date.getTime())) return '';
        return new Date(date.getTime() - date.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    }
    function toIso(value) {
        if (!value) return null;
        var date = new Date(value);
        return Number.isNaN(date.getTime()) ? null : date.toISOString();
    }
    function clamp(value, min, max) { return Math.min(max, Math.max(min, Number(value) || 0)); }
    function fontOptions(selected) {
        return Array.from(document.getElementById('ds_font').options).map(function (option) {
            return '<option value="' + escapeHtml(option.value) + '"' + (option.value === selected ? ' selected' : '') + '>' + escapeHtml(option.textContent) + '</option>';
        }).join('');
    }
    function setStatus(title, detail, kind, icon) {
        status.className = 'hero-panel-status' + (kind ? ' ' + kind : '');
        status.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true">' + escapeHtml(icon || 'info') + '</span><div><strong>' + escapeHtml(title) + '</strong><span>' + escapeHtml(detail) + '</span></div>';
    }
    function markDirty(message) {
        window.s2sHeroDirty = true;
        setStatus('Unpublished hero changes', message || 'Save the draft when you are ready. Customers are not seeing these changes.', 'warning', 'edit');
    }
    function syncTopFields() {
        config.enabled = document.getElementById('hero_enabled').checked;
        config.startsAt = toIso(document.getElementById('hero_startsAt').value);
        config.expiresAt = toIso(document.getElementById('hero_expiresAt').value);
        config.desktopHeight = clamp(document.getElementById('hero_desktopHeight').value, 240, 600);
        config.mobileHeight = clamp(document.getElementById('hero_mobileHeight').value, 220, 520);
    }
    function messageList(messages, goodText) {
        validation.className = 'hero-validation ' + (messages.length ? 'error' : 'good');
        validation.innerHTML = messages.length
            ? '<strong>Please fix the following:</strong><ul>' + messages.map(function (message) { return '<li>' + escapeHtml(message) + '</li>'; }).join('') + '</ul>'
            : '<strong>' + escapeHtml(goodText || 'Hero is ready to publish.') + '</strong>';
    }
    function localErrors(forPublish) {
        syncTopFields();
        var errors = [];
        var visible = config.layers.filter(function (layer) { return layer.type !== 'background' && layer.visible; });
        if (forPublish && !config.enabled) errors.push('Turn on “Show hero” before publishing it.');
        if (forPublish && visible.length === 0) errors.push('Add at least one visible content layer.');
        var start = config.startsAt ? Date.parse(config.startsAt) : null;
        var end = config.expiresAt ? Date.parse(config.expiresAt) : null;
        if (end && end <= Date.now()) errors.push('Choose an expiration time in the future.');
        if (start && end && start >= end) errors.push('The start time must be earlier than the expiration time.');
        visible.forEach(function (layer) {
            if (layer.type === 'text' && !String(layer.content || '').trim()) errors.push(layer.name + ' needs some text.');
            if (layer.type === 'image' && !layer.imagePath) errors.push(layer.name + ' needs an uploaded image.');
            if (layer.type === 'countdown' && !end) errors.push(layer.name + ' needs an expiration date and time.');
        });
        return Array.from(new Set(errors));
    }
    function validate(forPublish) {
        var errors = localErrors(!!forPublish);
        messageList(errors, forPublish ? 'Hero is ready to publish.' : 'Draft structure looks good.');
        return errors;
    }

    function makeLayer(type, imagePath) {
        var number = config.layers.length;
        var common = {
            id: id(), name: type.charAt(0).toUpperCase() + type.slice(1) + ' ' + number,
            type: type, visible: true, locked: false, opacity: 1, rotation: 0,
            desktop: {x: 10, y: 15, width: 80, height: 24},
            mobile: {x: 8, y: 15, width: 84, height: 24}
        };
        if (type === 'text') Object.assign(common, {content:'Special offer',font:'Space Grotesk',fontSize:38,fontWeight:'700',color:'#FFFFFF',align:'center',backgroundEnabled:false,backgroundColor:'#000000'});
        if (type === 'shape') Object.assign(common, {shape:'rectangle',fill:'#E8A020',borderColor:'#FFFFFF',borderWidth:0,desktop:{x:20,y:25,width:60,height:30},mobile:{x:15,y:25,width:70,height:30}});
        if (type === 'image') Object.assign(common, {imagePath:imagePath || null,alt:'',fit:'contain',radius:12,aspectLocked:true,desktop:{x:30,y:15,width:40,height:55},mobile:{x:25,y:15,width:50,height:50}});
        if (type === 'countdown') Object.assign(common, {font:'Space Grotesk',fontSize:28,fontWeight:'700',color:'#FFFFFF',backgroundColor:'#18120A',showLabels:true,desktop:{x:20,y:55,width:60,height:22},mobile:{x:8,y:60,width:84,height:22}});
        return common;
    }

    function renderLayerList() {
        layerList.innerHTML = '';
        config.layers.forEach(function (layer, index) {
            var row = document.createElement('div');
            row.className = 'hero-layer-row' + (layer.id === selectedId ? ' active' : '');
            row.dataset.layerId = layer.id;
            row.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true">' + ({background:'wallpaper',text:'title',image:'image',shape:'shapes',countdown:'timer'}[layer.type] || 'layers') + '</span>' +
                '<div><strong>' + escapeHtml(layer.name) + '</strong><small>' + escapeHtml(layer.type) + (layer.visible ? '' : ' · hidden') + (layer.locked ? ' · locked' : '') + '</small></div>' +
                '<div class="hero-layer-actions">' +
                '<button type="button" data-layer-action="up" title="Move layer up"' + (index <= 1 ? ' disabled' : '') + '><span class="material-symbols-outlined">arrow_upward</span></button>' +
                '<button type="button" data-layer-action="down" title="Move layer down"' + (index === 0 || index === config.layers.length - 1 ? ' disabled' : '') + '><span class="material-symbols-outlined">arrow_downward</span></button>' +
                '<button type="button" data-layer-action="visibility" title="' + (layer.visible ? 'Hide layer' : 'Show layer') + '"><span class="material-symbols-outlined">' + (layer.visible ? 'visibility' : 'visibility_off') + '</span></button>' +
                '</div>';
            row.addEventListener('click', function (event) {
                var action = event.target.closest('[data-layer-action]');
                if (action) { handleLayerAction(layer.id, action.dataset.layerAction); return; }
                selectedId = layer.id; renderAll(true);
            });
            layerList.appendChild(row);
        });
        document.getElementById('heroLayerCount').textContent = config.layers.length + '/20';
        var full = config.layers.length >= 20;
        document.querySelectorAll('[data-hero-add]').forEach(function (button) { button.disabled = full || (button.dataset.heroAdd === 'countdown' && config.layers.some(function (layer) { return layer.type === 'countdown'; })); });
        document.getElementById('heroAddHelp').textContent = full
            ? 'The 20-layer limit is reached. Delete an unlocked layer before adding another.'
            : (config.layers.some(function (layer) { return layer.type === 'countdown'; }) ? 'A countdown already exists. Delete it before adding another.' : 'Maximum 20 layers including the locked background. Only one countdown is allowed.');
        refreshCountdownAction();
    }

    function handleLayerAction(layerId, action) {
        var index = config.layers.findIndex(function (layer) { return layer.id === layerId; });
        if (index < 0) return;
        var layer = config.layers[index];
        if (action === 'up' && index > 1) { config.layers.splice(index, 1); config.layers.splice(index - 1, 0, layer); }
        if (action === 'down' && index > 0 && index < config.layers.length - 1) { config.layers.splice(index, 1); config.layers.splice(index + 1, 0, layer); }
        if (action === 'visibility') {
            if (layer.type === 'background') { setStatus('Background cannot be hidden', 'Layer 0 always defines the hero canvas. Change its color or image instead.', 'warning', 'lock'); return; }
            layer.visible = !layer.visible;
        }
        markDirty('Layer order or visibility changed. Save the draft to keep it.');
        renderAll(true);
    }

    function commonFields(layer) {
        var position = layer[editMode];
        return '<div class="hero-editor-grid">' +
            '<div class="ds-row span-2"><label class="ds-field-help">Layer name</label><input type="text" maxlength="50" data-hero-field="name" value="' + escapeHtml(layer.name) + '"></div>' +
            '<label class="hero-check"><input type="checkbox" data-hero-field="visible"' + (layer.visible ? ' checked' : '') + '> Visible</label>' +
            '<label class="hero-check"><input type="checkbox" data-hero-field="locked"' + (layer.locked ? ' checked' : '') + '> Lock position</label>' +
            ['x','y','width','height'].map(function (field) { return '<div class="ds-row"><label class="ds-field-help">' + ({x:'Left %',y:'Top %',width:'Width %',height:'Height %'}[field]) + '</label><input type="number" min="' + (field === 'width' || field === 'height' ? 5 : 0) + '" max="100" step="1" data-hero-position="' + field + '" value="' + position[field] + '"></div>'; }).join('') +
            '<div class="ds-row"><label class="ds-field-help">Opacity</label><input type="number" min="0" max="1" step="0.05" data-hero-field="opacity" value="' + layer.opacity + '"></div>' +
            '<div class="ds-row"><label class="ds-field-help">Rotation °</label><input type="number" min="-180" max="180" data-hero-field="rotation" value="' + layer.rotation + '"></div>' +
            '</div>';
    }

    function renderEditor() {
        var layer = selectedLayer();
        selectedId = layer.id;
        if (layer.type === 'background') {
            layerEditor.className = '';
            layerEditor.innerHTML = '<div class="hero-editor-grid">' +
                '<div class="ds-row"><label class="ds-field-help">Background color</label><input type="color" data-hero-field="color" value="' + layer.color + '"></div>' +
                '<div class="ds-row"><label class="ds-field-help">Overlay color</label><input type="color" data-hero-field="overlayColor" value="' + layer.overlayColor + '"></div>' +
                '<div class="ds-row span-2"><label class="ds-field-help">Overlay opacity</label><input type="range" min="0" max="0.85" step="0.05" data-hero-field="overlayOpacity" value="' + layer.overlayOpacity + '"></div>' +
                '<div class="ds-row span-2"><button type="button" class="ds-file-label" id="heroBackgroundUpload">' + (layer.imagePath ? 'Replace background image' : 'Upload background image') + '</button>' + (layer.imagePath ? '<button type="button" class="ds-reset-btn" id="heroBackgroundRemove"><span class="material-symbols-outlined">delete</span>Remove background image</button>' : '') + '</div>' +
                '</div><p class="hero-help">Background is permanently locked as Layer 0 and cannot be hidden, moved, or deleted.</p>';
            bindEditor(layer);
            document.getElementById('heroBackgroundUpload').addEventListener('click', function () { pendingImageTarget = 'background'; imageInput.click(); });
            var remove = document.getElementById('heroBackgroundRemove');
            if (remove) remove.addEventListener('click', function () { layer.imagePath = null; markDirty('Background image removed from the draft.'); renderAll(true); });
            return;
        }

        var specific = '';
        if (layer.type === 'text') specific = '<div class="hero-editor-grid" style="margin-top:10px"><div class="ds-row span-2"><label class="ds-field-help">Text</label><textarea maxlength="300" data-hero-field="content">' + escapeHtml(layer.content) + '</textarea></div><div class="ds-row span-2"><label class="ds-field-help">Font</label><select data-hero-field="font">' + fontOptions(layer.font) + '</select></div><div class="ds-row"><label class="ds-field-help">Size px</label><input type="number" min="12" max="96" data-hero-field="fontSize" value="' + layer.fontSize + '"></div><div class="ds-row"><label class="ds-field-help">Color</label><input type="color" data-hero-field="color" value="' + layer.color + '"></div><div class="ds-row"><label class="ds-field-help">Alignment</label><select data-hero-field="align"><option value="left">Left</option><option value="center">Center</option><option value="right">Right</option></select></div><div class="ds-row"><label class="ds-field-help">Weight</label><select data-hero-field="fontWeight"><option>400</option><option>600</option><option>700</option><option>800</option></select></div><label class="hero-check span-2"><input type="checkbox" data-hero-field="backgroundEnabled"' + (layer.backgroundEnabled ? ' checked' : '') + '> Add text background</label><div class="ds-row span-2"><label class="ds-field-help">Text background color</label><input type="color" data-hero-field="backgroundColor" value="' + layer.backgroundColor + '"></div><div class="ds-row span-2"><button type="button" class="ds-file-label" id="heroFitText"><span class="material-symbols-outlined">fit_screen</span>Fit box to text</button></div></div>';
        if (layer.type === 'shape') specific = '<div class="hero-editor-grid" style="margin-top:10px"><div class="ds-row"><label class="ds-field-help">Shape</label><select data-hero-field="shape"><option value="rectangle">Rectangle</option><option value="circle">Circle</option></select></div><div class="ds-row"><label class="ds-field-help">Fill</label><input type="color" data-hero-field="fill" value="' + layer.fill + '"></div><div class="ds-row"><label class="ds-field-help">Border color</label><input type="color" data-hero-field="borderColor" value="' + layer.borderColor + '"></div><div class="ds-row"><label class="ds-field-help">Border px</label><input type="number" min="0" max="12" data-hero-field="borderWidth" value="' + layer.borderWidth + '"></div></div>';
        if (layer.type === 'image') specific = '<div class="hero-editor-grid" style="margin-top:10px"><div class="ds-row span-2"><label class="ds-field-help">Alternative text</label><input type="text" maxlength="150" data-hero-field="alt" value="' + escapeHtml(layer.alt) + '"></div><div class="ds-row"><label class="ds-field-help">Fit</label><select data-hero-field="fit"><option value="contain">Contain</option><option value="cover">Cover</option></select></div><div class="ds-row"><label class="ds-field-help">Corners px</label><input type="number" min="0" max="50" data-hero-field="radius" value="' + layer.radius + '"></div><label class="hero-check span-2"><input type="checkbox" data-hero-field="aspectLocked"' + (layer.aspectLocked !== false ? ' checked' : '') + '> Keep image proportions while resizing</label><div class="ds-row span-2"><button type="button" class="ds-file-label" id="heroReplaceImage">Replace image</button></div></div>';
        if (layer.type === 'countdown') specific = '<div class="hero-editor-grid" style="margin-top:10px"><div class="ds-row span-2"><label class="ds-field-help">Font</label><select data-hero-field="font">' + fontOptions(layer.font) + '</select></div><div class="ds-row"><label class="ds-field-help">Size px</label><input type="number" min="12" max="64" data-hero-field="fontSize" value="' + layer.fontSize + '"></div><div class="ds-row"><label class="ds-field-help">Weight</label><select data-hero-field="fontWeight"><option>400</option><option>600</option><option>700</option><option>800</option></select></div><div class="ds-row"><label class="ds-field-help">Text color</label><input type="color" data-hero-field="color" value="' + layer.color + '"></div><div class="ds-row"><label class="ds-field-help">Background</label><input type="color" data-hero-field="backgroundColor" value="' + layer.backgroundColor + '"></div><label class="hero-check span-2"><input type="checkbox" data-hero-field="showLabels"' + (layer.showLabels ? ' checked' : '') + '> Show day/hour labels</label></div><p class="hero-help">The countdown uses the hero expiration time. Publishing is blocked until a future expiration is selected.</p>';

        layerEditor.className = '';
        layerEditor.innerHTML = commonFields(layer) + specific + '<div class="hero-action-grid"><button type="button" id="heroDuplicateLayer">Duplicate layer</button><button type="button" class="danger" id="heroDeleteLayer"' + (layer.locked ? ' disabled' : '') + '>Delete layer</button></div><p class="hero-action-note">' + (layer.locked ? 'Unlock this layer before deleting it.' : 'Deletion affects the draft only until you publish.') + '</p>';
        bindEditor(layer);
        document.getElementById('heroDuplicateLayer').addEventListener('click', duplicateSelected);
        document.getElementById('heroDeleteLayer').addEventListener('click', deleteSelected);
        var replace = document.getElementById('heroReplaceImage');
        if (replace) replace.addEventListener('click', function () { pendingImageTarget = layer.id; imageInput.click(); });
        var fitText = document.getElementById('heroFitText');
        if (fitText) fitText.addEventListener('click', function () { fitTextLayer(layer, false); markDirty(layer.name + ' box fitted to its text in the ' + editMode + ' layout.'); renderAll(true); });
    }

    function fitTextLayer(layer, expandOnly) {
        if (layer.type !== 'text') return;
        var hero = null;
        try { hero = (iframe.contentDocument || iframe.contentWindow.document).getElementById('menuHero'); } catch (error) {}
        var canvasWidth = hero && hero.clientWidth ? hero.clientWidth : (editMode === 'mobile' ? 390 : 900);
        var canvasHeight = editMode === 'mobile' ? config.mobileHeight : config.desktopHeight;
        var fontSize = clamp(layer.fontSize, 12, 96);
        var lines = String(layer.content || 'Text').split(/\r?\n/);
        var longest = Math.max.apply(Math, lines.map(function (line) { return Math.max(1, line.length); }));
        var wantedWidthPx = Math.min(canvasWidth * .9, Math.max(fontSize * 4, longest * fontSize * .58 + 28));
        var charsPerLine = Math.max(1, Math.floor((wantedWidthPx - 20) / (fontSize * .58)));
        var visualLines = lines.reduce(function (total, line) { return total + Math.max(1, Math.ceil(Math.max(1, line.length) / charsPerLine)); }, 0);
        var wantedWidth = clamp((wantedWidthPx / canvasWidth) * 100, 5, 100 - layer[editMode].x);
        var wantedHeight = clamp(((visualLines * fontSize * 1.2 + 20) / canvasHeight) * 100, 5, 100 - layer[editMode].y);
        layer[editMode].width = expandOnly ? Math.max(layer[editMode].width, wantedWidth) : wantedWidth;
        layer[editMode].height = expandOnly ? Math.max(layer[editMode].height, wantedHeight) : wantedHeight;
    }

    function bindEditor(layer) {
        layerEditor.querySelectorAll('[data-hero-field]').forEach(function (input) {
            if (input.tagName === 'SELECT' && layer[input.dataset.heroField] != null) input.value = String(layer[input.dataset.heroField]);
            input.addEventListener('input', function () {
                var key = input.dataset.heroField;
                layer[key] = input.type === 'checkbox' ? input.checked : (input.type === 'number' || input.type === 'range' ? Number(input.value) : input.value);
                if (layer.type === 'text' && (key === 'content' || key === 'fontSize' || key === 'font')) fitTextLayer(layer, true);
                markDirty(layer.name + ' changed in the draft preview.'); renderPreview(); validate(false); renderLayerList();
            });
        });
        layerEditor.querySelectorAll('[data-hero-position]').forEach(function (input) {
            input.addEventListener('input', function () {
                var position = layer[editMode];
                var key = input.dataset.heroPosition;
                var minimum = key === 'width' || key === 'height' ? 5 : 0;
                position[key] = clamp(input.value, minimum, 100);
                if (key === 'x') position.width = Math.min(position.width, 100 - position.x);
                if (key === 'y') position.height = Math.min(position.height, 100 - position.y);
                if (key === 'width') position.width = Math.min(position.width, 100 - position.x);
                if (key === 'height') position.height = Math.min(position.height, 100 - position.y);
                markDirty(layer.name + ' repositioned for ' + editMode + '.'); renderPreview(); validate(false);
            });
        });
    }

    function duplicateSelected() {
        if (config.layers.length >= 20) { setStatus('Layer limit reached', 'Delete an unlocked layer before duplicating another one.', 'warning', 'layers'); return; }
        var layer = selectedLayer();
        if (layer.type === 'countdown') { setStatus('Countdown cannot be duplicated', 'Only one countdown is allowed. Edit the existing timer instead.', 'warning', 'timer'); return; }
        var copy = JSON.parse(JSON.stringify(layer));
        copy.id = id(); copy.name = layer.name + ' copy'; copy.locked = false;
        copy.desktop.x = Math.min(95, copy.desktop.x + 3); copy.mobile.x = Math.min(95, copy.mobile.x + 3);
        config.layers.push(copy); selectedId = copy.id; markDirty('Layer duplicated.'); renderAll(true);
    }
    function deleteSelected() {
        var layer = selectedLayer();
        if (layer.type === 'background') { setStatus('Background cannot be deleted', 'Layer 0 is required for every hero.', 'warning', 'lock'); return; }
        if (layer.locked) { setStatus('Layer is locked', 'Unlock it in Selected layer before deleting it.', 'warning', 'lock'); return; }
        if (!window.confirm('Delete “' + layer.name + '” from this draft?')) return;
        config.layers = config.layers.filter(function (entry) { return entry.id !== layer.id; });
        selectedId = 'background'; markDirty('Layer removed from the draft.'); renderAll(true);
    }

    function heroElement(doc) {
        var hero = doc.getElementById('menuHero');
        if (!hero) {
            hero = doc.createElement('section'); hero.id = 'menuHero'; hero.className = 'pub-hero pub-hero--preview';
            var main = doc.getElementById('pubMain');
            if (main) main.parentNode.insertBefore(hero, main);
        }
        return hero;
    }
    function renderPreview() {
        syncTopFields();
        var doc;
        try { doc = iframe.contentDocument || iframe.contentWindow.document; } catch (error) { return; }
        if (!doc || !doc.body) return;
        var hero = heroElement(doc);
        hero.dataset.editorMode = editMode;
        var background = config.layers[0];
        hero.style.setProperty('--hero-desktop-height', config.desktopHeight + 'px');
        hero.style.setProperty('--hero-mobile-height', config.mobileHeight + 'px');
        hero.style.setProperty('--hero-bg', background.color);
        hero.style.setProperty('--hero-bg-image', background.imagePath ? "url('/" + background.imagePath + "')" : 'none');
        hero.style.setProperty('--hero-overlay', background.overlayColor);
        hero.style.setProperty('--hero-overlay-opacity', background.overlayOpacity);
        hero.innerHTML = '<div class="pub-hero-overlay" aria-hidden="true"></div><div class="pub-hero-canvas"></div>';
        var canvas = hero.querySelector('.pub-hero-canvas');
        config.layers.slice(1).forEach(function (layer, index) {
            if (!layer.visible) return;
            var element = doc.createElement('div');
            element.className = 'pub-hero-layer pub-hero-layer--' + layer.type + (layer.id === selectedId ? ' pub-hero-layer--editing' : '');
            element.dataset.heroLayer = layer.id; element.dataset.layerType = layer.type;
            element.style.cssText = '--hx:' + layer.desktop.x + ';--hy:' + layer.desktop.y + ';--hw:' + layer.desktop.width + ';--hh:' + layer.desktop.height + ';--hmx:' + layer.mobile.x + ';--hmy:' + layer.mobile.y + ';--hmw:' + layer.mobile.width + ';--hmh:' + layer.mobile.height + ';--hopacity:' + layer.opacity + ';--hrotation:' + layer.rotation + 'deg;z-index:' + (index + 1) + ';' + (layer.id === selectedId ? 'outline:2px solid #E8A020;outline-offset:2px;' : '');
            if (layer.type === 'text') { var text = doc.createElement('div'); text.className = 'pub-hero-text'; text.textContent = layer.content; text.style.cssText = "font-family:'" + layer.font + "',sans-serif;font-size:" + layer.fontSize + 'px;font-weight:' + layer.fontWeight + ';color:' + layer.color + ';text-align:' + layer.align + ';' + (layer.backgroundEnabled ? 'background:' + layer.backgroundColor : ''); element.appendChild(text); }
            if (layer.type === 'shape') { var shape = doc.createElement('div'); shape.className = 'pub-hero-shape pub-hero-shape--' + layer.shape; shape.style.cssText = 'background:' + layer.fill + ';border:' + layer.borderWidth + 'px solid ' + layer.borderColor; element.appendChild(shape); }
            if (layer.type === 'image' && layer.imagePath) { var image = doc.createElement('img'); image.className = 'pub-hero-image'; image.src = '/' + layer.imagePath; image.alt = layer.alt || ''; image.style.cssText = 'object-fit:' + layer.fit + ';border-radius:' + layer.radius + 'px'; element.appendChild(image); }
            if (layer.type === 'countdown') { var timer = doc.createElement('div'); timer.className = 'pub-hero-countdown'; timer.style.cssText = "font-family:'" + layer.font + "',sans-serif;font-size:" + layer.fontSize + 'px;font-weight:' + layer.fontWeight + ';color:' + layer.color + ';background:' + layer.backgroundColor; timer.innerHTML = ['02','12','45','30'].map(function (part, i) { return '<span>' + part + (layer.showLabels ? '<small>' + ['days','hours','min','sec'][i] + '</small>' : '') + '</span>'; }).join(''); element.appendChild(timer); }
            if (layer.id === selectedId && !layer.locked) {
                var moveHandle = doc.createElement('button');
                moveHandle.type = 'button'; moveHandle.className = 'hero-preview-move-handle'; moveHandle.title = 'Drag to move ' + layer.name; moveHandle.setAttribute('aria-label', moveHandle.title);
                moveHandle.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true">open_with</span>';
                moveHandle.addEventListener('pointerdown', function (event) { event.stopPropagation(); startDrag(event, layer, element, hero, moveHandle); });
                element.appendChild(moveHandle);
                ['nw','ne','sw','se'].forEach(function (corner) {
                    var handle = doc.createElement('button');
                    handle.type = 'button'; handle.className = 'hero-preview-resize-handle'; handle.dataset.resize = corner; handle.title = 'Drag to resize ' + layer.name; handle.setAttribute('aria-label', handle.title);
                    handle.addEventListener('pointerdown', function (event) { event.stopPropagation(); startResize(event, layer, element, hero, handle, corner); });
                    element.appendChild(handle);
                });
            }
            element.addEventListener('click', function (event) { event.stopPropagation(); if (selectedId !== layer.id) { selectedId = layer.id; renderAll(true); } });
            canvas.appendChild(element);
        });
    }

    function startDrag(event, layer, element, hero, handle) {
        selectedId = layer.id;
        if (layer.locked) { setStatus('Layer is locked', 'Unlock it in Selected layer before dragging.', 'warning', 'lock'); renderLayerList(); renderEditor(); return; }
        event.preventDefault();
        var rect = hero.getBoundingClientRect();
        var position = layer[editMode];
        var startX = event.clientX, startY = event.clientY, originalX = position.x, originalY = position.y;
        handle.setPointerCapture(event.pointerId);
        function move(moveEvent) {
            position.x = clamp(originalX + ((moveEvent.clientX - startX) / rect.width) * 100, 0, 100 - position.width);
            position.y = clamp(originalY + ((moveEvent.clientY - startY) / rect.height) * 100, 0, 100 - position.height);
            element.style.setProperty(editMode === 'desktop' ? '--hx' : '--hmx', position.x);
            element.style.setProperty(editMode === 'desktop' ? '--hy' : '--hmy', position.y);
        }
        function finish() {
            handle.removeEventListener('pointermove', move); handle.removeEventListener('pointerup', finish); handle.removeEventListener('pointercancel', finish);
            markDirty(layer.name + ' moved in the ' + editMode + ' layout.'); renderAll(false); validate(false);
        }
        handle.addEventListener('pointermove', move); handle.addEventListener('pointerup', finish); handle.addEventListener('pointercancel', finish);
    }

    function startResize(event, layer, element, hero, handle, corner) {
        if (layer.locked) { setStatus('Layer is locked', 'Unlock it before resizing.', 'warning', 'lock'); return; }
        event.preventDefault();
        var rect = hero.getBoundingClientRect();
        var position = layer[editMode];
        var startX = event.clientX, startY = event.clientY;
        var original = {x:position.x,y:position.y,width:position.width,height:position.height};
        var right = original.x + original.width, bottom = original.y + original.height;
        var pixelRatio = (original.width * rect.width) / Math.max(1, original.height * rect.height);
        handle.setPointerCapture(event.pointerId);
        function move(moveEvent) {
            var dx = ((moveEvent.clientX - startX) / rect.width) * 100;
            var dy = ((moveEvent.clientY - startY) / rect.height) * 100;
            var nextX = corner.indexOf('w') !== -1 ? clamp(original.x + dx, 0, right - 5) : original.x;
            var nextY = corner.indexOf('n') !== -1 ? clamp(original.y + dy, 0, bottom - 5) : original.y;
            var nextWidth = corner.indexOf('w') !== -1 ? right - nextX : clamp(original.width + dx, 5, 100 - original.x);
            var nextHeight = corner.indexOf('n') !== -1 ? bottom - nextY : clamp(original.height + dy, 5, 100 - original.y);
            if (layer.type === 'image' && layer.aspectLocked !== false) {
                var widthFromHeight = nextHeight * rect.height * pixelRatio / rect.width;
                if (Math.abs(dx) >= Math.abs(dy)) nextHeight = nextWidth * rect.width / pixelRatio / rect.height;
                else nextWidth = widthFromHeight;
                nextWidth = clamp(nextWidth, 5, corner.indexOf('w') !== -1 ? right : 100 - original.x);
                nextHeight = clamp(nextHeight, 5, corner.indexOf('n') !== -1 ? bottom : 100 - original.y);
                if (corner.indexOf('w') !== -1) nextX = right - nextWidth;
                if (corner.indexOf('n') !== -1) nextY = bottom - nextHeight;
            }
            position.x = nextX; position.y = nextY; position.width = nextWidth; position.height = nextHeight;
            var mobile = editMode === 'mobile';
            element.style.setProperty(mobile ? '--hmx' : '--hx', position.x);
            element.style.setProperty(mobile ? '--hmy' : '--hy', position.y);
            element.style.setProperty(mobile ? '--hmw' : '--hw', position.width);
            element.style.setProperty(mobile ? '--hmh' : '--hh', position.height);
        }
        function finish() {
            handle.removeEventListener('pointermove', move); handle.removeEventListener('pointerup', finish); handle.removeEventListener('pointercancel', finish);
            markDirty(layer.name + ' resized in the ' + editMode + ' layout.'); renderAll(false); validate(false);
        }
        handle.addEventListener('pointermove', move); handle.addEventListener('pointerup', finish); handle.addEventListener('pointercancel', finish);
    }

    function renderAll(includePreview) {
        renderLayerList(); renderEditor(); if (includePreview !== false) renderPreview();
    }

    function addLayer(type) {
        if (config.layers.length >= 20) { setStatus('Layer limit reached', 'Delete an unlocked layer before adding another one.', 'warning', 'layers'); return; }
        if (type === 'countdown' && config.layers.some(function (layer) { return layer.type === 'countdown'; })) { setStatus('Only one countdown is allowed', 'Delete the existing countdown before adding another one.', 'warning', 'timer'); return; }
        if (type === 'image') { pendingImageTarget = 'new'; imageInput.click(); return; }
        var layer = makeLayer(type); config.layers.push(layer); selectedId = layer.id;
        markDirty(layer.name + ' added to the draft.'); renderAll(true); validate(false);
    }

    function refreshCountdownAction() {
        var button = document.getElementById('heroScheduleCountdown');
        var help = document.getElementById('heroScheduleCountdownHelp');
        if (!button || !help) return;
        var label = button.querySelector('span:last-child');
        var existing = config.layers.find(function (layer) { return layer.type === 'countdown'; });
        var expiry = config.expiresAt ? Date.parse(config.expiresAt) : NaN;
        if (existing) {
            button.disabled = false; label.textContent = 'Select countdown layer';
            help.textContent = 'The countdown is a separate layer. Select it here, then move or resize it in the preview.';
            return;
        }
        var ready = Number.isFinite(expiry) && expiry > Date.now();
        button.disabled = !ready || config.layers.length >= 20;
        label.textContent = 'Add countdown layer';
        help.textContent = config.layers.length >= 20
            ? 'The layer limit is reached. Delete an unlocked layer before adding a countdown.'
            : (ready ? 'This creates a separate timer layer using the expiration time above.' : 'Set a future expiration time to enable a visible countdown.');
    }

    function uploadImage(file) {
        if (!file) return;
        uploadProgress.hidden = false; uploadProgress.textContent = 'Uploading image…';
        var body = new FormData(); body.append('_token', endpoints.dataset.token); body.append('image', file);
        fetch(endpoints.dataset.image, {method:'POST',body:body,headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'}})
            .then(function (response) { return response.json().then(function (data) { if (!response.ok || !data.ok) throw new Error(data.message || 'Image upload failed.'); return data; }); })
            .then(function (data) {
                if (pendingImageTarget === 'background') config.layers[0].imagePath = data.path;
                else if (pendingImageTarget === 'new') { var layer = makeLayer('image', data.path); config.layers.push(layer); selectedId = layer.id; }
                else { var layer = config.layers.find(function (entry) { return entry.id === pendingImageTarget; }); if (layer) layer.imagePath = data.path; }
                markDirty('Image uploaded. Save the draft so it remains connected to this hero.'); renderAll(true); validate(false);
                uploadProgress.textContent = data.message;
            })
            .catch(function (error) { uploadProgress.textContent = error.message; setStatus('Image was not uploaded', error.message, 'error', 'error'); })
            .finally(function () { imageInput.value = ''; pendingImageTarget = null; window.setTimeout(function () { uploadProgress.hidden = true; }, 4500); });
    }

    function request(action, button) {
        syncTopFields();
        var errors = action === 'publish' ? validate(true) : [];
        if (errors.length) { setStatus('Hero cannot be published yet', errors[0], 'error', 'error'); return; }
        button.disabled = true; var previous = button.textContent; button.textContent = action === 'publish' ? 'Publishing…' : 'Saving…';
        fetch(endpoints.dataset[action], {method:'POST',body:JSON.stringify(config),headers:{'Content-Type':'application/json','Accept':'application/json','X-Requested-With':'XMLHttpRequest','X-CSRF-Token':endpoints.dataset.token}})
            .then(function (response) { return response.json().then(function (data) { if (!response.ok || !data.ok) { var error = new Error(data.message || 'The action could not be completed.'); error.details = data.errors || []; throw error; } return data; }); })
            .then(function (data) {
                config = data.config || config; window.s2sHeroDirty = false;
                if (action === 'publish') { published = true; hideButton.disabled = false; document.getElementById('heroActionNote').textContent = 'Hide removes the public hero immediately but keeps this draft.'; }
                setStatus(action === 'publish' ? 'Hero published' : 'Hero draft saved', data.message, '', 'check_circle');
                messageList([], action === 'publish' ? 'Published successfully.' : 'Draft saved successfully.');
                renderAll(true);
            })
            .catch(function (error) { messageList(error.details && error.details.length ? error.details : [error.message]); setStatus('Action not completed', error.message, 'error', 'error'); })
            .finally(function () { button.disabled = false; button.textContent = previous; });
    }

    document.getElementById('hero_startsAt').value = toLocalInput(config.startsAt);
    document.getElementById('hero_expiresAt').value = toLocalInput(config.expiresAt);
    ['hero_enabled','hero_startsAt','hero_expiresAt','hero_desktopHeight','hero_mobileHeight'].forEach(function (idValue) {
        document.getElementById(idValue).addEventListener('change', function () { syncTopFields(); markDirty('Hero visibility, schedule, or canvas changed.'); refreshCountdownAction(); renderPreview(); validate(false); });
    });
    document.querySelectorAll('[data-hero-mode]').forEach(function (button) {
        button.addEventListener('click', function () {
            editMode = button.dataset.heroMode;
            document.querySelectorAll('[data-hero-mode]').forEach(function (entry) { entry.classList.toggle('active', entry === button); });
            var device = document.querySelector('[data-ds-width="' + (editMode === 'mobile' ? '390px' : '100%') + '"]');
            if (device) device.click();
            renderEditor(); renderPreview();
            setStatus(editMode === 'mobile' ? 'Editing mobile layout' : 'Editing desktop layout', editMode === 'mobile' ? 'Layer positions now affect phones only.' : 'Layer positions now affect larger screens only.', '', editMode === 'mobile' ? 'smartphone' : 'desktop_windows');
        });
    });
    document.querySelectorAll('[data-hero-add]').forEach(function (button) { button.addEventListener('click', function () { addLayer(button.dataset.heroAdd); }); });
    document.getElementById('heroScheduleCountdown').addEventListener('click', function () {
        var existing = config.layers.find(function (layer) { return layer.type === 'countdown'; });
        if (existing) { selectedId = existing.id; renderAll(true); setStatus('Countdown selected', 'Use the center handle to move it and the corner handles to resize it.', '', 'timer'); return; }
        if (!config.expiresAt || Date.parse(config.expiresAt) <= Date.now()) { setStatus('Expiration required', 'Choose a future expiration time before adding a countdown.', 'warning', 'schedule'); return; }
        addLayer('countdown');
    });
    imageInput.addEventListener('change', function () { uploadImage(imageInput.files[0]); });
    saveButton.addEventListener('click', function () { request('draft', saveButton); });
    publishButton.addEventListener('click', function () { request('publish', publishButton); });
    hideButton.addEventListener('click', function () {
        if (!published) { setStatus('Nothing to hide yet', 'Publish a hero first. Your current work is only a private draft.', 'warning', 'info'); return; }
        if (!window.confirm('Hide the published hero from all customers now? Your draft will be kept.')) return;
        hideButton.disabled = true;
        fetch(endpoints.dataset.hide, {method:'POST',headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest','X-CSRF-Token':endpoints.dataset.token}})
            .then(function (response) { return response.json().then(function (data) { if (!response.ok || !data.ok) throw new Error(data.message || 'The hero could not be hidden.'); return data; }); })
            .then(function (data) { published = false; setStatus('Published hero hidden', data.message, '', 'visibility_off'); document.getElementById('heroActionNote').textContent = 'Publish again when this draft is ready. Hide is unavailable because nothing is public.'; })
            .catch(function (error) { hideButton.disabled = false; setStatus('Hero was not hidden', error.message, 'error', 'error'); });
    });
    iframe.addEventListener('load', function () { window.setTimeout(renderPreview, 40); });

    renderAll(false);
    validate(false);
})();
</script>

