                            <p style="font-family:'DM Sans',sans-serif;font-size:.85rem;color:#5c4a35;line-height:1.55;margin:0">Future versions will improve speed, accuracy, and will support more languages and menu styles.</p>
                        </div>
                    </div>
                </div>

                {# ── Slide 3: Privacy + Terms checkbox ── #}
                <div class="sslide" style="min-width:100%;padding:36px 28px 28px">
                    <div style="text-align:center;margin-bottom:22px">
                        <div style="display:inline-flex;align-items:center;justify-content:center;width:68px;height:68px;border-radius:16px;background:#f4f7ff;border:2px solid #5a7aff;margin-bottom:16px">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#5a7aff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <h2 style="font-family:'Space Grotesk',sans-serif;font-size:1.3rem;font-weight:700;color:#18120a;margin:0 0 8px">Data &amp; Privacy</h2>
                        <p style="font-family:'DM Sans',sans-serif;font-size:.9rem;color:#7a6248;line-height:1.6;max-width:360px;margin:0 auto">We collect the scan image and extracted data to improve the model. Here's what that means for you.</p>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:20px">
                        <div style="display:flex;gap:10px;align-items:flex-start;padding:12px 14px;background:#faf7f2;border-radius:10px;border:1px solid #ede4d6">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E8A020" stroke-width="2.5" stroke-linecap="round" style="margin-top:2px;flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>
                            <p style="font-family:'DM Sans',sans-serif;font-size:.84rem;color:#5c4a35;line-height:1.55;margin:0">Your menu images are processed securely and used to improve scan accuracy.</p>
                        </div>
                        <div style="display:flex;gap:10px;align-items:flex-start;padding:12px 14px;background:#faf7f2;border-radius:10px;border:1px solid #ede4d6">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E8A020" stroke-width="2.5" stroke-linecap="round" style="margin-top:2px;flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>
                            <p style="font-family:'DM Sans',sans-serif;font-size:.84rem;color:#5c4a35;line-height:1.55;margin:0">Extracted items, prices, and quality metrics are stored to retrain and improve the AI model.</p>
                        </div>
                        <div style="display:flex;gap:10px;align-items:flex-start;padding:12px 14px;background:#faf7f2;border-radius:10px;border:1px solid #ede4d6">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E8A020" stroke-width="2.5" stroke-linecap="round" style="margin-top:2px;flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>
                            <p style="font-family:'DM Sans',sans-serif;font-size:.84rem;color:#5c4a35;line-height:1.55;margin:0">We never sell your data. It is used solely for model improvement within the Scan to See platform.</p>
                        </div>
                    </div>
                    <div style="margin-bottom:18px">
                        <a href="{{ path('app_owner_scanner_privacy') }}" target="_blank" style="font-family:'DM Sans',sans-serif;font-size:.84rem;font-weight:600;color:#5a7aff;text-decoration:underline;text-underline-offset:3px">
                            📄 See full policy →
                        </a>
                    </div>
                    <label id="scannerTermsLabel" style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;padding:14px 16px;background:#f9f6f2;border-radius:10px;border:2px solid #ede4d6;transition:border-color .2s">
                        <input type="checkbox" id="scannerTermsCheck" style="width:18px;height:18px;margin-top:1px;accent-color:#E8A020;cursor:pointer;flex-shrink:0">
                        <span style="font-family:'DM Sans',sans-serif;font-size:.85rem;color:#3d2f1e;line-height:1.55">I have read and accept the <strong>data collection terms</strong> for the Menu Scanner beta.</span>
                    </label>
                </div>

                {# ── Slide 4: Thank you / Let's start ── #}
                <div class="sslide" style="min-width:100%;padding:36px 28px 28px;text-align:center">
                    <div style="margin-bottom:24px">
                        <div style="display:inline-flex;align-items:center;justify-content:center;width:80px;height:80px;border-radius:20px;background:linear-gradient(135deg,#18120a 0%,#2a1f10 100%);margin-bottom:20px;box-shadow:0 12px 32px rgba(24,18,10,.3)">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#E8A020" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                        </div>
                        <h2 style="font-family:'Space Grotesk',sans-serif;font-size:1.5rem;font-weight:700;color:#18120a;margin:0 0 12px;line-height:1.25">Thank you for your trust</h2>
                        <p style="font-family:'DM Sans',sans-serif;font-size:.95rem;color:#5c4a35;line-height:1.65;max-width:360px;margin:0 auto 20px">Your confidence in our beta means a lot to us. Together, we'll build a smarter, more accurate scanner — one menu at a time.</p>
                        <div style="display:inline-flex;gap:8px;align-items:center;padding:10px 18px;background:#faf7f2;border-radius:10px;border:1px solid #ede4d6">
                            <img src="{{ asset('image/logoS2S.png') }}" alt="S2S" style="height:20px;width:auto">
                            <span style="font-family:'Space Grotesk',sans-serif;font-size:.8rem;font-weight:600;color:#18120a">Scan to See</span>
                        </div>
                    </div>
                    <p style="font-family:'DM Sans',sans-serif;font-size:.85rem;color:#9c8874;margin-bottom:4px">Your workspace is ready.</p>
                </div>

            </div>{# end slide track #}
        </div>

        {# ── Footer navigation ── #}
        <div id="scannerNavBar" style="padding:18px 24px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid #f0e9de">
            <button id="scannerBackBtn" style="font-family:'DM Sans',sans-serif;font-size:.875rem;font-weight:600;color:#9c8874;background:none;border:1.5px solid #e3d9cc;border-radius:8px;padding:9px 18px;cursor:pointer;transition:all .15s;display:none">← Back</button>
            <div id="scannerNavSpacer" style="flex:1"></div>
            <button id="scannerNextBtn" style="font-family:'Space Grotesk',sans-serif;font-size:.875rem;font-weight:700;color:#fff;background:#18120a;border:none;border-radius:8px;padding:10px 22px;cursor:pointer;transition:background .15s;display:flex;align-items:center;gap:7px">
                Next <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
            <button id="scannerFinishBtn" style="font-family:'Space Grotesk',sans-serif;font-size:.875rem;font-weight:700;color:#18120a;background:#E8A020;border:none;border-radius:8px;padding:10px 22px;cursor:pointer;opacity:.45;pointer-events:none;transition:all .15s;display:none">
                Let's Start 🚀
            </button>
        </div>
    </div>
</div>

<style>
/* ── Scanner dot indicators ─── */
.sdot { display:inline-block;width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.2);transition:all .25s; }
.sdot--active { background:#E8A020;width:20px;border-radius:4px; }
/* ── Hover effects ── */
#scannerBackBtn:hover { border-color:#E8A020;color:#E8A020; }
#scannerNextBtn:hover { background:#2a1f10; }
#scannerFinishBtn:not([style*="pointer-events:none"]):hover { background:#d48f10; }
#scannerTermsLabel:has(#scannerTermsCheck:checked) { border-color:#E8A020;background:#fffbf2; }
</style>

<script>
(function () {
    var WORKSPACE_URL = '{{ path("app_owner_scanner_workspace", {"menu": menu.id}) }}';
    var TOTAL_STEPS   = 4;
    var currentStep   = 0;

    var onboarding  = document.getElementById('scannerOnboarding');
    var card        = document.getElementById('scannerOnboardingCard');
    var track       = document.getElementById('scannerSlideTrack');
    var dots        = document.querySelectorAll('.sdot');
    var backBtn     = document.getElementById('scannerBackBtn');
    var nextBtn     = document.getElementById('scannerNextBtn');
    var finishBtn   = document.getElementById('scannerFinishBtn');
    var termsCheck  = document.getElementById('scannerTermsCheck');
    var openBtn     = document.getElementById('scannerOnboardingBtn');

    function goTo(step) {
        currentStep = step;
        track.style.transform = 'translateX(-' + (step * 100) + '%)';

        // Dots
        dots.forEach(function(d, i) {
            d.classList.toggle('sdot--active', i === step);
        });

        // Back button
        backBtn.style.display = step > 0 ? 'inline-flex' : 'none';

        // Step 3 (slide 2 = index 2): show finish btn, hide next
        var isLastStep = (step === TOTAL_STEPS - 1);
        var isTermsStep = (step === TOTAL_STEPS - 2); // slide index 2

        if (isLastStep) {
            nextBtn.style.display  = 'none';
            finishBtn.style.display = 'inline-flex';
        } else if (isTermsStep) {
            nextBtn.style.display  = 'none';
            finishBtn.style.display = 'none';
            // We'll handle Finish visibility from the checkbox
            refreshFinishBtn();
        } else {
            nextBtn.style.display  = 'inline-flex';
            finishBtn.style.display = 'none';
        }

        // On last slide, show only Let's Start (already set above)
        if (isLastStep) {
            finishBtn.style.opacity       = '1';
            finishBtn.style.pointerEvents = 'auto';
        }
    }

    function refreshFinishBtn() {
        var checked = termsCheck && termsCheck.checked;
        var isTermsStep = (currentStep === TOTAL_STEPS - 2);
        if (isTermsStep) {
            finishBtn.style.display = 'inline-flex';
            finishBtn.style.opacity = checked ? '1' : '.45';
            finishBtn.style.pointerEvents = checked ? 'auto' : 'none';
        }
    }

    function openModal() {
        currentStep = 0;
        if (termsCheck) termsCheck.checked = false;
        onboarding.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        goTo(0);
        // Entrance animation
        card.style.transform = 'translateY(24px) scale(.97)';
        card.style.opacity   = '0';
        card.style.transition = 'none';
        requestAnimationFrame(function() {
            requestAnimationFrame(function() {
                card.style.transition = 'transform .28s cubic-bezier(.22,.68,0,1.2), opacity .22s ease';
                card.style.transform  = 'translateY(0) scale(1)';
                card.style.opacity    = '1';
            });
        });
    }

    function closeModal() {
        onboarding.style.display = 'none';
        document.body.style.overflow = '';
    }

    // Trigger
    if (openBtn && !openBtn.disabled) openBtn.addEventListener('click', openModal);

    // Navigation
    nextBtn.addEventListener('click', function() {
        if (currentStep < TOTAL_STEPS - 1) goTo(currentStep + 1);
    });
    backBtn.addEventListener('click', function() {
        if (currentStep > 0) goTo(currentStep - 1);
    });

    // Terms checkbox
    if (termsCheck) {
        termsCheck.addEventListener('change', refreshFinishBtn);
    }

    // Finish / Let's Start
    finishBtn.addEventListener('click', function() {
        // On slide 2 (terms) → go to slide 3 (thank you)
        if (currentStep === TOTAL_STEPS - 2) {
            goTo(TOTAL_STEPS - 1);
        } else if (currentStep === TOTAL_STEPS - 1) {
            // Close popup first so bfcache saves a clean DOM, then navigate
            closeModal();
            window.location.href = WORKSPACE_URL;
        }
    });

    // Close on backdrop
    onboarding.addEventListener('click', function(e) {
        if (e.target === onboarding) closeModal();
    });
    // Close on Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && onboarding.style.display === 'flex') closeModal();
    });

    // Safety net: always hide popup when page is restored from bfcache (browser Back button)
    window.addEventListener('pageshow', function(e) {
        if (onboarding) {
            onboarding.style.display = 'none';
            document.body.style.overflow = '';
        }
    });
})();
</script>
{% endblock %}
