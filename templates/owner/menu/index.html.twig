{% extends 'owner/layout.html.twig' %}

{% block title %}Menus — S2S{% endblock %}
{% block page_title %}Menus{% endblock %}

{% block content %}
{% include 'owner/_access_notice.html.twig' %}
<div class="owner-panel">
    <div class="owner-panel-head">
        <h2>All menus</h2>
        {% if canCreate %}
            <a href="{{ path('app_owner_menu_new') }}"
               data-modal="{{ path('app_owner_menu_new') }}"
               class="btn btn-primary btn-sm">+ New menu</a>
        {% else %}
            <button class="btn btn-primary btn-sm" onclick="document.getElementById('menuLimitModal').style.display='flex'">
                + New menu
            </button>
        {% endif %}
    </div>
    {% if menus|length == 0 %}
        <div class="owner-empty">
            <p>No menus yet. Create your first menu to get started.</p>
            <a href="{{ path('app_owner_menu_new') }}"
               data-modal="{{ path('app_owner_menu_new') }}"
               class="btn btn-primary">Create first menu</a>
        </div>
    {% else %}
        <table class="owner-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Business</th>
                    <th>Status</th>
                    <th>Currency</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for menu in menus %}
                    <tr>
                        <td>
                            <a href="{{ path('app_owner_menu_show', {id: menu.id}) }}" style="font-weight:600;color:var(--amber-dk)">
                                {{ menu.name }}
                            </a>
                        </td>
                        <td style="color:var(--muted);font-size:.82rem">{{ menu.business.name }}</td>
                        <td><span class="badge badge--{{ menu.status }}">{{ menu.status }}</span></td>
                        <td>{{ menu.currency }}</td>
                        <td style="color:var(--muted);font-size:.82rem">{{ menu.createdAt|date('M d, Y') }}</td>
                        <td style="text-align:right;white-space:nowrap">
                            <a href="{{ path('app_owner_menu_show', {id: menu.id}) }}" class="owner-table-action">View</a>
                            <a href="{{ path('app_owner_menu_edit', {id: menu.id}) }}"
                               data-modal="{{ path('app_owner_menu_edit', {id: menu.id}) }}"
                               class="owner-table-action">Edit</a>
                            <form method="post"
                                  action="{{ path('app_owner_menu_delete', {id: menu.id}) }}"
                                  style="display:inline"
                                  onsubmit="return confirm('Delete «{{ menu.name }}» and all its content?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-menu-' ~ menu.id) }}">
                                <button type="submit" class="owner-table-action owner-table-action--danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>

{# ── Plan limit modal ─────────────────────────────────────────────────── #}
{% if not canCreate %}
<div id="menuLimitModal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(10,6,2,.75); backdrop-filter:blur(6px); align-items:center; justify-content:center; padding:24px;">
    <div style="background:#fff; border-radius:16px; max-width:460px; width:100%; padding:32px 28px; box-shadow:0 24px 80px rgba(0,0,0,.4); text-align:center;">
        <span class="material-symbols-outlined plan-message-icon" aria-hidden="true">event_busy</span>
        <h3 style="font-family:'Space Grotesk',sans-serif; font-size:1.4rem; font-weight:700; color:#18120a; margin:0 0 12px;">{{ accessContext.label }} menu limit reached</h3>
        <p style="font-size:.95rem; color:#737373; line-height:1.6; margin:0 0 28px;">
            Your {{ accessContext.label }} includes
            {{ accessContext.limits.draft is null ? 'unlimited drafts' : accessContext.limits.draft ~ ' draft menu' ~ (accessContext.limits.draft == 1 ? '' : 's') }}
            and
            {{ accessContext.limits.published is null ? 'unlimited published menus' : accessContext.limits.published ~ ' published menu' ~ (accessContext.limits.published == 1 ? '' : 's') }}.
            You currently use {{ accessContext.usage.draft }} draft and {{ accessContext.usage.published }} published.
        </p>
        <div style="display:flex; gap:12px;">
            <button onclick="document.getElementById('menuLimitModal').style.display='none'" 
                    style="flex:1; padding:11px 20px; border:1.5px solid #d4d4d4; border-radius:8px; background:#fff; font-family:'DM Sans',sans-serif; font-size:.875rem; font-weight:600; cursor:pointer;">
                Got it
            </button>
            <a href="{{ path('app_owner_subscription') }}" 
               style="flex:1; padding:11px 20px; background:#E8A020; border:1.5px solid #E8A020; border-radius:8px; color:#fff; font-family:'DM Sans',sans-serif; font-size:.875rem; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; justify-content:center;">
                Upgrade Plan
            </a>
        </div>
    </div>
</div>
<style>
</style>
<script>
document.getElementById('menuLimitModal').addEventListener('click', function(e) {
    if (e.target === this) this.style.display = 'none';
});
</script>
{% endif %}

{% endblock %}
