<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Save Your Backup Codes — S2S</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500&display=swap" rel="stylesheet">
    <style>
        :root {
            --amber: #E8A020;
            --amber-dark: #c4861a;
            --bg: #18120A;
            --surface: #201810;
            --surface2: #2a1f12;
            --border: rgba(232,160,32,0.18);
            --text: #f5e9d6;
            --muted: #9a8060;
            --green: #3ec97a;
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }
        .card {
            width: 100%;
            max-width: 480px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 2.5rem 2rem;
        }
        .logo {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--amber);
            text-align: center;
            margin-bottom: 0.25rem;
        }
        .page-title {
            text-align: center;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.05rem;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        .subtitle {
            text-align: center;
            color: var(--muted);
            font-size: 0.8rem;
            margin-bottom: 1.75rem;
        }
        .success-banner {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: rgba(62,201,122,.08);
            border: 1px solid rgba(62,201,122,.3);
            border-radius: 4px;
            padding: 0.75rem 1rem;
            margin-bottom: 1.75rem;
            color: var(--green);
            font-size: 0.875rem;
            font-weight: 600;
        }
        .warning-box {
            background: rgba(232,160,32,.08);
            border: 1px solid rgba(232,160,32,.25);
            border-radius: 4px;
            padding: 0.7rem 1rem;
            font-size: 0.8rem;
            color: var(--amber);
            margin-bottom: 1.25rem;
            line-height: 1.55;
        }
        .codes-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.5rem;
            margin-bottom: 1.25rem;
        }
        .code-item {
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 4px;
            font-family: 'Space Grotesk', monospace;
            font-size: 0.95rem;
            font-weight: 600;
            letter-spacing: .12em;
            color: var(--text);
            padding: 0.55rem 0.75rem;
            text-align: center;
        }
        .copy-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            width: 100%;
            padding: 0.6rem;
            background: transparent;
            border: 1px solid var(--border);
            color: var(--muted);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.825rem;
            cursor: pointer;
            border-radius: 4px;
            transition: border-color .15s, color .15s;
            margin-bottom: 1.25rem;
        }
        .copy-btn:hover { border-color: var(--amber); color: var(--amber); }
        .btn {
            display: block;
            width: 100%;
            padding: 0.8rem;
            background: var(--amber);
            color: #18120A;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: .04em;
            border: none;
            cursor: pointer;
            transition: background .15s;
            text-align: center;
            text-decoration: none;
        }
        .btn:hover { background: var(--amber-dark); }
    </style>
</head>
<body>
<div class="card">
    <div class="logo">S2S</div>
    <div class="page-title">2FA Activated!</div>
    <div class="subtitle">Save your backup codes before continuing</div>

    <div class="success-banner">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        Two-factor authentication is now enabled on your account.
    </div>

    <div class="warning-box">
        ⚠ <strong>Store these codes somewhere safe.</strong> Each code can only be used once.
        They are the only way to access your account if you lose your phone.
        This page will not be shown again.
    </div>

    <div class="codes-grid" id="codesGrid">
        {% for code in backup_codes %}
            <div class="code-item">{{ code }}</div>
        {% endfor %}
    </div>

    <button class="copy-btn" onclick="copyCodes()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        <span id="copyLabel">Copy all codes</span>
    </button>

    <a href="{{ path('app_dashboard') }}" class="btn">I've saved my codes — Continue</a>
</div>

<script>
function copyCodes() {
    var items = document.querySelectorAll('#codesGrid .code-item');
    var text = Array.from(items).map(function(el) { return el.textContent.trim(); }).join('\n');
    navigator.clipboard.writeText(text).then(function() {
        document.getElementById('copyLabel').textContent = 'Copied!';
        setTimeout(function() { document.getElementById('copyLabel').textContent = 'Copy all codes'; }, 2000);
    });
}
</script>
</body>
</html>
