{% extends 'base.html.twig' %}

{% block title %}Reset Password — S2S{% endblock %}

{% block body %}
    <section class="auth-page">
        <div class="auth-box">
            <div class="auth-left">
                <div class="auth-logo-row">
                    <img src="{{ asset('image/scantosee.png') }}" alt="S2S">
                    <span>Scan to See</span>
                </div>
                <h1>Choose a new password.</h1>
                <p>Pick something strong that you haven't used before. Your link expires in 30 minutes — you're good to go.</p>
                <div class="auth-pills">
                    <span class="auth-pill">Min 8 characters</span>
                    <span class="auth-pill">One-time link</span>
                    <span class="auth-pill">Instant access</span>
                </div>
            </div>
            <div class="auth-right">
                <h2>Set new password</h2>
                <p>Enter and confirm your new password below.</p>

                {% for message in app.flashes('error') %}
                    <div class="auth-alert auth-alert--err">{{ message }}</div>
                {% endfor %}

                <form class="auth-form" method="post" action="{{ path('app_reset_password', {token: token}) }}">
                    <div data-controller="password" style="display:contents">
                        <div class="form-field">
                            <label for="password">New password</label>
                            <div class="pw-field">
                                <input id="password" name="password" type="password"
                                       autocomplete="new-password"
                                       placeholder="At least 8 characters"
                                       required minlength="8"
                                       data-password-target="input">
                                <button type="button" class="pw-eye"
                                        data-action="click->password#toggleInput"
                                        aria-label="Show password">
                                    <span class="eye-on">Show</span>
                                    <span class="eye-off" hidden>Hide</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="form-field">
                        <label for="confirm">Confirm new password</label>
                        <input id="confirm" name="confirm" type="password"
                               autocomplete="new-password"
                               placeholder="Repeat your password"
                               required minlength="8">
                    </div>
                    <button class="btn btn-primary btn-full" type="submit">Update password</button>
                    <p class="form-switch">
                        <a href="{{ path('app_login') }}">Back to login</a>
                    </p>
                </form>
            </div>
        </div>
    </section>
{% endblock %}
