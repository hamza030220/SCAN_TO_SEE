{% extends 'base.html.twig' %}

{% block title %}S2S — AI-powered digital menus with one permanent QR{% endblock %}
{% block meta_description %}Build a digital menu, scan handwritten or printed menus with AI assistance, and keep one permanent QR code across every update.{% endblock %}

{% block body %}
    <section class="s-hero s-hero--new">
        <div class="hero-orb hero-orb--one" aria-hidden="true"></div>
        <div class="hero-orb hero-orb--two" aria-hidden="true"></div>
        <div class="shell hero-grid hero-grid--new">
            <div class="hero-copy">
                <a class="hero-announcement" href="{{ path('app_ai_scanner') }}">
                    <span class="announcement-mark">
                        <span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>
                    </span>
                    <span><strong>New in beta</strong> AI-assisted menu scanning</span>
                    <span class="material-symbols-outlined announcement-arrow" aria-hidden="true">arrow_forward</span>
                </a>
                <span class="eyebrow">The operating system for digital menus</span>
                <h1>From paper menu to <span class="text-accent">live QR experience.</span></h1>
                <p class="hero-lede">Create, scan, edit, publish, and update a professional menu from one workspace. Your guests open it instantly in their browser, while your printed QR code stays the same.</p>
                <div class="hero-actions">
                    <a class="btn btn-primary btn-icon" href="{{ path('app_register') }}">
                        Create your menu
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                    </a>
                    <a class="btn btn-ghost btn-icon" href="{{ path('app_ai_scanner') }}">
                        Explore the AI Scanner
                        <span class="material-symbols-outlined" aria-hidden="true">document_scanner</span>
                    </a>
                </div>
                <div class="hero-proof" aria-label="Product highlights">
                    <span><span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>5-day free trial</span>
                    <span><span class="material-symbols-outlined" aria-hidden="true">phone_iphone</span>No guest app</span>
                    <span><span class="material-symbols-outlined" aria-hidden="true">qr_code_2</span>Permanent QR</span>
                    <span><span class="material-symbols-outlined" aria-hidden="true">edit_note</span>Owner-reviewed AI</span>
                </div>
            </div>

            <div class="hero-product" aria-label="S2S menu scanner product preview">
                <div class="product-window">
                    <div class="product-window-bar">
                        <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
                        <span class="window-address">app.scantosee / menu workspace</span>
                        <span class="material-symbols-outlined" aria-hidden="true">lock</span>
                    </div>
                    <div class="product-workspace">
                        <aside class="product-sidebar">
                            <span class="product-logo">S2S</span>
                            <span class="side-item is-active"><span class="material-symbols-outlined">dashboard</span></span>
                            <span class="side-item"><span class="material-symbols-outlined">restaurant_menu</span></span>
                            <span class="side-item"><span class="material-symbols-outlined">qr_code_2</span></span>
                        </aside>
                        <div class="product-main">
                            <div class="product-heading">
                                <div><span>Blue Bean Café</span><strong>Breakfast menu</strong></div>
                                <span class="product-status">Draft</span>
                            </div>
                            <div class="scan-stage">
                                <div class="paper-menu">
                                    <div class="paper-title"></div>
                                    <div class="paper-line w-80"></div>
                                    <div class="paper-line w-60"></div>
                                    <div class="paper-line w-90"></div>
                                    <div class="paper-line w-70"></div>
                                    <div class="paper-line w-85"></div>
                                    <div class="scan-beam"></div>
                                </div>
                                <div class="scan-result">
                                    <span class="scan-label"><span class="scan-pulse"></span>AI extracting</span>
                                    <div><span>Cappuccino</span><strong>4.50</strong></div>
                                    <div><span>Iced latte</span><strong>5.20</strong></div>
                                    <div><span>Seasonal tart</span><strong>7.00</strong></div>
                                    <p><span class="material-symbols-outlined">fact_check</span>Ready for owner review</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="floating-card floating-card--accuracy">
                    <span class="material-symbols-outlined" aria-hidden="true">verified</span>
                    <div><strong>Review before save</strong><small>You stay in control</small></div>
                </div>
                <div class="floating-card floating-card--qr">
                    <span class="material-symbols-outlined" aria-hidden="true">qr_code_2</span>
                    <div><strong>QR stays active</strong><small>Across every edit</small></div>
                </div>
            </div>
        </div>
    </section>

    <section class="s-marquee" aria-label="Product capabilities">
        <div class="marquee-track">
            {% for repeat in 1..2 %}
                <span>AI menu scanning</span><i></i>
                <span>Permanent QR codes</span><i></i>
                <span>Live availability</span><i></i>
                <span>Multilingual menus</span><i></i>
                <span>Owner-controlled publishing</span><i></i>
            {% endfor %}
        </div>
    </section>

    <section class="s-intro">
        <div class="shell intro-grid" data-reveal>
            <div>
                <span class="eyebrow">Less setup, more control</span>
                <h2>A complete workflow, not just a QR generator.</h2>
            </div>
            <div class="intro-copy">
                <p>S2S connects the physical menu on your counter with a structured digital workspace. Start manually or use the AI Scanner beta to create a first draft from a photo.</p>
                <p>Then refine every category, item, price, image, language, and availability state before publishing to customers.</p>
            </div>
        </div>
    </section>

    <section class="s-steps s-steps--new">
        <div class="shell">
            <div class="section-split-head" data-reveal>
                <div>
                    <span class="eyebrow">How it works</span>
                    <h2>Paper in. Structured menu out.</h2>
                </div>
                <p>Move from a photo or blank workspace to a customer-ready menu through four controlled steps.</p>
            </div>
            <div class="workflow-grid">
                <article class="workflow-card" data-reveal>
                    <span class="workflow-number">01</span>
                    <span class="material-symbols-outlined workflow-icon" aria-hidden="true">add_business</span>
                    <h3>Create your business</h3>
                    <p>Add the venue identity and choose the empty menu that will receive your content.</p>
                </article>
                <article class="workflow-card" data-reveal>
                    <span class="workflow-number">02</span>
                    <span class="material-symbols-outlined workflow-icon" aria-hidden="true">document_scanner</span>
                    <h3>Scan or build</h3>
                    <p>Upload a menu photo for AI extraction, or enter categories and items manually.</p>
                </article>
                <article class="workflow-card" data-reveal>
                    <span class="workflow-number">03</span>
                    <span class="material-symbols-outlined workflow-icon" aria-hidden="true">fact_check</span>
                    <h3>Review every field</h3>
                    <p>Correct names, prices, categories, and uncertain results before anything is saved.</p>
                </article>
                <article class="workflow-card" data-reveal>
                    <span class="workflow-number">04</span>
                    <span class="material-symbols-outlined workflow-icon" aria-hidden="true">rocket_launch</span>
                    <h3>Publish once, update often</h3>
                    <p>Share the permanent QR and keep improving what customers see behind it.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="s-ai-spotlight">
        <div class="shell ai-spotlight-grid">
            <div class="ai-visual" data-reveal>
                <div class="ai-grid-bg" aria-hidden="true"></div>
                <span class="ai-core"><span class="material-symbols-outlined">neurology</span></span>
                <span class="ai-node ai-node--one"><span class="material-symbols-outlined">image</span>Menu image</span>
                <span class="ai-node ai-node--two"><span class="material-symbols-outlined">category</span>Categories</span>
                <span class="ai-node ai-node--three"><span class="material-symbols-outlined">sell</span>Prices</span>
                <span class="ai-node ai-node--four"><span class="material-symbols-outlined">rate_review</span>Corrections</span>
            </div>
            <div class="ai-copy" data-reveal>
                <span class="eyebrow">AI Menu Scanner · Beta</span>
                <h2>Your existing menu becomes the starting point.</h2>
                <p>The scanner combines image processing, text recognition, and menu-aware structuring to propose categories, items, and prices from a photograph.</p>
                <ul class="check-list">
                    <li><span class="material-symbols-outlined">check</span>Designed for handwritten and printed menu layouts</li>
                    <li><span class="material-symbols-outlined">check</span>Highlights uncertain fields for human review</li>
                    <li><span class="material-symbols-outlined">check</span>Stores approved corrections to improve future training data</li>
                    <li><span class="material-symbols-outlined">check</span>Only works on an empty target menu to protect existing content</li>
                </ul>
                <a class="text-link" href="{{ path('app_ai_scanner') }}">See how the AI Scanner works <span class="material-symbols-outlined">arrow_forward</span></a>
            </div>
        </div>
    </section>

    <section class="s-designer-spotlight">
        <div class="shell designer-spotlight-grid">
            <div class="designer-spotlight-copy" data-reveal>
                <span class="eyebrow">Live Menu Designer</span>
                <h2>Your menu should look as considered as your venue.</h2>
                <p>Shape the full guest experience from one visual workspace. Start with a preset, refine typography and cards, then build responsive promotional heroes with movable layers and scheduled countdowns.</p>
                <div class="designer-proof-list">
                    <span><span class="material-symbols-outlined" aria-hidden="true">drag_pan</span>Direct layer positioning</span>
                    <span><span class="material-symbols-outlined" aria-hidden="true">devices</span>Independent phone layouts</span>
                    <span><span class="material-symbols-outlined" aria-hidden="true">timer</span>Scheduled offers</span>
                </div>
                <a class="btn btn-primary btn-icon" href="{{ path('app_menu_designer') }}">Explore the Menu Designer <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
            </div>
            <div class="designer-mini-studio" data-reveal aria-label="Menu Designer interface preview">
                <div class="mini-studio-bar"><span>Live preview</span><i></i><i></i><i></i></div>
                <div class="mini-studio-body">
                    <div class="mini-tools">
                        <span class="is-active material-symbols-outlined">auto_awesome</span>
                        <span class="material-symbols-outlined">wallpaper</span>
                        <span class="material-symbols-outlined">palette</span>
                        <span class="material-symbols-outlined">view_agenda</span>
                        <span class="material-symbols-outlined">campaign</span>
                    </div>
                    <div class="mini-menu-canvas">
                        <div class="mini-offer"><small>THIS WEEK ONLY</small><strong>Golden hour</strong><span>02 : 14 : 36</span></div>
                        <div class="mini-menu-title"><span>Seasonal selection</span><strong>Made for today</strong></div>
                        <div class="mini-card-row"><i></i><div><b>House signature</b><small>Fresh and locally prepared</small></div><strong>12.50</strong></div>
                        <div class="mini-card-row"><i></i><div><b>Chef's special</b><small>Limited availability</small></div><strong>16.00</strong></div>
                    </div>
                </div>
                <span class="mini-cursor material-symbols-outlined" aria-hidden="true">near_me</span>
            </div>
        </div>
    </section>

    <section class="s-features s-features--new">
        <div class="shell">
            <div class="section-split-head" data-reveal>
                <div>
                    <span class="eyebrow">Everything connected</span>
                    <h2>Tools for setup day and every day after.</h2>
                </div>
                <p>Build the menu once, then manage daily changes without replacing printed materials.</p>
            </div>
            <div class="feature-grid-new">
                {% for feature in features %}
                    <article class="feature-card-new" data-reveal>
                        <span class="feature-icon material-symbols-outlined" aria-hidden="true">{{ feature.icon }}</span>
                        <span class="feature-label">{{ feature.label }}</span>
                        <h3>{{ feature.title }}</h3>
                        <p>{{ feature.body }}</p>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="s-venues s-venues--new">
        <div class="shell">
            <div class="section-center" data-reveal>
                <span class="eyebrow">Made for real venues</span>
                <h2>One flexible structure for products, dishes, drinks, and services.</h2>
            </div>
            <div class="venues-grid venues-grid--icons">
                <article class="venue-card" data-reveal>
                    <span class="material-symbols-outlined venue-icon" aria-hidden="true">local_cafe</span>
                    <h3>Cafés and bakeries</h3>
                    <p>Sizes, extras, seasonal items, and instant sold-out updates.</p>
                </article>
                <article class="venue-card" data-reveal>
                    <span class="material-symbols-outlined venue-icon" aria-hidden="true">restaurant</span>
                    <h3>Restaurants and bars</h3>
                    <p>Rich categories, descriptions, photos, variants, and prices.</p>
                </article>
                <article class="venue-card" data-reveal>
                    <span class="material-symbols-outlined venue-icon" aria-hidden="true">spa</span>
                    <h3>Spas and salons</h3>
                    <p>Service durations, treatment details, pricing, and languages.</p>
                </article>
                <article class="venue-card" data-reveal>
                    <span class="material-symbols-outlined venue-icon" aria-hidden="true">storefront</span>
                    <h3>Studios and retail</h3>
                    <p>Any venue that presents a changing list of priced offerings.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="s-cta s-cta--new">
        <div class="shell cta-panel" data-reveal>
            <div>
                <span class="eyebrow">Your menu can be live today</span>
                <h2>Start with one permanent link. Let every update happen behind it.</h2>
            </div>
            <div class="cta-actions">
                <a class="btn btn-primary btn-icon" href="{{ path('app_register') }}">Create an account <span class="material-symbols-outlined">arrow_forward</span></a>
                <a class="cta-secondary-link" href="{{ path('app_pricing') }}">Compare plans</a>
            </div>
        </div>
    </section>
{% endblock %}
