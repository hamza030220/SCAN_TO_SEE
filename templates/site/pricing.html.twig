{% extends 'base.html.twig' %}

{% block title %}S2S Pricing — Scan to See{% endblock %}

{% block body %}

    <section class="s-subhero">
        <div class="shell">
            <span class="eyebrow">Pricing</span>
            <h1>Choose the plan that fits your operation.</h1>
            <p>Every plan is available with monthly or discounted yearly billing. Menu and business limits are shown clearly below.</p>
        </div>
    </section>

    <section class="s-pricing">
        <div class="shell">
            <div class="pricing-cards">
                {% for plan in plans %}
                    <div class="pricing-card {{ loop.last ? 'is-featured' : '' }}">
                        <div>
                            <p class="pricing-period">{{ plan.period }}</p>
                            <h2>{{ plan.name }}</h2>
                            <p>{{ plan.description }}</p>
                        </div>
                        <div class="price-tbd">
                            <strong>€{{ (plan.monthly / 100)|number_format(0) }} / month</strong>
                            <span>or €{{ (plan.yearly / 100)|number_format(0) }} per year</span>
                        </div>
                        <ul class="pricing-features">
                            {% for item in plan.items %}
                                <li>{{ item }}</li>
                            {% endfor %}
                        </ul>
                        <a class="btn {{ loop.last ? 'btn-primary' : 'btn-outline' }} btn-full" href="{{ path('app_register') }}">Choose {{ plan.name }}</a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="s-billing">
        <div class="shell billing-inner">
            <div>
                <h2>How billing works</h2>
                <p>S2S uses Stripe for secure recurring payments. Owners can change plan or billing period from the subscription page.</p>
                <p>If a subscription lapses, public access is paused while menu data and publication choices remain preserved. Reactivation restores visibility without rebuilding the menu.</p>
            </div>
            <div class="billing-rules">
                <div class="billing-rule">
                    <div class="billing-dot"></div>
                    <div>
                        <strong>Monthly</strong>
                        <p>Charged once per month. Change period at any time. Best for owners who want flexibility before committing long-term.</p>
                    </div>
                </div>
                <div class="billing-rule">
                    <div class="billing-dot"></div>
                    <div>
                        <strong>Yearly</strong>
                        <p>Charged once per year at a better effective monthly rate. Best for established venues with an ongoing need.</p>
                    </div>
                </div>
                <div class="billing-rule">
                    <div class="billing-dot"></div>
                    <div>
                        <strong>Expired subscriptions</strong>
                        <p>Menu data is never deleted on expiry. The public menu is paused until the subscription is renewed.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

{% endblock %}
