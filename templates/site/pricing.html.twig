{% extends 'base.html.twig' %}

{% block title %}S2S Pricing — Scan to See{% endblock %}
{% block meta_description %}Try Scan to See free for five days with one draft menu, one published menu, and three AI menu scans, then choose the plan that fits your venue.{% endblock %}

{% block body %}

    <section class="s-subhero">
        <div class="shell">
            <span class="eyebrow">Pricing</span>
            <h1>Choose the plan that fits your operation.</h1>
            <p>Start free for five days, explore the complete menu workflow, and choose a paid plan only when you are ready to continue.</p>
        </div>
    </section>

    <section class="s-pricing">
        <div class="shell">
            <article class="trial-offer" data-reveal>
                <div class="trial-offer-copy">
                    <span class="trial-offer-label">Free · No payment required</span>
                    <h2>Five days to build, scan, publish, and decide.</h2>
                    <p>Create a real menu and see how Scan to See fits your venue before choosing a subscription. Your trial starts after you verify your email.</p>
                </div>
                <ul class="trial-benefits" aria-label="Free trial benefits">
                    <li><span class="material-symbols-outlined" aria-hidden="true">edit_note</span><strong>1 draft menu</strong><small>Build and refine your content</small></li>
                    <li><span class="material-symbols-outlined" aria-hidden="true">public</span><strong>1 published menu</strong><small>Test the live guest experience</small></li>
                    <li><span class="material-symbols-outlined" aria-hidden="true">document_scanner</span><strong>3 AI scans</strong><small>Try assisted menu extraction</small></li>
                </ul>
                <div class="trial-offer-action">
                    <a class="btn btn-primary btn-icon" href="{{ path('app_register') }}">Start your free trial <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
                    <small>After five days, choose a plan to keep using the owner workspace and published menu.</small>
                </div>
            </article>

            <div class="pricing-cards">
                {% for plan in plans %}
                    {% set isFeatured = plan.featured|default(false) %}
                    <article class="pricing-card {{ isFeatured ? 'is-featured' : '' }}">
                        {% if isFeatured %}
                            <span class="pricing-badge">The best offer</span>
                        {% endif %}
                        <div>
                            <p class="pricing-period">{{ plan.period }}</p>
                            <h2>{{ plan.name }}</h2>
                            <p>{{ plan.description }}</p>
                        </div>
                        <div class="price-tbd">
                            <strong>€{{ (plan.monthly / 100)|number_format(0) }} / month</strong>
                            <span>or €{{ (plan.yearly / 100)|number_format(0) }} per year</span>
                        </div>
                        <ul class="pricing-features">
                            {% for item in plan.items %}
                                <li>{{ item }}</li>
                            {% endfor %}
                        </ul>
                        <a class="btn {{ isFeatured ? 'btn-primary' : 'btn-outline' }} btn-full" href="{{ path('app_register') }}">Choose {{ plan.name }}</a>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="s-billing">
        <div class="shell billing-inner">
            <div>
                <h2>How billing works</h2>
                <p>S2S uses Stripe for secure recurring payments. Owners can change plan or billing period from the subscription page.</p>
                <p>If a subscription lapses, public access is paused while menu data and publication choices remain preserved. Reactivation restores visibility without rebuilding the menu.</p>
            </div>
            <div class="billing-rules">
                <div class="billing-rule">
                    <div class="billing-dot"></div>
                    <div>
                        <strong>Monthly</strong>
                        <p>Charged once per month. Change period at any time. Best for owners who want flexibility before committing long-term.</p>
                    </div>
                </div>
                <div class="billing-rule">
                    <div class="billing-dot"></div>
                    <div>
                        <strong>Yearly</strong>
                        <p>Charged once per year at a better effective monthly rate. Best for established venues with an ongoing need.</p>
                    </div>
                </div>
                <div class="billing-rule">
                    <div class="billing-dot"></div>
                    <div>
                        <strong>Expired subscriptions</strong>
                        <p>Menu data is never deleted on expiry. The public menu is paused until the subscription is renewed.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

{% endblock %}
