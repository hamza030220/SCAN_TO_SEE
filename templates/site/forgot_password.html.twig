{% extends 'base.html.twig' %}

{% block title %}Forgot Password — S2S{% endblock %}

{% block body %}
    <section class="auth-page">
        <div class="auth-box">
            <div class="auth-left">
                <div class="auth-logo-row">
                    <img src="{{ asset('image/scantosee.png') }}" alt="S2S">
                    <span>Scan to See</span>
                </div>
                <h1>Forgot your password?</h1>
                <p>No worries — it happens to everyone. Enter your email address and we'll send you a secure reset link valid for 30 minutes.</p>
                <div class="auth-pills">
                    <span class="auth-pill">Secure link</span>
                    <span class="auth-pill">Expires in 30 min</span>
                    <span class="auth-pill">One-time use</span>
                </div>
            </div>
            <div class="auth-right">
                <h2>Reset your password</h2>
                <p>We'll email you a link to reset your password.</p>

                {% for message in app.flashes('success') %}
                    <div class="auth-alert auth-alert--ok">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="auth-alert auth-alert--err">{{ message }}</div>
                {% endfor %}

                <form class="auth-form" method="post" action="{{ path('app_forgot_password') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('forgot-password') }}">
                    <div class="form-field">
                        <label for="email">Email address</label>
                        <input id="email" name="email" type="email"
                               autocomplete="email"
                               placeholder="owner@example.com"
                               required>
                    </div>
                    <button class="btn btn-primary btn-full" type="submit">Send reset link</button>
                    <p class="form-switch">
                        Remembered it? <a href="{{ path('app_login') }}">Back to login</a>
                    </p>
                </form>
            </div>
        </div>
    </section>
{% endblock %}
