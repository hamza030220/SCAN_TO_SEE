{% extends 'admin/layout.html.twig' %}
{% block title %}Training Job #{{ job.id }} — S2S Admin{% endblock %}
{% block page_title %}Training job #{{ job.id }}{% endblock %}
{% block content %}
<style>
.job-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.job-head h1{font:700 1.55rem 'Space Grotesk',sans-serif}.job-head p{margin-top:5px;color:var(--adm-muted);font-size:.82rem}.job-actions{display:flex;gap:8px}.job-status-card{padding:26px;background:#fff;border:1px solid var(--adm-border);border-radius:12px}.status-line{display:flex;justify-content:space-between;gap:20px;align-items:center}.status-name{display:inline-flex;padding:5px 10px;border-radius:99px;background:#fff2db;color:#8a5700;font-size:.7rem;font-weight:800;text-transform:uppercase}.progress-track{height:12px;margin:22px 0 9px;overflow:hidden;border-radius:99px;background:#eee5db}.progress-fill{height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--adm-accent),#f08b55);transition:width .5s}.progress-meta{display:flex;justify-content:space-between;color:var(--adm-muted);font-size:.75rem}.job-info{margin-top:14px;padding:13px 15px;border-left:3px solid var(--adm-amber);background:#fff8e9;color:#73501e;font-size:.76rem;line-height:1.55}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:18px}.metric-card{padding:20px;background:#fff;border:1px solid var(--adm-border);border-radius:10px}.metric-card h2{font:700 .95rem 'Space Grotesk',sans-serif}.metric-row{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #f2eae0;font-size:.8rem}.metric-row span{color:var(--adm-muted)}.recommendation{margin-top:14px;padding:12px;border-radius:7px;background:#f5f1eb;font-size:.77rem;font-weight:700}.job-error{margin-top:18px;padding:15px;color:#9f1239;background:#fff1f2;border:1px solid #fecdd3;border-radius:8px;font-size:.8rem}.job-log{margin-top:18px;background:#17110d;border-radius:10px;overflow:hidden}.job-log header{display:flex;justify-content:space-between;padding:12px 15px;color:#fff;border-bottom:1px solid rgba(255,255,255,.08);font-size:.75rem;font-weight:700}.job-log pre{max-height:330px;overflow:auto;padding:16px;color:#d9cbb9;font:12px/1.55 Consolas,monospace;white-space:pre-wrap;word-break:break-word}.stop-help{max-width:470px;color:var(--adm-muted);font-size:.72rem;line-height:1.45}@media(max-width:720px){.job-head{align-items:start;flex-direction:column}.metric-grid{grid-template-columns:1fr}.status-line{align-items:start;flex-direction:column}.job-actions{width:100%;flex-wrap:wrap}}
</style>
<header class="job-head"><div><h1>Controlled model experiment</h1><p>Requested by {{ job.requestedBy.email }} on {{ job.createdAt|date('F j, Y') }} at {{ job.createdAt|date('H:i') }}.</p></div><div class="job-actions"><a class="btn btn-outline-adm" href="{{ path('app_admin_ai') }}">AI overview</a>{% if job.active and not job.stopRequested %}<form method="post" action="{{ path('app_admin_ai_training_stop',{id:job.id}) }}" onsubmit="return confirm('Request a safe stop? The current step will finish, then the candidate will be compared with production.');"><input type="hidden" name="_token" value="{{ csrf_token('training-stop-' ~ job.id) }}"><button class="btn btn-danger">Stop safely</button></form>{% endif %}</div></header>
<section class="job-status-card"><div class="status-line"><div><span class="status-name" id="jobStatus">{{ job.status }}</span><h2 id="jobPhase" style="margin-top:10px;font:700 1.15rem 'Space Grotesk',sans-serif">{{ job.phase }}</h2></div><p class="stop-help">Scanning stays unavailable only while this job is active. A stopped or completed candidate replaces production only when both CER and WER comparisons prove it is better.</p></div><div class="progress-track"><div class="progress-fill" id="jobProgress" style="width:{{ job.progress }}%"></div></div><div class="progress-meta"><span id="jobProgressText">{{ job.progress }}% complete</span><span id="jobMaintenance">{{ job.active ? 'AI maintenance active' : 'AI scanning available' }}</span></div><div class="job-info">CER measures character mistakes and WER measures complete-word mistakes. Lower is better. If the test split is missing, training fails safely before changing the model.</div></section>
<section class="metric-grid"><article class="metric-card"><h2>Production model</h2><div class="metric-row"><span>Character error rate</span><strong id="baseCer">{{ job.baselineMetrics and job.baselineMetrics.baseline_cer is defined ? (job.baselineMetrics.baseline_cer * 100)|number_format(2) ~ '%' : 'Waiting' }}</strong></div><div class="metric-row"><span>Word error rate</span><strong id="baseWer">{{ job.baselineMetrics and job.baselineMetrics.baseline_wer is defined ? (job.baselineMetrics.baseline_wer * 100)|number_format(2) ~ '%' : 'Waiting' }}</strong></div></article><article class="metric-card"><h2>Latest candidate checkpoint</h2><div class="metric-row"><span>Character error rate</span><strong id="candidateCer">{{ job.candidateMetrics and job.candidateMetrics.candidate_cer is defined ? (job.candidateMetrics.candidate_cer * 100)|number_format(2) ~ '%' : 'Waiting' }}</strong></div><div class="metric-row"><span>Word error rate</span><strong id="candidateWer">{{ job.candidateMetrics and job.candidateMetrics.candidate_wer is defined ? (job.candidateMetrics.candidate_wer * 100)|number_format(2) ~ '%' : 'Waiting' }}</strong></div><div class="recommendation" id="recommendation">{{ job.recommendation == 'promote' ? 'Candidate approved and promoted.' : (job.recommendation ? 'Production model retained.' : 'No decision until the same test set evaluates both models.') }}</div></article></section>
<div class="job-error" id="jobError" {% if not job.errorMessage %}hidden{% endif %}>{{ job.errorMessage }}</div>
<section class="job-log"><header><span>Technical activity</span><span>Useful when reporting a failed job</span></header><pre id="jobLog">{{ job.logExcerpt ?: 'The worker has not produced output yet.' }}</pre></section>
<script>
(function(){const url={{ path('app_admin_ai_training_status',{id:job.id})|json_encode|raw }};const metric=(data,key)=>data&&typeof data[key]==='number'?(data[key]*100).toFixed(2)+'%':'Waiting';async function update(){try{const response=await fetch(url,{headers:{Accept:'application/json'},cache:'no-store'});if(!response.ok)return;const data=await response.json();document.getElementById('jobStatus').textContent=data.status;document.getElementById('jobPhase').textContent=data.phase;document.getElementById('jobProgress').style.width=data.progress+'%';document.getElementById('jobProgressText').textContent=data.progress+'% complete';document.getElementById('jobMaintenance').textContent=data.active?'AI maintenance active':'AI scanning available';document.getElementById('baseCer').textContent=metric(data.baseline,'baseline_cer');document.getElementById('baseWer').textContent=metric(data.baseline,'baseline_wer');document.getElementById('candidateCer').textContent=metric(data.candidate,'candidate_cer');document.getElementById('candidateWer').textContent=metric(data.candidate,'candidate_wer');document.getElementById('recommendation').textContent=data.recommendation==='promote'?'Candidate performed better and was promoted.':data.recommendation?'Production model retained because the candidate was not better.':'No decision until both models use the same test set.';const error=document.getElementById('jobError');error.hidden=!data.error;error.textContent=data.error||'';if(data.log)document.getElementById('jobLog').textContent=data.log;if(data.active)setTimeout(update,3000);}catch(e){setTimeout(update,5000);}}setTimeout(update,1200);})();
</script>
{% endblock %}
