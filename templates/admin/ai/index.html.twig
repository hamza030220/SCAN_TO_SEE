{% extends 'admin/layout.html.twig' %}
{% block title %}AI Control Center — S2S Admin{% endblock %}
{% block page_title %}AI control center{% endblock %}
{% block content %}
<style>
.ai-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.ai-head h1{font:700 1.65rem 'Space Grotesk',sans-serif}.ai-head p{max-width:650px;margin-top:6px;color:var(--adm-muted);font-size:.86rem}.ai-actions{display:flex;gap:9px;flex-wrap:wrap}.ai-tabs{display:flex;gap:4px;margin-bottom:20px;padding:5px;background:#eee5db;border-radius:10px;width:max-content;max-width:100%;overflow:auto}.ai-tab{padding:8px 14px;border-radius:7px;color:var(--adm-muted);font-size:.78rem;font-weight:700;text-decoration:none;white-space:nowrap}.ai-tab.active{color:#fff;background:var(--adm-bg)}.ai-stat-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.ai-stat{padding:18px;background:#fff;border:1px solid var(--adm-border);border-radius:10px}.ai-stat span{display:block;color:var(--adm-muted);font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.ai-stat strong{display:block;margin-top:9px;font:700 1.55rem 'Space Grotesk',sans-serif}.ai-layout{display:grid;grid-template-columns:1.15fr .85fr;gap:18px;margin-top:18px}.ai-card{padding:22px;background:#fff;border:1px solid var(--adm-border);border-radius:11px}.ai-card h2{font:700 1rem 'Space Grotesk',sans-serif}.readiness{display:grid;gap:10px;margin-top:20px}.readiness-row{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #f1e9df;font-size:.8rem}.readiness-row:last-child{border:0}.readiness-row span{color:var(--adm-muted)}.status-pill{display:inline-flex;align-items:center;gap:7px;padding:5px 9px;border-radius:99px;background:#ecfdf5;color:#047857;font-size:.7rem;font-weight:800}.status-pill::before{content:'';width:7px;height:7px;border-radius:50%;background:#10b981}.empty-job{display:grid;place-items:center;text-align:center;min-height:210px;padding:25px;border:1px dashed #d8cabb;border-radius:9px;background:#fcfaf7}.empty-job svg{width:34px;color:#c19d6d}.empty-job strong{margin-top:12px}.empty-job p{max-width:360px;margin:6px auto 0;color:var(--adm-muted);font-size:.78rem}.help-note{margin-top:18px;padding:14px;border-left:3px solid var(--adm-amber);background:#fff8e9;color:#74521d;font-size:.76rem;line-height:1.55}.training-form{display:grid;gap:13px;margin-top:18px}.training-form label{display:grid;gap:5px;color:var(--adm-muted);font-size:.75rem;font-weight:700}.training-form select{padding:10px;border:1px solid var(--adm-border);border-radius:6px;background:#fff;font:inherit}.job-list{display:grid;gap:8px;margin-top:14px}.job-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px;border:1px solid var(--adm-border);border-radius:7px;color:var(--adm-ink);text-decoration:none;font-size:.76rem}.job-row small{color:var(--adm-muted)}@media(max-width:1050px){.ai-stat-grid{grid-template-columns:repeat(3,1fr)}.ai-layout{grid-template-columns:1fr}}@media(max-width:620px){.ai-head{align-items:start;flex-direction:column}.ai-stat-grid{grid-template-columns:1fr 1fr}.ai-actions .btn{width:100%;text-align:center}}
</style>
<header class="ai-head"><div><h1>Understand and improve the scanner</h1><p>Review owner-approved data, verify Cloudinary assets, and manage controlled model experiments without a terminal.</p></div><div class="ai-actions"><a class="btn btn-outline-adm" href="{{ cloudinaryUrl }}" target="_blank" rel="noopener">Open Cloudinary ↗</a><a class="btn btn-danger" href="{{ path('app_admin_ai_dataset') }}">Review dataset</a></div></header>
<nav class="ai-tabs"><a class="ai-tab active" href="{{ path('app_admin_ai') }}">Overview</a><a class="ai-tab" href="{{ path('app_admin_ai_dataset') }}">Dataset review</a>{% if activeJob %}<a class="ai-tab" href="{{ path('app_admin_ai_training_job',{id:activeJob.id}) }}">Active training</a>{% endif %}</nav>
<section class="ai-stat-grid">{% for label,value in {'Eligible samples':statistics.eligible,'Accepted':statistics.accepted,'Corrected':statistics.modified,'Excluded':statistics.excluded,'Mean confidence':statistics.averageConfidence ~ '%'} %}<article class="ai-stat"><span>{{ label }}</span><strong>{{ value }}</strong></article>{% endfor %}</section>
<section class="ai-layout">
<article class="ai-card"><div style="display:flex;justify-content:space-between;gap:12px"><div><h2>Dataset readiness</h2><p style="color:var(--adm-muted);font-size:.78rem">Only reviewed, labeled, non-excluded Cloudinary crops are exported.</p></div><span class="status-pill">Collection active</span></div><div class="readiness"><div class="readiness-row"><span>Human-reviewed regions</span><strong>{{ statistics.accepted + statistics.modified }}</strong></div><div class="readiness-row"><span>Owner corrections</span><strong>{{ statistics.modified }}</strong></div><div class="readiness-row"><span>Deleted or garbage detections</span><strong>{{ statistics.deleted }}</strong></div><div class="readiness-row"><span>Manually excluded by admin</span><strong>{{ statistics.excluded }}</strong></div></div><div class="help-note"><strong>Why review first?</strong> Incorrect labels teach incorrect text. Excluding uncertain samples is safer than adding more low-quality data.</div></article>
<article class="ai-card"><h2>Training activity</h2>
{% if activeJob %}<div class="readiness"><div class="readiness-row"><span>Status</span><strong>{{ activeJob.status|capitalize }}</strong></div><div class="readiness-row"><span>Current step</span><strong>{{ activeJob.phase }}</strong></div><div class="readiness-row"><span>Progress</span><strong>{{ activeJob.progress }}%</strong></div></div><a class="btn btn-danger" style="margin-top:15px" href="{{ path('app_admin_ai_training_job',{id:activeJob.id}) }}">Open live job</a>
{% else %}<div class="empty-job"><div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 3h6l1 4 4 2v6l-4 2-1 4H9l-1-4-4-2V9l4-2 1-4z"/><circle cx="12" cy="12" r="3"/></svg><strong style="display:block">Start a controlled experiment</strong><p>The scanner enters maintenance mode. Cloudinary assets and CSV splits are validated before the GPU starts.</p><form class="training-form" method="post" action="{{ path('app_admin_ai_training_start') }}" onsubmit="return confirm('Start this controlled experiment? Owner AI scanning will pause until validation and model comparison finish.');"><input type="hidden" name="_token" value="{{ csrf_token('training-start') }}"><label>Maximum training passes<select name="epochs"><option value="1">1 epoch — fastest proof of concept</option><option value="2">2 epochs — balanced test</option><option value="3">3 epochs — longer comparison</option></select></label><button class="btn btn-danger">Validate data and start</button></form></div></div>{% endif %}
{% if recentJobs %}<div class="job-list">{% for previous in recentJobs %}<a class="job-row" href="{{ path('app_admin_ai_training_job',{id:previous.id}) }}"><span>Job #{{ previous.id }} · {{ previous.status|capitalize }}</span><small>{{ previous.createdAt|date('M d, H:i') }}</small></a>{% endfor %}</div>{% endif %}
</article></section>
{% endblock %}
