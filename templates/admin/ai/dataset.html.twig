{% extends 'admin/layout.html.twig' %}
{% block title %}Dataset Review — S2S Admin{% endblock %}
{% block page_title %}AI dataset review{% endblock %}
{% block content %}
<style>
.ds-head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:20px}.ds-head h1{font:700 1.55rem 'Space Grotesk',sans-serif}.ds-head p{max-width:650px;margin-top:6px;color:var(--adm-muted);font-size:.84rem}.ds-actions{display:flex;gap:8px}.dataset-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}.dataset-summary div{padding:15px 17px;background:#fff;border:1px solid var(--adm-border);border-radius:9px}.dataset-summary span{display:block;color:var(--adm-muted);font-size:.67rem;font-weight:800;text-transform:uppercase}.dataset-summary strong{display:block;margin-top:7px;font:700 1.35rem 'Space Grotesk',sans-serif}.sample-cell{display:flex;align-items:center;gap:11px;min-width:220px}.sample-cell img{width:80px;height:48px;object-fit:contain;background:#f4eee6;border:1px solid var(--adm-border);border-radius:5px}.sample-text{display:grid;gap:3px}.sample-text del{color:#a13b3b;font-size:.72rem}.sample-text strong{max-width:260px;overflow-wrap:anywhere}.confidence{font-weight:800}.confidence.low{color:#b91c1c}.dataset-form{display:grid;gap:7px;min-width:210px}.dataset-form input[type=text]{width:100%;padding:7px 9px;border:1px solid var(--adm-border);border-radius:5px;font:inherit;font-size:.75rem}.dataset-form-row{display:flex;gap:5px}.mini-btn{padding:6px 8px;border:1px solid var(--adm-border);border-radius:5px;background:#fff;color:var(--adm-ink);font-size:.68rem;font-weight:800;cursor:pointer}.mini-btn:hover{background:#f7f2ec}.mini-btn.danger{color:#9f1239;border-color:#fecdd3}.excluded-row td{opacity:.65;background:#fff8ed}.export-panel{margin-top:20px}.export-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:16px 20px}.export-card{padding:13px;border:1px solid var(--adm-border);border-radius:7px}.export-card strong{display:block}.export-card span{display:block;margin:5px 0;color:var(--adm-muted);font-size:.72rem}.pagination{display:flex;justify-content:center;align-items:center;gap:12px;margin-top:18px;font-size:.78rem}@media(max-width:800px){.ds-head{align-items:start;flex-direction:column}.dataset-summary{grid-template-columns:1fr 1fr}.export-grid{grid-template-columns:1fr}}
</style>
<header class="ds-head"><div><h1>Review what the model will learn</h1><p>Compare the original OCR text with the owner-approved label. Correct a label, or exclude suspicious and repeated test data without deleting its audit record.</p></div><div class="ds-actions"><a class="btn btn-outline-adm" href="{{ path('app_admin_ai') }}">AI overview</a><form method="post" action="{{ path('app_admin_ai_dataset_export') }}"><input type="hidden" name="_token" value="{{ csrf_token('dataset-export') }}"><button class="btn btn-danger">Validate and export</button></form></div></header>
<section class="dataset-summary">{% for label,value in {'All regions':statistics.total,'Eligible':statistics.eligible,'Corrected':statistics.modified,'Excluded':statistics.excluded} %}<div><span>{{ label }}</span><strong>{{ value }}</strong></div>{% endfor %}</section>
<section class="admin-panel"><div class="admin-panel-head"><h2>Collected OCR regions</h2><span style="color:var(--adm-muted);font-size:.72rem">Page {{ page }} of {{ pageCount }}</span></div><div class="admin-table-scroll"><table class="admin-table"><thead><tr><th>Cloud image and label</th><th>Type</th><th>Confidence</th><th>Outcome</th><th>Review action</th></tr></thead><tbody>
{% for region in regions %}<tr class="{{ region.excludedFromTraining ? 'excluded-row' : '' }}"><td><div class="sample-cell">{% if region.cropUrl %}<a href="{{ region.cropUrl }}" target="_blank" rel="noopener"><img src="{{ region.cropUrl }}" alt="OCR crop" loading="lazy"></a>{% endif %}<div class="sample-text"><del>{{ region.rawText ?: 'No OCR text' }}</del><strong>{{ region.correctedText ?: 'No approved label' }}</strong><small>{{ region.scan.modelVersion }}</small></div></div></td><td>{{ region.role }}</td><td><span class="confidence {{ region.confidence < 0.65 ? 'low' : '' }}">{{ (region.confidence * 100)|number_format(1) }}%</span></td><td>{% if region.excludedFromTraining %}<span class="badge-inactive">Excluded</span><small style="display:block;margin-top:5px">{{ region.exclusionReason }}</small>{% else %}<span class="badge-active">{{ region.reviewOutcome|default('pending')|capitalize }}</span>{% endif %}</td><td><form class="dataset-form" method="post" action="{{ path('app_admin_ai_dataset_review',{id:region.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('dataset-region-' ~ region.id) }}"><input type="text" name="corrected_text" value="{{ region.correctedText }}" aria-label="Corrected training label"><input type="text" name="reason" placeholder="Reason required to exclude" aria-label="Exclusion reason"><div class="dataset-form-row"><button class="mini-btn" name="action" value="correct">Save label</button>{% if region.excludedFromTraining %}<button class="mini-btn" name="action" value="restore">Restore</button>{% else %}<button class="mini-btn danger" name="action" value="exclude">Exclude</button>{% endif %}</div></form></td></tr>{% else %}<tr><td colspan="5"><div class="admin-empty">No scanner data has been collected yet.</div></td></tr>{% endfor %}
</tbody></table></div></section>
<nav class="pagination">{% if page>1 %}<a class="btn btn-outline-adm btn-sm" href="{{ path('app_admin_ai_dataset',{page:page-1}) }}">Previous</a>{% endif %}<span>{{ page }} / {{ pageCount }}</span>{% if page<pageCount %}<a class="btn btn-outline-adm btn-sm" href="{{ path('app_admin_ai_dataset',{page:page+1}) }}">Next</a>{% endif %}</nav>
<section class="admin-panel export-panel"><div class="admin-panel-head"><div><h2>Saved local datasets</h2><small style="color:var(--adm-muted)">Images remain in Cloudinary; each verified export downloads a reproducible local copy and CSV.</small></div></div>{% if exports %}<div class="export-grid">{% for export in exports %}<article class="export-card"><strong>{{ export.name }}</strong><span>{{ export.written }} rows · {{ export.failed }} skipped · {{ export.createdAt|date('M d, H:i') }}</span><small>Train {{ export.train }} · Validation {{ export.val }} · Test {{ export.test }}</small><a class="admin-action" href="{{ path('app_admin_ai_dataset_manifest',{name:export.name}) }}">Download CSV</a></article>{% endfor %}</div>{% else %}<div class="admin-empty">No local dataset export yet. Use “Validate and export” to test Cloudinary downloads and CSV generation.</div>{% endif %}</section>
{% endblock %}
